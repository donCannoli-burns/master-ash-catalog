__core_text_test_data.listAppend(listMake("wham.php?ask=7&visit=9", "\"Do you know someone named Allison Allen?\" you ask.<p>\"Oh sure, Gabrielle's chauffeur, I know her pretty well,\" he says. \"He's a real straight-shooter. Real trustworthy.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=7&visit=9", "\"Have you met the victim's chauffeur?\" you ask.<p>\"Yeah, I know Gabrielle's chauffeur,\" Davey says. \"Not real well, but we've chatted. Charming, real charming type. Probably in the Dining Room, if I hadda guess.\""));
