__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Jim Davenport. What can you tell me about him?\" you ask.<p>\"Yeah, I know Jim Davenport. He's Davey's college roommate. Or was, I guess. He's okay. I never had any trouble with him.\""));
