__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=7&visit=9", "\"I understand the victim had a business partner,\" you say. \"Can you tell me anything about them?\"<p>\"Business partner... Business partner...\" Martin mutters. \"...Oh! You mean Nevaeh Greer! Heck, we're such good pals I practically forgot she's Woody's business partner!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=7&visit=9", "\"Do you know Gross's business partner?\" you ask.<p>\"Business partner... Business partner...\" Martin mutters. \"...Oh! You mean Nevaeh Greer! Heck, we're such good pals I practically forgot she's Woody's business partner!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=7&visit=9", "\"Are you familiar with a woman named Anna Byrd?\" you ask.<p>\"Oh sure, Woody's lawyer, I know her pretty well,\" he says. \"He's a real straight-shooter. Real trustworthy.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=9", "\"What do you know about Taylor Jackson?\" you ask.<p>\"Who? Oh, right. I know who ya mean,\" he replies. \"We don't pal around -- she's not really my cup of tea. She's in the Living Room, though, if you wanna meet her yourself.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=9", "\"Can you tell me anything about the victim's college roommate? you ask.<p>\"Sheesh,\" Martin grumbles. \"Yeah, I know Nevaeh Greer. Know her like a kick in the teeth. Got about as much need for her, too.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=9", "\"Do you know someone named Taylor Jackson?\" you ask.<p>\"Who? Oh, right. I know who ya mean,\" he replies. \"We don't pal around -- she's not really my cup of tea. She's in the Living Room, though, if you wanna meet her yourself.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=9", "\"Do you know Gross's college roommate?\" you ask.<p>\"Ah. Yeah. I know who you mean,\" he replies. \"Her name's Nevaeh Greer. I don't recommend you waste your time with her though, Detective. That ain't gonna be a, whaddyacallit -- a profitable endeavor.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=9", "\"Do you know someone by the name of Taylor Jackson?\" you ask.<p>\"Yeah, I know her,\" Martin says. \"Don't care much for her, though. She's up to something shifty, if you ask me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=9", "\"Have you met the victim's college roommate?\" you ask.<p>\"Ah. Yeah. I know who you mean,\" he replies. \"Her name's Nevaeh Greer. I don't recommend you waste your time with her though, Detective. That ain't gonna be a, whaddyacallit -- a profitable endeavor.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=9", "\"Taylor Jackson. What can you tell me about her?\" you ask.<p>\"Yeah, I know her,\" Martin says. \"Don't care much for her, though. She's up to something shifty, if you ask me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=9", "\"Do you know Gross's college roommate?\" you ask.<p>\"Woody's college roommate... Oh. You mean Nevaeh Greer,\" Martin says, shaking his head. \"Yeah, no. I don't need the stress, know what I mean?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=9", "\"Are you familiar with someone named Taylor Jackson?\" you ask.<p>\"Ugh, yeah, I know Taylor Jackson,\" Martin says. \"She's in the Living Room. If she says anything about me, though, it's a total lie.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=9", "\"What can you tell me about the deceased's college roommate?\" you ask.<p>\"Ah. Yeah. I know who you mean,\" he replies. \"Her name's Nevaeh Greer. I don't recommend you waste your time with her though, Detective. That ain't gonna be a, whaddyacallit -- a profitable endeavor.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=9", "\"What can you tell me about Taylor Jackson?\" you ask.<p>\"Ugh, yeah, I know Taylor Jackson,\" Martin says. \"She's in the Living Room. If she says anything about me, though, it's a total lie.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=9", "\"What can you tell me about the deceased's college roommate?\" you ask.<p>\"Woody's college roommate... Oh. You mean Nevaeh Greer,\" Martin says, shaking his head. \"Yeah, no. I don't need the stress, know what I mean?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=9", "\"Are you familiar with a woman named Taylor Jackson?\" you ask.<p>\"Who? Oh, right. I know who ya mean,\" he replies. \"We don't pal around -- she's not really my cup of tea. She's in the Living Room, though, if you wanna meet her yourself.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=9", "\"Can you tell me anything about Woody Gross's college roommate?\" you ask.<p>\"Woody's college roommate... Oh. You mean Nevaeh Greer,\" Martin says, shaking his head. \"Yeah, no. I don't need the stress, know what I mean?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=9", "\"The victim had a college roommate, do you know them?\" you ask.<p>\"Ah. Yeah. I know who you mean,\" he replies. \"Her name's Nevaeh Greer. I don't recommend you waste your time with her though, Detective. That ain't gonna be a, whaddyacallit -- a profitable endeavor.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Well now!\" Martin says, glancing around the room and over his shoulder. \"Ain't every day a police detective asks my opinion on a thing like that! Sorry though, I just don't know what to tell ya. <i>*cough*Nevaeh Greer*cough*</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"All right, well, I'm trusting you to keep my name out of this, Detective,\" Martin says. \"My life wouldn't be worth a plugged nickel if the wrong people found out I told you this. But it was Nevaeh Greer. I can't risk tellin' ya any more than that.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Well now!\" Martin says, glancing around the room and over his shoulder. \"Ain't every day a police detective asks my opinion on a thing like that! Sorry though, I just don't know what to tell ya. <i>*cough*Nevaeh Greer*cough*</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"All right, well, I'm trusting you to keep my name out of this, Detective,\" Martin says. \"My life wouldn't be worth a plugged nickel if the wrong people found out I told you this. But it was Nevaeh Greer. I can't risk tellin' ya any more than that.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"All right, Detective, all right,\" Martin grins. \"Ya dragged it out of me. The killer was Nevaeh Greer. And I trust you'll remember how helpful I was to you, if we should ever cross paths again!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Who do you think the killer is?\" you ask.<p>\"Well now!\" Martin says, glancing around the room and over his shoulder. \"Ain't every day a police detective asks my opinion on a thing like that! Sorry though, I just don't know what to tell ya. <i>*cough*Nevaeh Greer*cough*</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Who do you think the killer is?\" you ask.<p>\"All right, well, I'm trusting you to keep my name out of this, Detective,\" Martin says. \"My life wouldn't be worth a plugged nickel if the wrong people found out I told you this. But it was Nevaeh Greer. I can't risk tellin' ya any more than that.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"All right, well, I'm trusting you to keep my name out of this, Detective,\" Martin says. \"My life wouldn't be worth a plugged nickel if the wrong people found out I told you this. But it was Nevaeh Greer. I can't risk tellin' ya any more than that.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Attic and meet a man dressed for an extremely expensive white-tie affair. He looks down his nose regally at you. Your dossier identifies him as Mickey David, the victim's physician.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" he says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Detective,\" David says with a glare, \"if you cannot be bothered to do your own job, I most certainly am not going to do it for you.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Laundry Room, you discover a young man, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. According to the dossier, this is Willie Sexton, the victim's child.<p>He looks up at you, and his eyes widen with surprise. \"Ooh! You must be the police detective assigned to the case!\"<p>\"That's me,\" you say, showing your badge.<p>\"Great! I'm gonna be a real big help, you'll see!\"<p>\"As long as you stay in here while doing it,\" you say. \"Sorry, but I can't have you running around during the investigation.\"<p>\"Aw, that's okay,\" he says. \"I'll just sneak out while you aren't watching, dodge the guards, and come back before you've realized I'm gone!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Gosh, Detective!\" Willie exclaims. \"I sure wish I knew! I've been looking all over for clues, but the bad guy really covered their tracks on this one!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "As you enter the Foyer, a small nervous-looking man spins around with a startled look. Judging from the dossier the Officers Chaps gave you, this must be Craig Yang, the victim's college roommate.<p>\"Help!\" he yells. \"They've come for me! It's the murderer!\"<p>\"Settle down,\" you say. \"I'm a detective with the police. I'm investigating the case.\"<p>\"Well, so you <i>say</i>,\" he says, glaring at you with suspicion."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Do you have any thoughts on who did it?\" you ask.<p>\"If I tell you who did it, they'll kill me for sure!\"Craig says. <p>\"You think they'll do that anyway, though,\" you say. \"If you tell me who it is, I can at least help avenge you.\"<p>\"Good point. Okay, it was Alexa's personal assistant.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Do you know Lara's physician?\" you ask.<p>\"Oh, you mean Mickey David?\" Craig says. \"I'm not one hundred percent on him, but I think he might be okay. I'm keeping my eyes on him.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Lounge, where a bored and angry-looking young man in motorcycle boots and a leather jacket is stomping around and ashing his cigarette on the expensive-looking Turkish carpet. \"You must be Doc Davidson, the victim's lover,\" you say, flipping to the relevant page in the dossier.<p>\"God, finally,\" he growls. \"Hurry up and ask me some effin' questions so I can get out of this place!\"<p>\"You in a hurry or something?\" you ask, tapping your pencil on your notepad.<p>\"Look, cop, I got a life. I got stuff to be doing other than standing around this craphole.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"Look, cop -- I don't know who did it, and if I did, I still wouldn't tell you! Get out of my face, already!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "As you enter the Dining Room, a wild-eyed man accosts you, pointing with an outstretched and trembling finger. A quick flip through your suspect dossier reveals this to be Dennis Hull, the victim's golf caddy.<p>\"Help!\" he yells. \"They've come for me! It's the murderer!\"<p>\"Settle down,\" you say. \"I'm a detective with the police. I'm investigating the case.\"<p>\"Well, so you <i>say</i>,\" he says, glaring at you with suspicion."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Who did it?\" Dennis asks incredulously. \"Don't you get it? Don't you <i>see?</i> They <i>all</i> did it! They're all in on it together!\"<p>\"In my experience, that's pretty unlikely,\" you say."));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Master Bedroom, you meet a young woman, maybe 13 or 14 years old, who is methodically tilting every book in a bookcase, as though trying to find the trigger for a secret door. Judging from the dossier the Officers Chaps gave you, this must be Brooke Gordon, the victim's lawyer.<p>She looks up at you, and her eyes widen with surprise. \"Ooh! You must be the police detective assigned to the case!\"<p>\"That's me,\" you say, showing your badge.<p>\"Great! I'm gonna be a real big help, you'll see!\"<p>\"As long as you stay in here while doing it,\" you say. \"Sorry, but I can't have you running around during the investigation.\"<p>\"Aw, that's okay,\" she says. \"I'll just sneak out while you aren't watching, dodge the guards, and come back before you've realized I'm gone!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"It's just gotta be Lauren McLaughlin, Detective,\" Brooke says excitedly. \"Means, motive, and opportunity -- just like the Junior Detective's Handbook says!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know someone by the name of Doc Davidson?\" you ask.<p>\"Shucks, Detective!\" Brooke says, \"I know a bunch of stuff about him! He's the victim's lover, and he has a lot of gambling debts to some very dangerous people!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Game Room and meet a man dressed in cheap knockoff versions of the latest rich peoples' fashions. \"You must be Steven Walker, the victim's cousin,\" you say, flipping to the relevant page in the dossier.<p>\"Good, good,\" he says. \"I'm glad you're here, Officer.\"<p>\"Detective.\"<p>\"Right! Right, of course, Detective, sorry. What a terrible thing that happened, just awful. But I'm sure you'll get to the bottom of it right away, yeah?\"<p>\"Hopefully, yes,\" you say. \"I'd like to ask you a few questions.\"<p>\"Sure, sure! Ask away, Detective, I've got nothin' to hide!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Well now,\" Steven says, \"I wouldn't wanna be tellin' tales outta school, Detective. I haven't got any evidence for this, y'unnerstand. But if ya ask me -- which you did -- I'd say it was Doc's accountant.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=3&visit=1", "\"Can you tell me anything about Doc Mejia's accountant?\" you ask.<p>\"Nah, I got no use for them,\" Steven says. \"Nothin' but trouble. Probably hangin' around the Laundry Room, if you've got time to waste.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "When you enter the Laundry Room, you find a young woman dressed in crisp tennis whites, idly bouncing a tennis ball on a racket and whistling a jaunty little tune. Your dossier identifies her as Brooke Contreras, the victim's business partner.<p>She looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking her proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"It's interesting you should ask me that, Detective, because I was just asking myself the very same,\" Brooke says. \"The identical, as it were.\"<p>\"...And?\"<p>\"Hmm?\"<p>\"Who killed Doc Mejia?\"<p>\"Oh! It was the golf caddy, of course. Terribly sorry, I thought you already knew.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"The victim's cousin -- do you know them?\" you ask.<p>\"That's Johnny Jackson, isn't it?\" Brooke asks. \"Don't know him well, Detective, but he seems quite respectable. Stable sort, plenty of atoms up in the old thinkpiece.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Foyer, and encounter a young man -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. According to the notes the Officers Chaps gave you, this is Willie Gilmore, the victim's accountant.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" he says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and his eyes widen when you show him your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" he pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Sorry, Detective,\" Willie says sadly. \"I haven't figured it out yet. This is bunches harder than when I solved the Mystery of Pirate Island!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "As you enter the Servants' Quarters, you are greeted by an aristocratic-looking woman dressed for a white-tie occasion. She looks you up and down, and doesn't appear to think much of what she sees. Judging from the dossier the Officers Chaps gave you, this must be Lauren Lowery, the victim's ex-physician.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" she says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Detective,\" Lowery says with a glare, \"if you cannot be bothered to do your own job, I most certainly am not going to do it for you.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "A dark-haired young man is sitting in the Basement, quietly reading a large hardcover book. He doesn't seem to be aware of your presence. According to the notes the Officers Chaps gave you, this is Stanley Ellison, the victim's physician.<p>\"What are you reading?\" you ask, to break the silence. He silently gestures at the cover, which is jacketless and doesn't have the title printed on it. \"So... a book.\"<p>\"Mm-hmm,\" he replies."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think the killer is?\" you ask.<p>\"No idea,\" he says, turning a page in his book."));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You walk into the Dining Room, which appears to be empty -- until a nervous face appears from behind the sofa. Your dossier identifies him as Johnny Jackson, the victim's bodyguard.<p>\"Who are you?!\" he exclaims. \"Don't come any closer or I'll call the cops!\"<p>\"I <i>am</i> the cops,\" you say, showing him your badge.<p>\"Oh thank god! Thank god you're here! I'm going to be next, I just know it, you have to protect me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Who did it?\" Johnny asks incredulously. \"Don't you get it? Don't you <i>see?</i> They <i>all</i> did it! They're all in on it together!\"<p>\"In my experience, that's pretty unlikely,\" you say."));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "You enter the Smoking Lounge, and discover an extremely muscular woman lifting weights and glistening with sweat. Judging from the dossier the Officers Chaps gave you, this must be Samantha Cannon, the victim's golf caddy.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Samantha grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Who killed Doc?\" Samantha says. \"That's easy, it was his cousin.\" <p>\"How do you know?\" you ask. <p>Samantha flexes her muscles at you in several bodybuilder poses. You aren't sure how that relates to the question."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=7", "\"Are you familiar with a man named Steven Walker?\" you ask.<p>\"He's Doc's cousin,\" Samantha says. \"We don't have much in common, but we get along pretty well. He's got a real good sense of humor, you know? Funny.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Ballroom and meet a man dressed in cheap knockoff versions of the latest rich peoples' fashions. Your dossier identifies him as Diego Cooke, the victim's bodyguard.<p>\"Boy, am I glad to see you!\" he says. \"I just can't believe someone would do this to dear old Davey. Listen, if there's anything I can do to help, anything at all, you just let me know.\"<p>\"Well,\" you say, \"I would like to ask you some questions.\"<p>\"Questions? Oh, er, right! Yeah, sure, ask away! Always happy to cooperate with the police, that's me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"Well gee, Detective,\" Diego says, \"I hate to disappoint ya, but I haven't got a clue who could've done it. Far as I know, everyone in this house loved Davey like a brother. Or a sister, or whatever.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Family Room, you find a young woman in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick her foot to wake her up. \"Uh?\" she says. \"Wha? Oh.\" She stands up, knuckling sleepy, bloodshot eyes. \"You must be Sophie Little, the victim's cousin,\" you say, flipping to the relevant page in the dossier.<p>\"Uh, hey,\" she says. \"Hi. Yeah. I'm Sophie. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "In the Master Bedroom you find a pale, drably-dressed man slouched on a small chair. He looks up at you as you enter, and sighs pathetically. A quick flip through your suspect dossier reveals this to be Timmy Moore, the victim's lover.<p>\"Great, here we go,\" he says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Yeah, it's not enough that I have to do everything else around here, I might as well solve the murder for the detective too,\" Timmy grumbles. \"It was Parker Curtis. There. Happy?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"What do you know about Diego Cooke?\" you ask.<p>\"I know Diego Cooke, yeah,\" he says. \"He's Davey's housekeeper. I get less verbal abuse from him than from the others. Which is nice of him.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "You enter the Study, and encounter a young man -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. A quick flip through your suspect dossier reveals this to be Gustav Rivers, the victim's physician.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" he says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and his eyes widen when you show him your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" he pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Jeez, Detective!\" Gustav pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Sunroom, and discover an extremely muscular woman lifting weights and glistening with sweat. According to the dossier, this is Destiny Roy, the victim's neighbor.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" she replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Beats me,\" she mutters. \"If they try and pull that murder stuff on me, though, I'll tie 'em in a knot like a fireplace poker!\"<p>\"...You can do that?\" you ask.<p>\"Yeah! Wanna see?\"<p>\"Yeah, kind of. But later.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Lounge, where a bored and angry-looking young man in motorcycle boots and a leather jacket is stomping around and ashing his cigarette on the expensive-looking Turkish carpet. A quick flip through your suspect dossier reveals this to be Parker Curtis, the victim's gardener.<p>\"I need to ask you some questions about the murder,\" you say.<p>\"I didn't kill anybody, but if I have to hang around this dump any longer, I might,\" he snarls. \"Hurry up and ask me whatever you're gonna ask, so I can get out of here!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Yeah, well... normally I wouldn't talk to a cop,\" he says, \"but I am sick to death of sitting around here. So I'll tell you: it was Gustav Rivers. Can I friggin' go now?\"<p>\"I'll let you know,\" you say.<p><i>\"Frig!\"</i> Parker says, throwing his hands in the air exasperatedly. \"I'm gonna be stuck here all frickin' <i>night!</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=6", "\"Do you know someone named Diego Cooke?\" you ask.<p>\"Diego Cooke? Davey's bodyguard? He's cool, he's a good person. Don't you be hasslin' him!\" he snarls, jabbing a forefinger at you."));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Pantry, you meet a young woman, maybe 13 or 14 years old, who is methodically tilting every book in a bookcase, as though trying to find the trigger for a secret door. According to the dossier, this is Anna Bowman, the victim's college roommate.<p>She looks up at you, and her eyes widen with surprise. \"Ooh! You must be the police detective assigned to the case!\"<p>\"That's me,\" you say, showing your badge.<p>\"Great! I'm gonna be a real big help, you'll see!\"<p>\"As long as you stay in here while doing it,\" you say. \"Sorry, but I can't have you running around during the investigation.\"<p>\"Aw, that's okay,\" she says. \"I'll just sneak out while you aren't watching, dodge the guards, and come back before you've realized I'm gone!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"Sorry, Detective,\" Anna says sadly. \"I haven't figured it out yet. This is bunches harder than when I solved the Mystery of Pirate Island!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Foyer you find a young man deep in thought, staring at the ceiling while tapping his pencil on the page of a leather-bound notebook. Your dossier identifies him as Zane Fleming, the victim's child.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" he says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"I think it was probably either a raven, or a metaphor for the tyranny of social expectations,\" Zane says. <p>\"Well thanks,\" you say dryly. \"I'll be sure to put an APB out on both of those things.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Wine Cellar, where a dark-haired young woman in glasses is sitting, deeply focused on a large hardback book; she doesn't look up as you come in. Judging from the dossier the Officers Chaps gave you, this must be Payton Bailey, the victim's cousin.<p>\"Excuse me,\" you say, \"I'm from the police, and I need to ask you some questions. ...Can you put the book down for a minute?\" She slowly drags her eyes away from the page and regard you impassively. \"Well, it's a start,\" you sigh."));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "You enter the Bathroom and encounter a man dressed in very expensive-looking formal attire. He regards you with a look of distaste and disdain. Judging from the dossier the Officers Chaps gave you, this must be Perry Petty, the victim's physician.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask you a few questions.\" <p>\"I am already late for the French Ambassador's gala,\" he  says coldly. \"I trust this will not take long?\" <p>\"Depends on how quickly you answer.\"<p>He glares at you for a second, then rolls his eyes. \"Oh, very well. Ask.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Detective,\" Petty says with a glare, \"if you cannot be bothered to do your own job, I most certainly am not going to do it for you.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "As you enter the Basement, a wild-eyed man accosts you, pointing with an outstretched and trembling finger. Judging from the dossier the Officers Chaps gave you, this must be Perry Cole, the victim's chauffeur.<p>\"Who are you?!\" he demands. \"Police,\" you reply. \"I need to ask you a few questions about--\"<p>\"And how do I know you're telling the truth? I should just take your word for it? You could be anybody!\"<p>With a sigh, you pull out your badge and show it to him. \"Happy?\"<p>\"And I'm supposed to just trust that that's real? Well... all right. For now. But I've got my eye on you!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Who did it?\" Perry asks incredulously. \"Don't you get it? Don't you <i>see?</i> They <i>all</i> did it! They're all in on it together!\"<p>\"In my experience, that's pretty unlikely,\" you say."));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Billiard Room, and find a woman dressed in a shapeless gray suit, slouched on a chair and staring at her feet. Judging from the dossier the Officers Chaps gave you, this must be Zoey Forbes, the victim's sibling.<p>\"Great, here we go,\" she says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"It was Lily's physician,\" Zoey says. \"Does it make you happy to know that? If it does, please let me know, because having never experienced that emotion myself, it's difficult for me to detect it in others.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=6", "\"What do you know about Anna Bowman?\" you ask.<p>\"She's in the Pantry,\" Zoey says. \"I like her -- she doesn't immediately blame me when things go wrong around here. As they inevitably do. And as everyone else inevitably does.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "The only person in the Hall Closet is a hugely-muscled woman, currently working out with a set of oversized freeweights. According to the notes the Officers Chaps gave you, this is Sydney Petersen, the victim's sibling.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Sydney grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>Sydney shakes her head. \"No idea who it was. If they tried that on me, though, I'd tear them in half. Literally. I've been practicing on sides of beef.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "The only person in the Living Room is an older woman in a tweed suit, slashing at a stack of papers with a red pen. \"You must be Hannah Boyd, the victim's college roommate,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" she says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"This is not my field of knowledge or experience, Detective,\" Boyd says. \"Nor of interest. I will leave such matters to you and the other police.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Breakfast Nook you find a young man deep in thought, staring at the ceiling while tapping his pencil on the page of a leather-bound notebook. According to the dossier, this is Leonard Simpson, the victim's accountant.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" he says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Well, in my poem I'm attributing the murder to a black shadow wrought from the ghosts of those murdered by capitalism,\" Leonard says. \"Does that help?\"<p>\"Not... particularly.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "You walk into the Study and meet a man dressed for an extremely expensive white-tie affair. He looks down his nose regally at you. According to the dossier, this is Curly Lucas, the victim's neighbor.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" he says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Well, since you asked me, Detective,\" Lucas sniffs, \"I would say it was undoubtedly that snivelling little upstart of a college roommate.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"The victim's sibling -- do you know them?\" you ask.<p>\"I know of that person, but have never found it necessary to interact with them,\" he sniffs. \"I believe they're in the Pantry at the moment.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Bathroom, where a dark-haired young man in glasses is sitting, deeply focused on a large hardback book; he doesn't look up as you come in. A quick flip through your suspect dossier reveals this to be Doc Calhoun, the victim's ex-college roommate.<p>\"Excuse me,\" you say, \"I'm from the police, and I need to ask you some questions. ...Can you put the book down for a minute?\" He slowly drags his eyes away from the page and regard you impassively. \"Well, it's a start,\" you sigh."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Do you have any thoughts on who did it?\" you ask.<p>\"It was the accountant,\" Doc mutters from behind his book.<p>\"Do you have some kind of evidence for that?\" you ask.<p>No response."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=5", "\"Do you know Sydney Petersen?\" you ask.<p>Doc shakes his head. \"Don't know her well. She's in the Hall Closet, I think.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Dining Room, a small nervous-looking man spins around with a startled look. Judging from the dossier the Officers Chaps gave you, this must be Arthur Chan, the victim's dental hygienist.<p>\"Help!\" he yells. \"They've come for me! It's the murderer!\"<p>\"Settle down,\" you say. \"I'm a detective with the police. I'm investigating the case.\"<p>\"Well, so you <i>say</i>,\" he says, glaring at you with suspicion."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"It could be any of them!\" Arthur shouts. \"Any of them, or none of them! It could be outside forces! Or maybe Taylor committed suicide, don't you see! To put everyone off the scent!\"<p>\"Well, I've seen the pictures,\" you say, \"and I can pretty much confirm it wasn't a suicide.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Bar and meet a woman dressed in cheap knockoff versions of the latest rich peoples' fashions. Your dossier identifies her as Bailey Dawson, the victim's cousin.<p>\"Boy, am I glad to see you!\" she says. \"I just can't believe someone would do this to dear old Taylor. Listen, if there's anything I can do to help, anything at all, you just let me know.\"<p>\"Well,\" you say, \"I would like to ask you some questions.\"<p>\"Questions? Oh, er, right! Yeah, sure, ask away! Always happy to cooperate with the police, that's me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Nah, 'fraid I can't help ya there, Detective,\" Bailey says. \"I mean, I <i>know</i>, and I'll absolutely tell ya anything <i>else</i> ya wanna know, but my rep'll take a real dive if people think I'm a rat, you know what I'm sayin'?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "The only person in the Lounge is a hugely-muscled man, currently working out with a set of oversized freeweights. Judging from the dossier the Officers Chaps gave you, this must be Mitch William, the victim's lawyer.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Taylor'd had a proper regimen like I told her.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>Mitch shakes his head. \"No idea who it was. If they tried that on me, though, I'd tear them in half. Literally. I've been practicing on sides of beef.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "You enter the Foyer and find a young man in a beret, pacing around and muttering to himself while scribbling in a leather-bound notebook. According to the notes the Officers Chaps gave you, this is Pete Alston, the victim's child.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" he says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Oh, well,\" Pete says, \"I mean, I haven't quite finished my poem yet, and I wouldn't like to spoil the dramatic reveal for you, but I could read you what I have so far and...\"<p>\"Just the name, please.\"<p>\"It was Chloe Cooley,\" he says dourly."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"Can you tell me anything about Taylor Velazquez's dental hygienist?\" you ask.<p>\"Are you referring to Gabrielle Osborne?\" Pete asks. \"Yes, I'd say we get along quite well. She doesn't know very much about poetry, I'm afraid, but I'm doing my best to educate her whenever she's not late for one of her many dentist appointments.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Laundry Room, and find a woman dressed in a shapeless gray suit, slouched on a chair and staring at her feet. Judging from the dossier the Officers Chaps gave you, this must be Chloe Cooley, the victim's neighbor.<p>\"Might as well get it over with and put the cuffs on me now,\" she mutters, holding up her wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think the killer is?\" you ask.<p>\"Well,\" Chloe says, \"if I tell you, what's in it for me?\"<p>\"Nothing.\"<p>\"Oh good, my standard compensation. Okay, it was Taylor's child.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=5", "\"Can you tell me anything about Taylor Velazquez's dental hygienist?\" you ask.<p>\"Dental hygienist...\" Chloe mutters. \"...Oh, you mean Arthur Chan. Sure, I know him. I mean, as well as I know anybody, which isn't very well, but he says hello to me sometimes, and that's more than I get from most people.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Basement, and find a young woman wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. She looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" she says, kneeling down to fish for it. \"I was totes on a roll.\" Your dossier identifies her as Jasmine Waters, the victim's business partner.<p>You show her your badge. \"I'm investigating the murder of Savannah Whitley, and I need to ask you some questions.<p>\"Sure, right on,\" she says. \"Ask away, man. Rock it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Oh yeah,\" Jasmine says, nodding. \"You wanna know who did it, dude? I know for sure who did it. It was Avery Navarro. No question.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=1", "\"Avery Navarro. What can you tell me about her?\" you ask.<p>\"Heck yeah, I know Avery Navarro,\" she says. \"She's like, crazy cool. She's a real trip. She's in the Breakfast Nook, give her a high-five for me.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Library you find a gray-haired woman reading through a stack of papers, scowling at them with faint disgust. Your dossier identifies her as Sydney Moran, the victim's bodyguard.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" she says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"I do not feel that the question of who murdered Savannah Whitley has true relevance, Detective,\" Moran says. \"All people die. It is only a matter of when.\"<p>\"And how,\" you mutter."));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Guest Bedroom, where a bored and angry-looking young woman in motorcycle boots and a leather jacket is stomping around and ashing her cigarette on the expensive-looking Turkish carpet. \"You must be Natalia Henry, the victim's golf caddy,\" you say, flipping to the relevant page in the dossier.<p>\"I've got some questions for you,\" you say.<p>\"Good! Great! Ask away!\" she mutters. \"Then maybe I can get out of this dive.\"<p>\"You got somewhere better to be?\"<p>\"If that's the kinda questions you're gonna ask, this is gonna be <i>real</i> fun,\" she says, rolling her eyes."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Well, I'll tell you this,\" Natalia says, \"if I was you -- and I'm friggin' glad I'm not, hah -- but if I was you I'd look into Savannah's neighbor.\"<p>\"How about a name?\" you ask.<p>\"How about up yours, cop?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"What can you tell me about Jasmine Waters?\" you ask.<p>\"I can tell you that piece of crap is stinking up the Basement. You want any more than that, go ask her for yourself.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Bar, you discover a young man, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. \"You must be Roy Francis, the victim's best friend,\" you say, flipping to the relevant page in the dossier.<p>\"What are you doing?\" you ask him. <p>\"Looking for clues! I'm pretty sure Savannah Cooper was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" he says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"Golly! You really want to know what I think, Detective?\" Roy says, excitedly, and pulls out a notebook. \"Okay, so, first I measured some footprints out in the driveway, and...\" <p>\"Kid, we're short on time. Cut to the chase and tell me the details later, okay?\"<p>\"Oh, okay! It was Leroy Hamilton!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=5&visit=1", "\"What do you know about Leroy Hamilton?\" you ask.<p>\"I don't know much about him yet, Detective,\" Roy says, \"But you can tell just by looking at him that he has <i>tons</i> of underworld connections! He's in the Billiard Room right now, I could be the Bad Cop for you!\"<p>\"No thank you,\" you say, to his disappointment."));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "In the Study, you find a large and powerfully-muscled woman doing arm-curls with a set of huge barbells. Judging from the dossier the Officers Chaps gave you, this must be Mackenzie Frost, the victim's cousin.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Mackenzie grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Beats me,\" she mutters. \"If they try and pull that murder stuff on me, though, I'll tie 'em in a knot like a fireplace poker!\"<p>\"...You can do that?\" you ask.<p>\"Yeah! Wanna see?\"<p>\"Yeah, kind of. But later.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "When you enter the Master Bedroom, you encounter a young man wearing a beret and black turtleneck, chewing on the end of his pencil. According to the dossier, this is Vincent Trujillo, the victim's neighbor.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Vincent sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>\"Well, in my poem I'm attributing the murder to a black shadow wrought from the ghosts of those murdered by capitalism,\" Vincent says. \"Does that help?\"<p>\"Not... particularly.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Attic, and find a man dressed in a shapeless gray suit, slouched on a chair and staring at his feet. According to the dossier, this is Dan Matthews, the victim's lawyer.<p>\"Great, here we go,\" he says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"It was Natalia's bodyguard,\" Dan says. \"Does it make you happy to know that? If it does, please let me know, because having never experienced that emotion myself, it's difficult for me to detect it in others.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Have you met the victim's cousin?\" you ask.<p>\"That's Mackenzie Frost,\" he replies. \"I had an entire conversation with her once. Not a long one. And I was doing most of the talking. But still, I guess that counts for a little something.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Dining Room and encounter a man dressed in very expensive-looking formal attire. He regards you with a look of distaste and disdain. A quick flip through your suspect dossier reveals this to be Marlon Lamb, the victim's housekeeper.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" he says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Naturally I know who it was,\" Lamb smirks. \"Who in this house is hungrier for elevation from their miserable station than Abe Ray?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=7&visit=1", "\"Are you familiar with someone named Abe Ray?\" you ask.<p>\"That... <i>guttersnipe</i> can be found in the Smoking Lounge,\" Lamb sniffs. \"Other than that, I have absolutely nothing to say about him.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Billiard Room, a distinctive smell assaults your sinuses. A young woman wearing a tye-dyed t-shirt and a knitted beanie coughs in surprise, hurriedly stubs out her \"cigarette\" in a potted plant, and moves to open a window. \"You must be Leah Baldwin, the victim's neighbor,\" you say, flipping to the relevant page in the dossier.<p>\"Uh, hey,\" she says. \"Hi. Yeah. I'm Leah. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Guest Bedroom, where a dark-haired young man in glasses is sitting, deeply focused on a large hardback book; he doesn't look up as you come in. A quick flip through your suspect dossier reveals this to be Clyde Allison, the victim's ex-accountant.<p>\"Excuse me,\" you say, \"I'm from the police, and I need to ask you some questions. ...Can you put the book down for a minute?\" He slowly drags his eyes away from the page and regard you impassively. \"Well, it's a start,\" you sigh."));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Foyer, you discover a young woman, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. \"You must be Lillian Pruitt, the victim's boss,\" you say, flipping to the relevant page in the dossier.<p>She looks up at you, and her eyes widen with surprise. \"Ooh! You must be the police detective assigned to the case!\"<p>\"That's me,\" you say, showing your badge.<p>\"Great! I'm gonna be a real big help, you'll see!\"<p>\"As long as you stay in here while doing it,\" you say. \"Sorry, but I can't have you running around during the investigation.\"<p>\"Aw, that's okay,\" she says. \"I'll just sneak out while you aren't watching, dodge the guards, and come back before you've realized I'm gone!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Sorry, Detective,\" Lillian says sadly. \"I haven't figured it out yet. This is bunches harder than when I solved the Mystery of Pirate Island!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "The only person in the Game Room is a hugely-muscled woman, currently working out with a set of oversized freeweights. \"You must be Ashley Navarro, the victim's business partner,\" you say, flipping to the relevant page in the dossier.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Molly'd had a proper regimen like I told her.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>Ashley shakes her head. \"No idea who it was. If they tried that on me, though, I'd tear them in half. Literally. I've been practicing on sides of beef.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Study and encounter a woman dressed in very expensive-looking formal attire. She regards you with a look of distaste and disdain. A quick flip through your suspect dossier reveals this to be Ashley Chavez, the victim's gardener.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" she says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Without question, it was Molly's neighbor,\" she replies. <p>\"How do you know that?\" you ask. <p>\"Are you serious, Detective? Have you <i>met</i> them?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=5", "\"Do you know someone named Leah Baldwin?\" you ask.<p>\"That... <i>guttersnipe</i> can be found in the Game Room,\" Chavez sniffs. \"Other than that, I have absolutely nothing to say about her.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "In the Dining Room you find a pale, drably-dressed man slouched on a small chair. He looks up at you as you enter, and sighs pathetically. \"You must be Billy Bob Forbes, the victim's dental hygienist,\" you say, flipping to the relevant page in the dossier.<p>\"It's just one more thing after another, isn't it?\" he mutters bitterly. \"It always rains, and it always pours.\"<p>\"Well, I can see <i>you're</i> going to be a real barrel of laughs,\" you say."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Oh, is that all you want to know?\" Billy Bob asks. \"All right. It was Savannah Knowles. Go ahead and make a big show about how you solved the case all by yourself with your big detective skills, I don't expect to receive any credit for the information.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=6", "\"The victim's neighbor -- do you know them?\" you ask.<p>\"I don't have a single unkind word to say about that person,\" Billy Bob says.<p>\"Do you have anything at all to say about them?\"<p>\"No. Well, they're probably in the Breakfast Nook. Does that count?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "You enter the Breakfast Nook, where a bored and angry-looking young woman in motorcycle boots and a leather jacket is stomping around and ashing her cigarette on the expensive-looking Turkish carpet. According to the notes the Officers Chaps gave you, this is Savannah Knowles, the victim's chauffeur.<p>\"I need to ask you some questions about the murder,\" you say.<p>\"I didn't kill anybody, but if I have to hang around this dump any longer, I might,\" she snarls. \"Hurry up and ask me whatever you're gonna ask, so I can get out of here!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Yeah, fine, okay. You wanna know who did it? It was Clyde Allison. You happy now?\"<p>\"We'll see,\" you say, writing it down in your notebook."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=7", "\"Do you know Winters's neighbor?\" you ask.<p>\"Molly's neighbor? She's called Leah Baldwin. She seems okay. That's all I know, though, so choke on it.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "The only person in the Servants' Quarters is an older woman in a tweed suit, slashing at a stack of papers with a red pen. According to the dossier, this is Genesis Sanders, the victim's college roommate.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" she says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"I do not feel that the question of who murdered Dunstan Douglas has true relevance, Detective,\" Sanders says. \"All people die. It is only a matter of when.\"<p>\"And how,\" you mutter."));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Billiard Room, you find a large and powerfully-muscled woman doing arm-curls with a set of huge barbells. A quick flip through your suspect dossier reveals this to be Brianna Kelly, the victim's housekeeper.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Brianna grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Smoking Lounge and encounter a man dressed in very expensive-looking formal attire. He regards you with a look of distaste and disdain. Your dossier identifies him as Jonas Bond, the victim's ex-cousin.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" he says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Naturally I know who it was,\" Bond smirks. \"Who in this house is hungrier for elevation from their miserable station than Madelyn Hinton?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Can you tell me anything about Dunstan Douglas's college roommate?\" you ask.<p>\"I utterly refuse to have anything to do with that despicable woman,\" Bond scowls. \"Dunstan really suffered from the most appalling luck, to be stuck with a college roommate such as Genesis Sanders.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Foyer, where a bored and angry-looking young man in motorcycle boots and a leather jacket is stomping around and ashing his cigarette on the expensive-looking Turkish carpet. \"You must be Gustav Gay, the victim's sibling,\" you say, flipping to the relevant page in the dossier.<p>\"I've got some questions for you,\" you say.<p>\"Good! Great! Ask away!\" he mutters. \"Then maybe I can get out of this dive.\"<p>\"You got somewhere better to be?\"<p>\"If that's the kinda questions you're gonna ask, this is gonna be <i>real</i> fun,\" he says, rolling his eyes."));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Library you find a woman pacing around and smoking a cigarette. As you enter, she turns and shoots you that particular grin that people use when they're extremely nervous, but are trying to play it cool. Your dossier identifies her as Charlotte Walton, the victim's lover.<p>\"Boy, am I glad to see you!\" she says. \"I just can't believe someone would do this to dear old Martin. Listen, if there's anything I can do to help, anything at all, you just let me know.\"<p>\"Well,\" you say, \"I would like to ask you some questions.\"<p>\"Questions? Oh, er, right! Yeah, sure, ask away! Always happy to cooperate with the police, that's me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"All right, Detective, all right,\" Charlotte grins. \"Ya dragged it out of me. The killer was Lonnie Potts. And I trust you'll remember how helpful I was to you, if we should ever cross paths again!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"Can you tell me anything about Martin Daniels's sibling?\" you ask.<p>\"Sheesh,\" Charlotte grumbles. \"Yeah, I know Aaliyah Stanley. Know her like a kick in the teeth. Got about as much need for her, too.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "As you enter the Guest Bedroom, a distinctive smell assaults your sinuses. A young man wearing a tye-dyed t-shirt and a knitted beanie coughs in surprise, hurriedly stubs out his \"cigarette\" in a potted plant, and moves to open a window. According to the dossier, this is Morgan Frye, the victim's dental hygienist.<p>\"Uh, hey,\" he says. \"Hi. Yeah. I'm Morgan. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "As you enter the Lounge, a man in a drab gray suit looks up at you from the chair he's slouched in, and sighs. According to the dossier, this is Sam Whitley, the victim's gardener.<p>\"Might as well get it over with and put the cuffs on me now,\" he mutters, holding up his wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Well,\" Sam says, \"if I tell you, what's in it for me?\"<p>\"Nothing.\"<p>\"Oh good, my standard compensation. Okay, it was Martin's lover.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"Do you know Daniels's sibling?\" you ask.<p>\"The only sibling I'm aware of around here is Charlotte Walton, and she isn't much of one if you ask me.\"<p>\"I don't think I will.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "When you enter the Laundry Room, you find a young man dressed in crisp tennis whites, idly bouncing a tennis ball on a racket and whistling a jaunty little tune. Judging from the dossier the Officers Chaps gave you, this must be Morris Bishop, the victim's personal assistant.<p>\"I'd love a spot of tea, if you've got one handy,\" he says, then looks up at you and practically jumps to his feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Martin Daniels,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Who murdered Martin?\" Morris asks. \"Hmm. Well now. Was it Clayton Huber?\"<p>You flip through your dossier. \"Who the devil's that?\"<p>\"Made it up. Sorry, it was a shot in the dark.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Ballroom and find an older man in a tweed suit, muttering to himself over a stack of papers. According to the notes the Officers Chaps gave you, this is Andy Fleming, the victim's butler.<p>\"Excuse me,\" you say. \"I'm with the police -- need to ask you a few questions. ...What are you doing?\"<p>\"Grading papers. Although Daniels may have escaped his duties for the oblivion of death,\" he says in a clipped Bavarian accent, \"the rest of us still have jobs that require our attention.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Who do you think the killer is?\" you ask.<p>\"It was Morgan Frye, Detective,\" Fleming says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=6", "\"Gustav Gay. What can you tell me about him?\" you ask.<p>\"You are referring to Martin Daniels's sibling, I believe,\" Fleming says. \"A man of small mind, with no dreams or imagination. He might as well be an iguana.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Kitchen, you meet a young woman, maybe 13 or 14 years old, who is methodically tilting every book in a bookcase, as though trying to find the trigger for a secret door. \"You must be Emma Key, the victim's business partner,\" you say, flipping to the relevant page in the dossier.<p>\"What are you doing?\" you ask her. <p>\"Looking for clues! I'm pretty sure Randy Porter was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" she says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Sorry, Detective,\" Emma says sadly. \"I haven't figured it out yet. This is bunches harder than when I solved the Mystery of Pirate Island!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Lounge, and discover an extremely muscular man lifting weights and glistening with sweat. \"You must be Ed Carrillo, the victim's lover,\" you say, flipping to the relevant page in the dossier.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Ed grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Yeah, easy,\" Ed says. \"It was Randy's ex-college roommate.\"<p>\"Are you sure?\" you ask.<p>\"Hey buddy, these muscles don't lie.\" He flexes at you to demonstrate... something."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Do you know someone by the name of Emma Key?\" you ask.<p>\"'Course I know Emma Key!\" Ed says. \"That's Randy's child. I challenged her to arm-wrestle once, and nearly threw her across the room, heh heh. Oh, don't give me that look, she was fine.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "The only person in the Sunroom is an older woman in a tweed suit, slashing at a stack of papers with a red pen. Judging from the dossier the Officers Chaps gave you, this must be Mackenzie Hanson, the victim's child.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" she says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"The sibling.\"<p>\"What?\"<p>\"The killer was Randy Porter's sibling, Detective,\" Hanson says. <p>\"Oh! I was expecting a wordier response.\"<p>\"I hope you will relish that feeling of surprise, for it is one of the few ways in which a person can prove she is alive.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Do you know Porter's business partner?\" you ask.<p>\"This woman you are speaking of, her name is Evelyn Pena,\" Hanson says. \"My interactions with her have been unpleasant, without exception.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "Inside the Bathroom, you find a young woman in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick her foot to wake her up. \"Uh?\" she says. \"Wha? Oh.\" She stands up, knuckling sleepy, bloodshot eyes. According to the notes the Officers Chaps gave you, this is Jocelyn Rosales, the victim's ex-college roommate.<p>You show her your badge. \"I'm investigating the murder of Randy Porter, and I need to ask you some questions.<p>\"Sure, right on,\" she says. \"Ask away, man. Rock it.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Ballroom, where a dark-haired young man in glasses is sitting, deeply focused on a large hardback book; he doesn't look up as you come in. \"You must be Clayton Thomas, the victim's personal assistant,\" you say, flipping to the relevant page in the dossier.<p>\"I'm from the police, and I'll need to ask you a few questions,\" you say.<p>\"Mm-hmm,\" comes the reply.<p>\"...You're the quiet type, I gather.\"<p>\"Mm-hmm.\"<p>\"Are all your answers going to be like this?\"<p>He turns the page without comment."));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "Inside the Bar you find a young woman deep in thought, staring at the ceiling while tapping her pencil on the page of a leather-bound notebook. \"You must be Lillian Solis, the victim's cousin,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say. \"I'm from the police, and I need to ask you a few questions.\"<p>\"Hmm,\" she says. \"Questions, questions. ...No, no, that won't do at all.\"<p>\"I beg your pardon?\"<p>\"There's no good rhyme for 'questions', it simply won't fit.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Who do you think the killer is?\" you ask.<p>\"I think it was probably either a raven, or a metaphor for the tyranny of social expectations,\" Lillian says. <p>\"Well thanks,\" you say dryly. \"I'll be sure to put an APB out on both of those things.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "Inside the Hall Closet you find a woman pacing around and smoking a cigarette. As you enter, she turns and shoots you that particular grin that people use when they're extremely nervous, but are trying to play it cool. Judging from the dossier the Officers Chaps gave you, this must be Alexis Carter, the victim's chauffeur.<p>\"Hey, what took ya so long?\" she asks. \"Hah, nah, just kiddin' with ya. I know you boys have got a tough job, always had a deep respect for the boys in blue. Anything you wanna know, just ask me -- Alexis Carter. Nobody knows what's going down around this place like I do.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Well gee, Detective,\" Alexis says, \"I hate to disappoint ya, but I haven't got a clue who could've done it. Far as I know, everyone in this house loved Randy like a brother. Or a sister, or whatever.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=8", "In the Pantry you find a pale, drably-dressed woman slouched on a small chair. She looks up at you as you enter, and sighs pathetically. A quick flip through your suspect dossier reveals this to be Evelyn Pena, the victim's butler.<p>\"It's just one more thing after another, isn't it?\" she mutters bitterly. \"It always rains, and it always pours.\"<p>\"Well, I can see <i>you're</i> going to be a real barrel of laughs,\" you say."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=8", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"I don't know who killed Randy, but I do know they'd have saved me a lot of trouble if they'd killed me too. Guess they couldn't be bothered to waste the bullet or whatever.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=9", "In the Servants' Quarters you meet a young woman dressed in crisp tennis whites, relaxing and leafing idly through a fashion magazine, apparently without a care in the world. \"You must be Natalia Sandoval, the victim's sibling,\" you say, flipping to the relevant page in the dossier.<p>She looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking her proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Who do you think the killer is?\" you ask.<p>\"Who did it, Detective? Well yes, that's the question, isn't it?\" Natalia says. \"That's the query whizzing around everyone's racetrack today. Who put the nails in poor old Randy's coffin. Well, well. And might I add, well.\"<p>\"...You don't know, do you?\"<p>\"Oh, certainly. It was the personal assistant.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=9", "\"Can you tell me anything about Randy Porter's business partner?\" you ask.<p>\"Business partner, business partner. Hmm,\" Natalia ponders. \"No, sorry Detective, I don't know who that is, dash it all. ...Oh! Unless you mean Emma Key? Now that you mention it, I do seem to remember something about her being Randy's business partner. Well there you go! That must be it.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Family Room, which appears to be empty -- until a nervous face appears from behind the sofa. According to the notes the Officers Chaps gave you, this is Elizabeth Cortez, the victim's housekeeper.<p>\"Help!\" she yells. \"They've come for me! It's the murderer!\"<p>\"Settle down,\" you say. \"I'm a detective with the police. I'm investigating the case.\"<p>\"Well, so you <i>say</i>,\" she says, glaring at you with suspicion."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"I don't know who did it!\" Elizabeth says, really loudly. \"I don't know a thing! Why are you even asking me? Even if I did know, I certainly wouldn't tell you!\" And then she looks around and whispers, \"It was Hilary Colon!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=5&visit=1", "\"Do you know someone named Hilary Colon?\" you ask.<p>\"I think he's okay,\" Elizabeth says, glancing over her shoulder. \"At least, I've seen no overt indications that he's been sent to get me. You'd better go to the Sunroom and check him out for yourself, though.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "In the Family Room, you find a dark-haired young woman sitting quietly, reading a book. She glances briefly at you over the top of her glasses as you enter, but says nothing. According to the dossier, this is Sarah Decker, the victim's gardener.<p>\"Excuse me,\" you say, \"I'm from the police, and I need to ask you some questions. ...Can you put the book down for a minute?\" She slowly drags her eyes away from the page and regard you impassively. \"Well, it's a start,\" you sigh."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>She ignores you and keeps reading."));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You walk into the Lounge and meet a woman dressed for an extremely expensive white-tie affair. She looks down her nose regally at you. A quick flip through your suspect dossier reveals this to be Peyton Clarke, the victim's physician.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask you a few questions.\" <p>\"I am already late for the French Ambassador's gala,\" she  says coldly. \"I trust this will not take long?\" <p>\"Depends on how quickly you answer.\"<p>She glares at you for a second, then rolls her eyes. \"Oh, very well. Ask.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"You're asking <i>me</i>, Detective?\" she exclaims. \"If I knew that, this ridiculous little mishap would have been handled already!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Living Room, and encounter a young woman -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. According to the dossier, this is Brianna Montoya, the victim's personal assistant.<p>\"What are you doing?\" you ask her. <p>\"Looking for clues! I'm pretty sure Gavin Rodgers was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" she says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Golly!\" Brianna exclaims, \"A real-life detective wants to know what I think?\" <p>\"Sure, kid,\" you say. \"What've you got?\"<p>She flips open her notebook and quickly scans the pages. \"I think it's the victim's physician, Detective! It's gotta be!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Are you familiar with someone named Sarah Decker?\" you ask.<p>\"That's Gavin Rodgers's physician!\" Brianna says. \"She's really very nice, once you get to know her! Or once you follow her around for a while, peeking out from behind lampposts and stuff.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "When you enter the Library, you encounter a young man wearing a beret and black turtleneck, chewing on the end of his pencil. \"You must be Joey Stewart, the victim's accountant,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" he says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Hmm, well,\" Joey muses, \"I suppose it does make for a more satisfying conclusion to my poem if you actually apprehend the criminal. Very well, it was Stevie Velez.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"Do you know Rodgers's gardener?\" you ask.<p>\"I have nothing good to say about that... person,\" Joey snorts. \"Their presence in the Family Room is lowering the average intelligence of the household by at least thirty points.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Servants' Quarters, which appears to be empty -- until a nervous face appears from behind the sofa. Your dossier identifies her as Jessica Perry, the victim's butler.<p>\"Help!\" she yells. \"They've come for me! It's the murderer!\"<p>\"Settle down,\" you say. \"I'm a detective with the police. I'm investigating the case.\"<p>\"Well, so you <i>say</i>,\" she says, glaring at you with suspicion."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"It could be any of them!\" Jessica shouts. \"Any of them, or none of them! It could be outside forces! Or maybe Victoria committed suicide, don't you see! To put everyone off the scent!\"<p>\"Well, I've seen the pictures,\" you say, \"and I can pretty much confirm it wasn't a suicide.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "As you enter the Basement, you are greeted by an aristocratic-looking woman dressed for a white-tie occasion. She looks you up and down, and doesn't appear to think much of what she sees. Your dossier identifies her as Addison Ramirez, the victim's lawyer.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask you a few questions.\" <p>\"I am already late for the French Ambassador's gala,\" she  says coldly. \"I trust this will not take long?\" <p>\"Depends on how quickly you answer.\"<p>She glares at you for a second, then rolls her eyes. \"Oh, very well. Ask.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"You wish to hear my opinion?\" she says. \"Well, that's very astute of you, Detective. In my view, it must have been Colin Harris. I've never encountered a more obvious criminal.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"Can you tell me anything about Victoria McDaniel's butler?\" you ask.<p>\"Jessica Perry? Why yes,\" she replies. \"She's delightful -- wonderful sense of humor. What a shame she'll never amount to anything.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "A dark-haired young woman is sitting in the Attic, quietly reading a large hardcover book. She doesn't seem to be aware of your presence. A quick flip through your suspect dossier reveals this to be Madeline Lawson, the victim's gardener.<p>\"I'm from the police, and I'll need to ask you a few questions,\" you say.<p>\"Mm-hmm,\" comes the reply.<p>\"...You're the quiet type, I gather.\"<p>\"Mm-hmm.\"<p>\"Are all your answers going to be like this?\"<p>She turns the page without comment."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>She looks up at you, and thinks for a second. \"Hmm...\"<p>\"Yes?\"<p>\"...probably Julia Salazar.\"<p>\"And why do you say that?\"<p>Shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=3&visit=1", "\"Are you familiar with a woman named Julia Salazar?\" you ask.<p>Madeline nods slightly. \"Melanie's accountant\".<p>\"Is there anything else you can tell me?\"<p>Silence."));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Laundry Room you find a gray-haired woman reading through a stack of papers, scowling at them with faint disgust. According to the notes the Officers Chaps gave you, this is Gabrielle Goff, the victim's physician.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" she says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Do you not already know, Detective?\" Goff asks. \"You need only ask yourself, who among these people is so ruled by fear that they would take the life of another in order to prolong their own existence, miserable though it may be?\" <p>\"...Just answer the question, please?\"<p>\"Leonard Collins.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=1", "\"What do you know about Leonard Collins?\" you ask.<p>\"Ah yes. Chloe Yang's cousin,\" Goff says. \"An excellent mind. Very imaginative. Imagination is very important, Detective, for it is one of the few advantages than a human has over an animal.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Game Room you find a young woman deep in thought, staring at the ceiling while tapping her pencil on the page of a leather-bound notebook. Your dossier identifies her as Sophia Rowland, the victim's college roommate.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" she says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Who killed Jacky?\" Sophia asks. \"Why, I haven't the faintest idea. I was rather hoping you could tell me, or else I won't be able to give my poem a proper ending.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Foyer you find a pale, drably-dressed man slouched on a small chair. He looks up at you as you enter, and sighs pathetically. A quick flip through your suspect dossier reveals this to be Gavin Glenn, the victim's ex-accountant.<p>\"Great, here we go,\" he says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"I don't know who killed Jacky, but I do know they'd have saved me a lot of trouble if they'd killed me too. Guess they couldn't be bothered to waste the bullet or whatever.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "The only person in the Dining Room is a hugely-muscled man, currently working out with a set of oversized freeweights. \"You must be Lewis Terrell, the victim's golf caddy,\" you say, flipping to the relevant page in the dossier.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Lewis grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Yeah, easy,\" Lewis says. \"It was Jacky's physician.\"<p>\"Are you sure?\" you ask.<p>\"Hey buddy, these muscles don't lie.\" He flexes at you to demonstrate... something."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"What do you know about Sophia Rowland?\" you ask.<p>\"She's Jacky's college roommate,\" Lewis says. \"We don't have much in common, but we get along pretty well. She's got a real good sense of humor, you know? Funny.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "A dark-haired young woman is sitting in the Sunroom, quietly reading a large hardcover book. She doesn't seem to be aware of your presence. \"You must be Stella West, the victim's housekeeper,\" you say, flipping to the relevant page in the dossier.<p>\"What are you reading?\" you ask, to break the silence. She silently gestures at the cover, which is jacketless and doesn't have the title printed on it. \"So... a book.\"<p>\"Mm-hmm,\" she replies."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"No idea,\" she says, turning a page in her book."));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "When you enter the Family Room, you find a young woman dressed in crisp tennis whites, idly bouncing a tennis ball on a racket and whistling a jaunty little tune. A quick flip through your suspect dossier reveals this to be Aaliyah Turner, the victim's personal assistant.<p>\"I'd love a spot of tea, if you've got one handy,\" she says, then looks up at you and practically jumps to her feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Kaylee Cote,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Who murdered Kaylee?\" Aaliyah asks. \"Hmm. Well now. Was it Saul Talley?\"<p>You flip through your dossier. \"Who the devil's that?\"<p>\"Made it up. Sorry, it was a shot in the dark.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "The only person in the Lounge is an older man in a tweed suit, slashing at a stack of papers with a red pen. A quick flip through your suspect dossier reveals this to be Jedediah Odom, the victim's business partner.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" he says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"I can only assume it was Kaylee Cote's boss,\" Odom says. \"If you have witnessed for yourself the lizard-like quality of their eyes, Detective, you must undoubtedly have reached the same conclusion.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"I understand the victim had a housekeeper,\" you say. \"Can you tell me anything about them?\"<p>\"A well-mannered individual,\" Odom says. \"Regrettably, I can tell you no more, as we have had no opportunity for conversation. They are in the Sunroom, I believe.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Smoking Lounge, you meet a young woman, maybe 13 or 14 years old, who is methodically tilting every book in a bookcase, as though trying to find the trigger for a secret door. According to the notes the Officers Chaps gave you, this is Layla Reed, the victim's ex-ex-ex-chauffeur.<p>She looks up at you, and her eyes widen with surprise. \"Ooh! You must be the police detective assigned to the case!\"<p>\"That's me,\" you say, showing your badge.<p>\"Great! I'm gonna be a real big help, you'll see!\"<p>\"As long as you stay in here while doing it,\" you say. \"Sorry, but I can't have you running around during the investigation.\"<p>\"Aw, that's okay,\" she says. \"I'll just sneak out while you aren't watching, dodge the guards, and come back before you've realized I'm gone!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"Golly!\" Layla exclaims, \"A real-life detective wants to know what I think?\" <p>\"Sure, kid,\" you say. \"What've you got?\"<p>She flips open her notebook and quickly scans the pages. \"I think it's the victim's lawyer, Detective! It's gotta be!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=2&visit=1", "\"Have you met the victim's lawyer?\" you ask.<p>\"I dunno much of anything about them, Detective,\" Layla says apologetically. \"I'm pretty sure they're in the Servants' Quarters right now, though.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "In the Game Room you find a pale, drably-dressed woman slouched on a small chair. She looks up at you as you enter, and sighs pathetically. A quick flip through your suspect dossier reveals this to be Nevaeh Lane, the victim's ex-golf caddy.<p>\"It's just one more thing after another, isn't it?\" she mutters bitterly. \"It always rains, and it always pours.\"<p>\"Well, I can see <i>you're</i> going to be a real barrel of laughs,\" you say."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Who killed Red Merrill? You're asking me? Why not ask me something I know the answer to, like who's supposed to clean the toilets around here. The answer to that is not, in fact, me, but guess what? I end up having to do it anyway.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "As you enter the Basement, you are greeted by an aristocratic-looking woman dressed for a white-tie occasion. She looks you up and down, and doesn't appear to think much of what she sees. \"You must be Molly Parrish, the victim's cousin,\" you say, flipping to the relevant page in the dossier.<p>\"Sorry to disturb you,\" you say, \"but I'm investigating Red Merrill's death, and I need to ask you some questions.\"<p>\"I am an extremely busy woman, Detective, and I have places to be this evening,\" she sniffs haughtily. <p>\"That's fine,\" you say. \"The sooner I get these questions answered, the sooner you can go.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>\"You're asking <i>me</i>, Detective?\" she exclaims. \"If I knew that, this ridiculous little mishap would have been handled already!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Lounge, you meet a young woman, maybe 13 or 14 years old, who is methodically tilting every book in a bookcase, as though trying to find the trigger for a secret door. A quick flip through your suspect dossier reveals this to be Eva Carroll, the victim's golf caddy.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" she says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and her eyes widen when you show her your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" she pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Golly! You really want to know what I think, Detective?\" Eva says, excitedly, and pulls out a notebook. \"Okay, so, first I measured some footprints out in the driveway, and...\" <p>\"Kid, we're short on time. Cut to the chase and tell me the details later, okay?\"<p>\"Oh, okay! It was Floyd Cruz!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know someone by the name of Nevaeh Lane?\" you ask.<p>\"She's in the Game Room right now,\" Eva says, \"but I don't think she did the murder. At least, I haven't found any evidence to suggest it yet!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Study. The woman inside stands to greet you, but her gaze doesn't seem to want to meet your own, flickering around you like a rat sizing up a trap. \"You must be Eva Robles, the victim's lawyer,\" you say, flipping to the relevant page in the dossier.<p>\"Good, good,\" she says. \"I'm glad you're here, Officer.\"<p>\"Detective.\"<p>\"Right! Right, of course, Detective, sorry. What a terrible thing that happened, just awful. But I'm sure you'll get to the bottom of it right away, yeah?\"<p>\"Hopefully, yes,\" you say. \"I'd like to ask you a few questions.\"<p>\"Sure, sure! Ask away, Detective, I've got nothin' to hide!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Well now!\" Eva says, glancing around the room and over her shoulder. \"Ain't every day a police detective asks my opinion on a thing like that! Sorry though, I just don't know what to tell ya. <i>*cough*Joe Boyd*cough*</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=1", "\"What can you tell me about Joe Boyd?\" you ask.<p>\"Oh yeah, me and Joe Boyd, we get along great!\" Eva says. \"Two peas in a pod, that's us. He'll be in the Sunroom, tell him I sent ya.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Boiler Room you meet a young man dressed in crisp tennis whites, relaxing and leafing idly through a fashion magazine, apparently without a care in the world. A quick flip through your suspect dossier reveals this to be Manny Aguirre, the victim's personal assistant.<p>\"I'd love a spot of tea, if you've got one handy,\" he says, then looks up at you and practically jumps to his feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Claudius Juarez,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Who murdered Claudius?\" Manny asks. \"Hmm. Well now. Was it Manny Cox?\"<p>You flip through your dossier. \"Who the devil's that?\"<p>\"Made it up. Sorry, it was a shot in the dark.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "The only person in the Basement is a hugely-muscled woman, currently working out with a set of oversized freeweights. According to the notes the Officers Chaps gave you, this is Layla Weiss, the victim's cousin.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Layla grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Oh yeah,\" Layla says. I know who it was. It was Chloe Bender. And if I wasn't so busy with Arm Day, I'd wring that scrawny neck myself.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know someone by the name of Eva Robles?\" you ask.<p>\"Huh!\" Layla grunts. \"That's Claudius's lawyer -- a skinny little sneak. I trust her about as far as I can throw her... er... I guess that's pretty far actually.\" Her forehead creases as she considers this. \"As far as I could <i>not</i> throw her?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "The only person in the Guest Bedroom is an older man in a tweed suit, slashing at a stack of papers with a red pen. Judging from the dossier the Officers Chaps gave you, this must be Dale Durham, the victim's ex-gardener.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" he says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"I respect that the matter is of interest to you, Detective,\" Durham says, \"because it is only through the interest of people such as yourself that our society can withstand the forces of chaos for the brief time that we inhabit this universe. However, I do not share your interest.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Library, you find a large and powerfully-muscled woman doing arm-curls with a set of huge barbells. Your dossier identifies her as Kaitlyn Eaton, the victim's physician.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" she replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Pantry you find a young woman deep in thought, staring at the ceiling while tapping her pencil on the page of a leather-bound notebook. According to the dossier, this is Kayla Sharpe, the victim's college roommate.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" she says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"It was the grim spectre of guilt, which gripped Nick Boyer's heart in the icy talons of--\"<p>\"No metaphors, please.\"<p>\"It was his physician,\" she grumbles."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Do you know Boyer's ex-gardener?\" you ask.<p>\"I'll have nothing to do with that savage in the Boiler Room,\" Kayla says. \"Not until they apologize for comparing my 'Opus XXVII' to Smash Mouth lyrics.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "When you enter the Dining Room, you find a young man dressed in crisp tennis whites, idly bouncing a tennis ball on a racket and whistling a jaunty little tune. \"You must be Grant Owens, the victim's cousin,\" you say, flipping to the relevant page in the dossier.<p>He looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking his proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"You want to know... who do I...?\" Grant looks flummoxed. \"Sorry, old bean. I can certainly understand why you'd ascribe me a certain Sherlockian intelligence, but I haven't the first clue of who might have done that deed.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "Inside the Servants' Quarters you find a man pacing around and smoking a cigarette. As you enter, he turns and shoots you that particular grin that people use when they're extremely nervous, but are trying to play it cool. Your dossier identifies him as Jack Alexander, the victim's lover.<p>\"Hey, what took ya so long?\" he asks. \"Hah, nah, just kiddin' with ya. I know you boys have got a tough job, always had a deep respect for the boys in blue. Anything you wanna know, just ask me -- Jack Alexander. Nobody knows what's going down around this place like I do.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think the killer is?\" you ask.<p>\"Well I gotta say, Detective, I wasn't expecting such a direct line of questioning,\" Jack says. \"Tell ya what, I'll give ya a hint: check out Nick's gardener.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=5", "\"Do you know Boyer's ex-gardener?\" you ask.<p>\"Sheesh,\" Jack grumbles. \"Yeah, I know Dale Durham. Know him like a kick in the teeth. Got about as much need for him, too.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Game Room and find an annoyed-looking young woman slouched on a leather sofa with her motorcycle boots propped up on the expensive ebony coffee-table. She gives you a withering look and lights a cigarette. According to the dossier, this is Angelina Aguilar, the victim's best friend.<p>\"I need to ask you some questions about the murder,\" you say.<p>\"I didn't kill anybody, but if I have to hang around this dump any longer, I might,\" she snarls. \"Hurry up and ask me whatever you're gonna ask, so I can get out of here!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"What, now you want me to do your damn job for you?\" she sneers. \"You're the big-time detective, you figure it out!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "As you enter the Foyer, a wild-eyed man accosts you, pointing with an outstretched and trembling finger. Judging from the dossier the Officers Chaps gave you, this must be Ike Mathews, the victim's golf caddy.<p>\"Help!\" he yells. \"They've come for me! It's the murderer!\"<p>\"Settle down,\" you say. \"I'm a detective with the police. I'm investigating the case.\"<p>\"Well, so you <i>say</i>,\" he says, glaring at you with suspicion."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"If I knew that, I wouldn't be out of my mind with fear!\" Ike exclaims. \"It could be any of them! <i>Any of them!!</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "In the Bathroom you meet a young man dressed in crisp tennis whites, relaxing and leafing idly through a fashion magazine, apparently without a care in the world. \"You must be Stephen Stone, the victim's personal assistant,\" you say, flipping to the relevant page in the dossier.<p>\"I'd love a spot of tea, if you've got one handy,\" he says, then looks up at you and practically jumps to his feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Eustace Harper,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"It's interesting you should ask me that, Detective, because I was just asking myself the very same,\" Stephen says. \"The identical, as it were.\"<p>\"...And?\"<p>\"Hmm?\"<p>\"Who killed Eustace Harper?\"<p>\"Oh! It was the chauffeur, of course. Terribly sorry, I thought you already knew.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Have you met the victim's best friend?\" you ask.<p>\"As concerns the individual currently occupying the Basement, Detective,\" Stephen says, \"allow me to say one word: <i>balderdash.</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "The only person in the Lounge is a hugely-muscled man, currently working out with a set of oversized freeweights. According to the notes the Officers Chaps gave you, this is Lewis Mooney, the victim's dental hygienist.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Lewis grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Oh, that's as easy as tearing a telephone in half,\" Lewis says. \"It was Eustace's ex-lawyer.\"<p>'You don't mean 'telephone book', do you?\"<p>\"Nope.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=4", "\"Are you familiar with someone named Angelina Aguilar?\" you ask.<p>\"Sure! Angelina Aguilar's a good friend. We play games all the time,\" he replies. <p>\"Games?\"<p>\"Yeah, she beats me at chess, and then I beat her at leg-wrestling. She's in the Game Room if you want to meet her.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Hall Closet, and find a young woman wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. She looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" she says, kneeling down to fish for it. \"I was totes on a roll.\" \"You must be Natalia Mitchell, the victim's personal assistant,\" you say, flipping to the relevant page in the dossier.<p>\"Uh, hey,\" she says. \"Hi. Yeah. I'm Natalia. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Okay, well, uhh...\" Natalia hesitates. \"...Like I don't wanna be a narc or whatever, so I don't wanna name names, you know dude? But okay, I will say you should check out Payton's best friend. Like for real, you know?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=4&visit=1", "\"What can you tell me about the deceased's best friend?\" you ask.<p>\"You mean Olivia Fulton?\" Natalia asks. \"Yeah I kinda know her, I guess. Like I know her well enough to say hey to. And then get the hell out of Dodge because dang, man, right?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Living Room, you discover a young man, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. According to the dossier, this is Ed Gilbert, the victim's cousin.<p>\"What are you doing?\" you ask him. <p>\"Looking for clues! I'm pretty sure Clayton Compton was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" he says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"Jeez, Detective!\" Ed pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "As you enter the Wine Cellar, you are greeted by an aristocratic-looking man dressed for a white-tie occasion. He looks you up and down, and doesn't appear to think much of what he sees. Judging from the dossier the Officers Chaps gave you, this must be Travis Holcomb, the victim's child.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask you a few questions.\" <p>\"I am already late for the French Ambassador's gala,\" he  says coldly. \"I trust this will not take long?\" <p>\"Depends on how quickly you answer.\"<p>He glares at you for a second, then rolls his eyes. \"Oh, very well. Ask.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Laundry Room, where a dark-haired young man in glasses is sitting, deeply focused on a large hardback book; he doesn't look up as you come in. Judging from the dossier the Officers Chaps gave you, this must be Clancy Perez, the victim's butler.<p>\"What are you reading?\" you ask, to break the silence. He silently gestures at the cover, which is jacketless and doesn't have the title printed on it. \"So... a book.\"<p>\"Mm-hmm,\" he replies."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>Clancy tilts his head to the side in thought for a moment. \"...Madison Wise.\"<p>\"Okay,\" you say. \"And why do you say that?\"<p>Clancy turns a page and goes back to his reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Are you familiar with someone named Ed Gilbert?\" you ask.<p>\"I have nothing good to say about him.\"<p>\"At this point,\" you growl, \"I would be delighted to get any kind of information at all out of you.\"<p>\"He's in the Living Room.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Wine Cellar and find a young woman in a beret, pacing around and muttering to herself while scribbling in a leather-bound notebook. \"You must be Hailey Witt, the victim's boss,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" she says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Well, I hate to give away the ending,\" Hailey says, \"but I'm having trouble with that part anyway. What's a good rhyme for 'Larry McIntosh'?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=2&visit=1", "\"Do you know Larry McIntosh?\" you ask.<p>\"Oh, Larry McIntosh is my biggest fan!\" Hailey says. \"He is always asking me to read him my poems. I mean, I'm sure he would, if he wasn't always in such a rush, poor dear. You might find him in the Foyer.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Boiler Room you find a pale, drably-dressed man slouched on a small chair. He looks up at you as you enter, and sighs pathetically. Your dossier identifies him as Larry McIntosh, the victim's accountant.<p>\"Great, here we go,\" he says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Who killed Peter Blanchard? You're asking me? Why not ask me something I know the answer to, like who's supposed to clean the toilets around here. The answer to that is not, in fact, me, but guess what? I end up having to do it anyway.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You walk into the Foyer and meet a man dressed for an extremely expensive white-tie affair. He looks down his nose regally at you. Judging from the dossier the Officers Chaps gave you, this must be Jake Wall, the victim's lover.<p>\"Sorry to disturb you,\" you say, \"but I'm investigating Peter Blanchard's death, and I need to ask you some questions.\"<p>\"I am an extremely busy man, Detective, and I have places to be this evening,\" he sniffs haughtily. <p>\"That's fine,\" you say. \"The sooner I get these questions answered, the sooner you can go.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "As you enter the Library, a distinctive smell assaults your sinuses. A young woman wearing a tye-dyed t-shirt and a knitted beanie coughs in surprise, hurriedly stubs out her \"cigarette\" in a potted plant, and moves to open a window. According to the notes the Officers Chaps gave you, this is Genesis Jacobson, the victim's business partner.<p>\"So uh, what's up man?\" she asks. \"I mean, Officer.\"<p>\"Detective,\" you say, flashing your badge.<p>\"Right on, right on. So what's the skinny?\"<p>\"I need to ask you a few questions.\"<p>\"Okay, sure, yeah. Shoot.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Do you have any thoughts on who did it?\" you ask.<p>Genesis looks over her shoulder. \"Okay, well, you didn't hear this from me, right dude? But it was Hailey Witt. Don't ask me how I know, but like, scout's honor.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=4", "\"Are you familiar with someone named Hailey Witt?\" you ask.<p>\"Oh jeez, Hailey Witt is a total downer,\" she replies. \"Like a primo buzzkill.\"<p>\"I need something more concrete than that.\"<p>\"Right, right. Umm... I think she's Peter's boss? Can't tell ya much more than that, man.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Hall Closet, a small nervous-looking man spins around with a startled look. According to the dossier, this is James Burnett, the victim's chauffeur.<p>\"Who are you?!\" he demands. \"Police,\" you reply. \"I need to ask you a few questions about--\"<p>\"And how do I know you're telling the truth? I should just take your word for it? You could be anybody!\"<p>With a sigh, you pull out your badge and show it to him. \"Happy?\"<p>\"And I'm supposed to just trust that that's real? Well... all right. For now. But I've got my eye on you!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"If I knew that, I wouldn't be out of my mind with fear!\" James exclaims. \"It could be any of them! <i>Any of them!!</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Breakfast Nook and encounter a well-to-do-looking young woman dressed in crisp tennis whites, lounging casually across an overstuffed chair and flipping playing cards into a straw boater -- or rather, attempting to, and largely missing. Your dossier identifies her as Zoe Snider, the victim's ex-butler.<p>She looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking her proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Who put paid to old Molly? Well, that's quite a question, isn't it Detective?\" Zoe says. \"I mean, it could be bally anyone, and there's quite a quantity of people on this old ball of rock we call Earth.\"<p>\"...We're pretty sure it was someone in this house,\" you say.<p>\"Oh! Well, it was Oliver Silva, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Do you know someone named James Burnett?\" you ask.<p>\"Well, there's nothing like a good friend, Detective,\" Zoe says, \"and that creature currently residing within the Sunroom is nothing like a good friend!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Living Room and find an older man in a tweed suit, muttering to himself over a stack of papers. \"You must be Oliver Silva, the victim's accountant,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" he says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"I do not feel that the question of who murdered Molly Velazquez has true relevance, Detective,\" Silva says. \"All people die. It is only a matter of when.\"<p>\"And how,\" you mutter."));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "When you enter the Servants' Quarters, you encounter a young woman wearing a beret and black turtleneck, chewing on the end of her pencil. A quick flip through your suspect dossier reveals this to be Madison Gutierrez, the victim's gardener.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" she says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think the killer is?\" you ask.<p>\"Well, in my poem I'm attributing the murder to a black shadow wrought from the ghosts of those murdered by capitalism,\" Madison says. \"Does that help?\"<p>\"Not... particularly.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Bathroom and meet a woman dressed in cheap knockoff versions of the latest rich peoples' fashions. According to the notes the Officers Chaps gave you, this is Andrea Wilder, the victim's bodyguard.<p>\"Hey, what took ya so long?\" she asks. \"Hah, nah, just kiddin' with ya. I know you boys have got a tough job, always had a deep respect for the boys in blue. Anything you wanna know, just ask me -- Andrea Wilder. Nobody knows what's going down around this place like I do.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Well now!\" Andrea says, glancing around the room and over her shoulder. \"Ain't every day a police detective asks my opinion on a thing like that! Sorry though, I just don't know what to tell ya. <i>*cough*James Burnett*cough*</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=5", "\"What can you tell me about the deceased's chauffeur?\" you ask.<p>\"Nah, I got no use for them,\" Andrea says. \"Nothin' but trouble. Probably hangin' around the Attic, if you've got time to waste.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "In the Sunroom you find a pale, drably-dressed woman slouched on a small chair. She looks up at you as you enter, and sighs pathetically. \"You must be Alexa McIntyre, the victim's lover,\" you say, flipping to the relevant page in the dossier.<p>\"Great, here we go,\" she says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"I don't have any idea,\" she says, \"but I guarantee if you ask anyone else, they'll all say it was me. That's how it goes around here. I do all the work, and do I get any of the credit? No, don't bother answering, it's a rhetorical question and the answer is perfectly obvious anyway.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "Inside the Family Room, you discover a young woman, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. Your dossier identifies her as Genesis Hopper, the victim's business partner.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" she says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and her eyes widen when you show her your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" she pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Jeez, Detective!\" Genesis pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=8", "Inside the Attic, you find a young man in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick his foot to wake him up. \"Uh?\" he says. \"Wha? Oh.\" He stands up, knuckling sleepy, bloodshot eyes. According to the notes the Officers Chaps gave you, this is Woody Mason, the victim's cousin.<p>\"Uh, hey,\" he says. \"Hi. Yeah. I'm Woody. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=8", "\"Who do you think the killer is?\" you ask.<p>\"Heck if I know, dude,\" he says. \"Like, your guess is as good as mine, right?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=9", "You enter the Study and find an annoyed-looking young woman slouched on a leather sofa with her motorcycle boots propped up on the expensive ebony coffee-table. She gives you a withering look and lights a cigarette. According to the dossier, this is Stella Summers, the victim's neighbor.<p>\"I need to ask you some questions about the murder,\" you say.<p>\"I didn't kill anybody, but if I have to hang around this dump any longer, I might,\" she snarls. \"Hurry up and ask me whatever you're gonna ask, so I can get out of here!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Yeah, fine, okay. You wanna know who did it? It was Andrea Wilder. You happy now?\"<p>\"We'll see,\" you say, writing it down in your notebook."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=9", "\"The victim's chauffeur -- do you know them?\" you ask.<p>\"Oh, <i>that</i> jerkoff. Go to the Hall Closet and see for yourself why I wouldn't give a wet fart.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Foyer, a wild-eyed woman accosts you, pointing with an outstretched and trembling finger. Judging from the dossier the Officers Chaps gave you, this must be Ella McCarty, the victim's neighbor.<p>\"Who are you?!\" she exclaims. \"Don't come any closer or I'll call the cops!\"<p>\"I <i>am</i> the cops,\" you say, showing her your badge.<p>\"Oh thank god! Thank god you're here! I'm going to be next, I just know it, you have to protect me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"It could be any of them!\" Ella shouts. \"Any of them, or none of them! It could be outside forces! Or maybe Sydney committed suicide, don't you see! To put everyone off the scent!\"<p>\"Well, I've seen the pictures,\" you say, \"and I can pretty much confirm it wasn't a suicide.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Bathroom you meet a young woman dressed in crisp tennis whites, relaxing and leafing idly through a fashion magazine, apparently without a care in the world. Your dossier identifies her as Mariah Fuller, the victim's bodyguard.<p>She looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking her proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"It was Sydney's child, Detective,\" Mariah says. \"And that's the honest truth, not a fib to get out of an unpleasant betrothal arrangement, I assure you.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"Can you tell me anything about Sydney Soto's neighbor?\" you ask.<p>\"That's Ella McCarty, isn't it?\" Mariah asks. \"Don't know her well, Detective, but she seems quite respectable. Stable sort, plenty of atoms up in the old thinkpiece.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Game Room, where a dark-haired young man in glasses is sitting, deeply focused on a large hardback book; he doesn't look up as you come in. Judging from the dossier the Officers Chaps gave you, this must be Wallace Hoffman, the victim's ex-golf caddy.<p>\"What are you reading?\" you ask, to break the silence. He silently gestures at the cover, which is jacketless and doesn't have the title printed on it. \"So... a book.\"<p>\"Mm-hmm,\" he replies."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>Wallace turns a page in his book. \"I think it was the gardener.\"<p>\"Okay,\" you say, writing it down. \"Why do you say that? ...Hello?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=7&visit=1", "\"Can you tell me anything about the victim's gardener? you ask.<p><p>\"Layla Peterson. We don't talk.\"<p>\"Do you actually talk to anyone?\"<p>He turns a page and doesn't reply."));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Dining Room you find a young man deep in thought, staring at the ceiling while tapping his pencil on the page of a leather-bound notebook. According to the notes the Officers Chaps gave you, this is Jake Dejesus, the victim's best friend.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Jake sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Oh, well,\" Jake says, \"I mean, I haven't quite finished my poem yet, and I wouldn't like to spoil the dramatic reveal for you, but I could read you what I have so far and...\"<p>\"Just the name, please.\"<p>\"It was Alyssa Hull,\" he says dourly."));
__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=1", "\"Do you know someone named Alyssa Hull?\" you ask.<p>\"Oh yes, yes indeed,\" Jake smiles. \"We're quite companionable. She's quite an attentive and astute listener. She's in the Game Room -- I'm positive that if you ask her, she'll tell you all about how she loves my work.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Library, and encounter a young man -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. According to the notes the Officers Chaps gave you, this is Edgar Hester, the victim's personal assistant.<p>He looks up at you, and his eyes widen with surprise. \"Ooh! You must be the police detective assigned to the case!\"<p>\"That's me,\" you say, showing your badge.<p>\"Great! I'm gonna be a real big help, you'll see!\"<p>\"As long as you stay in here while doing it,\" you say. \"Sorry, but I can't have you running around during the investigation.\"<p>\"Aw, that's okay,\" he says. \"I'll just sneak out while you aren't watching, dodge the guards, and come back before you've realized I'm gone!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Golly! You really want to know what I think, Detective?\" Edgar says, excitedly, and pulls out a notebook. \"Okay, so, first I measured some footprints out in the driveway, and...\" <p>\"Kid, we're short on time. Cut to the chase and tell me the details later, okay?\"<p>\"Oh, okay! It was Chloe Hyde!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=1", "\"What do you know about Chloe Hyde?\" you ask.<p>\"Yeah, I know who that is!\" Edgar says. \"That's the victim's gardener, and she's <i>real</i> suspicious! Did you know she's been married like <i>six</i> times? And two of her spouses died in mysterious circumstances!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "You enter the Game Room and meet a woman dressed in cheap knockoff versions of the latest rich peoples' fashions. A quick flip through your suspect dossier reveals this to be Chloe Hyde, the victim's dental hygienist.<p>\"Hey, what took ya so long?\" she asks. \"Hah, nah, just kiddin' with ya. I know you boys have got a tough job, always had a deep respect for the boys in blue. Anything you wanna know, just ask me -- Chloe Hyde. Nobody knows what's going down around this place like I do.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"All right, Detective, all right,\" Chloe grins. \"Ya dragged it out of me. The killer was Leah Snow. And I trust you'll remember how helpful I was to you, if we should ever cross paths again!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"The victim had a personal assistant, do you know them?\" you ask.<p>\"D'you mean Edgar Hester?\" Chloe asks. \"He's great, a real riot. You need someone to watch your back, that's who you need, is Edgar Hester.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Kitchen, you find a young man in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick his foot to wake him up. \"Uh?\" he says. \"Wha? Oh.\" He stands up, knuckling sleepy, bloodshot eyes. According to the notes the Officers Chaps gave you, this is Diego Terry, the victim's golf caddy.<p>\"So uh, what's up man?\" he asks. \"I mean, Officer.\"<p>\"Detective,\" you say, flashing your badge.<p>\"Right on, right on. So what's the skinny?\"<p>\"I need to ask you a few questions.\"<p>\"Okay, sure, yeah. Shoot.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Dang, dude!\" Diego says, \"I wondered when you were finally gonna get around to asking that! Like, jeez, right? Listen, it was totes Rachel's housekeeper. Like, for real.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=4&visit=1", "\"Have you met the victim's housekeeper?\" you ask.<p>\"You mean Eustace Short?\" Diego asks. \"Yeah I kinda know him, I guess. Like I know him well enough to say hey to. And then get the hell out of Dodge because dang, man, right?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Lounge, and find a young woman wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. She looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" she says, kneeling down to fish for it. \"I was totes on a roll.\" According to the notes the Officers Chaps gave you, this is Riley Burris, the victim's business partner.<p>\"So uh, what's up man?\" she asks. \"I mean, Officer.\"<p>\"Detective,\" you say, flashing your badge.<p>\"Right on, right on. So what's the skinny?\"<p>\"I need to ask you a few questions.\"<p>\"Okay, sure, yeah. Shoot.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "The only person in the Guest Bedroom is a hugely-muscled man, currently working out with a set of oversized freeweights. According to the notes the Officers Chaps gave you, this is Maury Vega, the victim's accountant.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Maury grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Beats me,\" he mutters. \"If they try and pull that murder stuff on me, though, I'll tie 'em in a knot like a fireplace poker!\"<p>\"...You can do that?\" you ask.<p>\"Yeah! Wanna see?\"<p>\"Yeah, kind of. But later.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Bathroom, you discover a young woman, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. Your dossier identifies her as Katherine Pollard, the victim's bodyguard.<p>\"What are you doing?\" you ask her. <p>\"Looking for clues! I'm pretty sure Mia Nieves was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" she says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Oh, it's definitely the chauffeur, Detective!\" Katherine says. \"I can't prove it, but if you send these hair and fingerprint samples to the police lab...\"<p>\"I'll just take your word for it, kid.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know Riley Burris?\" you ask.<p>\"Sure, I know who that is!\" she says. \"That's Mia Nieves's business partner. She has a pretty good motive for the murder, what with the life insurance and all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "In the Smoking Lounge you meet a young woman dressed in crisp tennis whites, relaxing and leafing idly through a fashion magazine, apparently without a care in the world. A quick flip through your suspect dossier reveals this to be Kayla Stephenson, the victim's personal assistant.<p>\"I'd love a spot of tea, if you've got one handy,\" she says, then looks up at you and practically jumps to her feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Jocelyn Spencer,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Who murdered Jocelyn?\" Kayla asks. \"Hmm. Well now. Was it Mitch Holt?\"<p>You flip through your dossier. \"Who the devil's that?\"<p>\"Made it up. Sorry, it was a shot in the dark.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "A dark-haired young man is sitting in the Dining Room, quietly reading a large hardcover book. He doesn't seem to be aware of your presence. Your dossier identifies him as Leonard Harding, the victim's ex-physician.<p>\"What are you reading?\" you ask, to break the silence. He silently gestures at the cover, which is jacketless and doesn't have the title printed on it. \"So... a book.\"<p>\"Mm-hmm,\" he replies."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>Leonard tilts his head to the side in thought for a moment. \"...Mick Chapman.\"<p>\"Okay,\" you say. \"And why do you say that?\"<p>Leonard turns a page and goes back to his reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"What do you know about Kayla Stephenson?\" you ask.<p>He scowls. \"The boss.\"<p>\"Anything else you can tell me?\"<p>\"Hmph.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "When you enter the Guest Bedroom, you encounter a young man wearing a beret and black turtleneck, chewing on the end of his pencil. Your dossier identifies him as Sam Nelson, the victim's golf caddy.<p>\"Excuse me,\" you say. \"I'm from the police, and I need to ask you a few questions.\"<p>\"Hmm,\" he says. \"Questions, questions. ...No, no, that won't do at all.\"<p>\"I beg your pardon?\"<p>\"There's no good rhyme for 'questions', it simply won't fit.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Well, in my poem I'm attributing the murder to a black shadow wrought from the ghosts of those murdered by capitalism,\" Sam says. \"Does that help?\"<p>\"Not... particularly.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "In the Basement you find a pale, drably-dressed man slouched on a small chair. He looks up at you as you enter, and sighs pathetically. \"You must be Mick Chapman, the victim's housekeeper,\" you say, flipping to the relevant page in the dossier.<p>\"Great, here we go,\" he says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think the killer is?\" you ask.<p>\"Who killed Jocelyn Spencer? You're asking me? Why not ask me something I know the answer to, like who's supposed to clean the toilets around here. The answer to that is not, in fact, me, but guess what? I end up having to do it anyway.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "As you enter the Bar, a small nervous-looking woman spins around with a startled look. According to the notes the Officers Chaps gave you, this is Julia Ortiz, the victim's chauffeur.<p>\"Who are you?!\" she exclaims. \"Don't come any closer or I'll call the cops!\"<p>\"I <i>am</i> the cops,\" you say, showing her your badge.<p>\"Oh thank god! Thank god you're here! I'm going to be next, I just know it, you have to protect me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Who did it?\" Julia asks incredulously. \"Don't you get it? Don't you <i>see?</i> They <i>all</i> did it! They're all in on it together!\"<p>\"In my experience, that's pretty unlikely,\" you say."));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You walk into the Billiard Room, and find a young woman wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. She looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" she says, kneeling down to fish for it. \"I was totes on a roll.\" A quick flip through your suspect dossier reveals this to be Emma Boyd, the victim's bodyguard.<p>\"Uh, hey,\" she says. \"Hi. Yeah. I'm Emma. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Oh yeah,\" Emma says, nodding. \"You wanna know who did it, dude? I know for sure who did it. It was Victoria Conner. No question.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=6", "\"Have you met the victim's personal assistant?\" you ask.<p>\"Oh, jeez,\" Emma says, rolling her eyes. \"Her. Lillian Owens. Phew, she's a real piece of work, dude. When she comes in the room, I'm, like, <i>gone</i>. Like 'No thank you,' right? Who needs that kind of drama?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "Inside the Laundry Room, you discover a young woman, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. Judging from the dossier the Officers Chaps gave you, this must be Victoria Conner, the victim's boss.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" she says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and her eyes widen when you show her your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" she pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Who do you think the killer is?\" you ask.<p>\"Oh, it's definitely the bodyguard, Detective!\" Victoria says. \"I can't prove it, but if you send these hair and fingerprint samples to the police lab...\"<p>\"I'll just take your word for it, kid.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=7", "\"Do you know Kayla Stephenson?\" you ask.<p>\"Yeah, I know who that is!\" Victoria says. \"That's the victim's ex-physician, and she's <i>real</i> suspicious! Did you know she's been married like <i>six</i> times? And two of her spouses died in mysterious circumstances!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=8", "The only person in the Servants' Quarters is an older woman in a tweed suit, slashing at a stack of papers with a red pen. \"You must be Camila Maxwell, the victim's child,\" you say, flipping to the relevant page in the dossier.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" she says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=8", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"The ex-physician.\"<p>\"What?\"<p>\"The killer was Jocelyn Spencer's ex-physician, Detective,\" Maxwell says. <p>\"Oh! I was expecting a wordier response.\"<p>\"I hope you will relish that feeling of surprise, for it is one of the few ways in which a person can prove she is alive.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=8", "\"Do you know Spencer's personal assistant?\" you ask.<p>\"Yes, that is Kayla Stephenson, Maxwell says. \"A fine woman, quite fearless and comfortable with the unknown. I regard these as remarkable qualities.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "In the Bathroom you meet a young woman dressed in crisp tennis whites, relaxing and leafing idly through a fashion magazine, apparently without a care in the world. Your dossier identifies her as Lillian Kinney, the victim's ex-bodyguard.<p>She looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking her proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"You want to know... who do I...?\" Lillian looks flummoxed. \"Sorry, old bean. I can certainly understand why you'd ascribe me a certain Sherlockian intelligence, but I haven't the first clue of who might have done that deed.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Foyer, and encounter a young man -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. Your dossier identifies him as Del Burt, the victim's golf caddy.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" he says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and his eyes widen when you show him your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" he pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Gosh, Detective!\" Del exclaims. \"I sure wish I knew! I've been looking all over for clues, but the bad guy really covered their tracks on this one!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Living Room you find a young woman deep in thought, staring at the ceiling while tapping her pencil on the page of a leather-bound notebook. \"You must be Audrey Cox, the victim's physician,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" she says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Hmm, well,\" Audrey muses, \"I suppose it does make for a more satisfying conclusion to my poem if you actually apprehend the criminal. Very well, it was Del Burt.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"I understand the victim had an ex-bodyguard,\" you say. \"Can you tell me anything about them?\"<p>\"Yes, Lillian Kinney and I get along rather well,\" Audrey says. \"She never seems to have time to hear my poems, but she always seems so saddened by the fact, I can't help but forgive her.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Wine Cellar, a distinctive smell assaults your sinuses. A young man wearing a tye-dyed t-shirt and a knitted beanie coughs in surprise, hurriedly stubs out his \"cigarette\" in a potted plant, and moves to open a window. Judging from the dossier the Officers Chaps gave you, this must be Alex Snow, the victim's best friend.<p>\"Uh, hey,\" he says. \"Hi. Yeah. I'm Alex. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Okay, well, uhh...\" Alex hesitates. \"...Like I don't wanna be a narc or whatever, so I don't wanna name names, you know dude? But okay, I will say you should check out Arianna's physician. Like for real, you know?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=6&visit=1", "\"I understand the victim had a physician,\" you say. \"Can you tell me anything about them?\"<p>\"Umm... oh, you mean Randy Herman? I dunno, like, we don't hang out a lot, right, but he's pretty cool. Real casual.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=7&visit=1", "\"Do you know Randy Herman?\" you ask.<p>\"Heck yeah, I know Randy Herman,\" he says. \"He's like, crazy cool. He's a real trip. He's in the Family Room, give him a high-five for me.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Billiard Room you meet a young man dressed in crisp tennis whites, relaxing and leafing idly through a fashion magazine, apparently without a care in the world. Judging from the dossier the Officers Chaps gave you, this must be Wade Hart, the victim's cousin.<p>\"I'd love a spot of tea, if you've got one handy,\" he says, then looks up at you and practically jumps to his feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Arianna Short,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"You want to know... who do I...?\" Wade looks flummoxed. \"Sorry, old bean. I can certainly understand why you'd ascribe me a certain Sherlockian intelligence, but I haven't the first clue of who might have done that deed.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "The only person in the Pantry is a hugely-muscled man, currently working out with a set of oversized freeweights. According to the dossier, this is Craig Travis, the victim's neighbor.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Craig grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Nah, sorry,\" he says. \"No idea. I was blastin' my delts at the time, so I didn't notice anything unusual.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "Inside the Bar you find a young woman deep in thought, staring at the ceiling while tapping her pencil on the page of a leather-bound notebook. According to the dossier, this is Sophia Newman, the victim's child.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Sophia sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Well, obviously, it was karmic debt for decades of selfish corporatism,\" Sophia says.<p>\"Do you have anything more concrete?\" you ask.<p>\"Oh, well, if you want to be <i>bourgeois</i> about it,\" she sniffs. \"It was her accountant.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=4", "\"Are you familiar with someone named Alex Snow?\" you ask.<p>\"He can be found in the Wine Cellar, Detective, and that is all I have to say about a person who thinks any poem longer than a limerick is 'boring as hell', endquote.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "The only person in the Game Room is an older woman in a tweed suit, slashing at a stack of papers with a red pen. Your dossier identifies her as Samantha Bryant, the victim's sibling.<p>\"Excuse me,\" you say. \"I'm with the police -- need to ask you a few questions. ...What are you doing?\"<p>\"Grading papers. Although Warner may have escaped her duties for the oblivion of death,\" she says in a clipped Bavarian accent, \"the rest of us still have jobs that require our attention.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"It is not difficult to see who in this house has the soul of a killer, Detective,\" Bryant says. \"The desperate eyes, the hunger, the growl of an animal. No human who would take a life can truly hide these things.\" <p>\"Great. Okay. So...?\"<p>\"Randy Bowman.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=2&visit=1", "\"Do you know Randy Bowman?\" you ask.<p>\"This is Leah Warner's ex-lawyer,\" Bryant says. \"He is very brave, and fearlessness is the primary requirement for a human being to control his own destiny.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Servants' Quarters, and encounter a young man -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. \"You must be Vincent Watts, the victim's sibling,\" you say, flipping to the relevant page in the dossier.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" he says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and his eyes widen when you show him your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" he pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Golly! You really want to know what I think, Detective?\" Vincent says, excitedly, and pulls out a notebook. \"Okay, so, first I measured some footprints out in the driveway, and...\" <p>\"Kid, we're short on time. Cut to the chase and tell me the details later, okay?\"<p>\"Oh, okay! It was Ed Holland!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=1", "\"Are you familiar with someone named Ed Holland?\" you ask.<p>\"He's the victim's bodyguard,\" Vincent says. \"He is pretty friendly. I haven't found anything to tie him to the scene of the crime yet.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Guest Bedroom and find an annoyed-looking young man slouched on a leather sofa with his motorcycle boots propped up on the expensive ebony coffee-table. He gives you a withering look and lights a cigarette. According to the notes the Officers Chaps gave you, this is Clancy Nash, the victim's lover.<p>\"I need to ask you some questions about the murder,\" you say.<p>\"I didn't kill anybody, but if I have to hang around this dump any longer, I might,\" he snarls. \"Hurry up and ask me whatever you're gonna ask, so I can get out of here!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"What, now you want me to do your damn job for you?\" he sneers. \"You're the big-time detective, you figure it out!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "As you enter the Family Room, a distinctive smell assaults your sinuses. A young man wearing a tye-dyed t-shirt and a knitted beanie coughs in surprise, hurriedly stubs out his \"cigarette\" in a potted plant, and moves to open a window. According to the dossier, this is Cletus Greer, the victim's sibling.<p>\"So uh, what's up man?\" he asks. \"I mean, Officer.\"<p>\"Detective,\" you say, flashing your badge.<p>\"Right on, right on. So what's the skinny?\"<p>\"I need to ask you a few questions.\"<p>\"Okay, sure, yeah. Shoot.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Dang, dude!\" Cletus says, \"I wondered when you were finally gonna get around to asking that! Like, jeez, right? Listen, it was totes Isabella's golf caddy. Like, for real.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"The victim's lover -- do you know them?\" you ask.<p>\"You mean Samantha Jacobson? Yeah dude! She's a riot! She's like, way cool. Real party animal, know what I mean?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Game Room, you discover a young man, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. A quick flip through your suspect dossier reveals this to be Nick Parsons, the victim's personal assistant.<p>\"What are you doing?\" you ask him. <p>\"Looking for clues! I'm pretty sure Isabella Cardenas was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" he says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Jeez, Detective!\" Nick pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "In the Foyer you find a pale, drably-dressed woman slouched on a small chair. She looks up at you as you enter, and sighs pathetically. According to the notes the Officers Chaps gave you, this is Maria Lee, the victim's golf caddy.<p>\"Might as well get it over with and put the cuffs on me now,\" she mutters, holding up her wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"I don't have any idea,\" she says, \"but I guarantee if you ask anyone else, they'll all say it was me. That's how it goes around here. I do all the work, and do I get any of the credit? No, don't bother answering, it's a rhetorical question and the answer is perfectly obvious anyway.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "When you enter the Boiler Room, you encounter a young woman wearing a beret and black turtleneck, chewing on the end of her pencil. \"You must be Sarah Mason, the victim's business partner,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" she says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Oh, well,\" Sarah says, \"I mean, I haven't quite finished my poem yet, and I wouldn't like to spoil the dramatic reveal for you, but I could read you what I have so far and...\"<p>\"Just the name, please.\"<p>\"It was Dennis Welch,\" she says dourly."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=5", "\"The victim's lover -- do you know them?\" you ask.<p>\"I'll have nothing to do with that savage in the Game Room,\" Sarah says. \"Not until they apologize for comparing my 'Opus XXVII' to Smash Mouth lyrics.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Billiard Room and encounter a well-to-do-looking young man dressed in crisp tennis whites, lounging casually across an overstuffed chair and flipping playing cards into a straw boater -- or rather, attempting to, and largely missing. Your dossier identifies him as Harry Wilson, the victim's butler.<p>He looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking his proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Haven't the foggiest, Detective,\" Harry says. \"Not the slightest idea. Not a tiddle, nor a jot. I could no more tell you the name of Isabella's murderer than I could tell you the--\" <p>\"I get it,\" you grumble."));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "You enter the Pantry and find an older man in a tweed suit, muttering to himself over a stack of papers. Judging from the dossier the Officers Chaps gave you, this must be Bill Mueller, the victim's housekeeper.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" he says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"This is not my field of knowledge or experience, Detective,\" Mueller says. \"Nor of interest. I will leave such matters to you and the other police.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=8", "As you enter the Attic, a wild-eyed woman accosts you, pointing with an outstretched and trembling finger. Your dossier identifies her as Samantha Jacobson, the victim's chauffeur.<p>\"Help!\" she yells. \"They've come for me! It's the murderer!\"<p>\"Settle down,\" you say. \"I'm a detective with the police. I'm investigating the case.\"<p>\"Well, so you <i>say</i>,\" she says, glaring at you with suspicion."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=8", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"I don't know,\" Samantha says suspiciously. \"I still don't entirely trust you.\"<p>\"Look,\" you say, \"if I was working for them, then I'd already know who did it, so it wouldn't matter if you told me.\"<p>\"...I guess you have a point. All right, it was Isabella's physician.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=8", "\"I understand the victim had a lover,\" you say. \"Can you tell me anything about them?\"<p>\"Pfft, Dennis Welch is just a dupe, a patsy!\" Samantha says. \"He doesn't know what's going on around here. Maybe that'll keep him safe, but I doubt it.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=9", "You enter the Bar, and discover an extremely muscular man lifting weights and glistening with sweat. \"You must be Dennis Welch, the victim's physician,\" you say, flipping to the relevant page in the dossier.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Isabella'd had a proper regimen like I told her.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Who killed Isabella?\" Dennis says. \"That's easy, it was her sibling.\" <p>\"How do you know?\" you ask. <p>Dennis flexes his muscles at you in several bodybuilder poses. You aren't sure how that relates to the question."));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Study, where a bored and angry-looking young man in motorcycle boots and a leather jacket is stomping around and ashing his cigarette on the expensive-looking Turkish carpet. According to the dossier, this is Chuck Bowers, the victim's golf caddy.<p>\"I've got some questions for you,\" you say.<p>\"Good! Great! Ask away!\" he mutters. \"Then maybe I can get out of this dive.\"<p>\"You got somewhere better to be?\"<p>\"If that's the kinda questions you're gonna ask, this is gonna be <i>real</i> fun,\" he says, rolling his eyes."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Well, I'll tell you this,\" Chuck says, \"if I was you -- and I'm friggin' glad I'm not, hah -- but if I was you I'd look into Gianna's lover.\"<p>\"How about a name?\" you ask.<p>\"How about up yours, cop?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=3&visit=1", "\"Can you tell me anything about Gianna Beck's lover?\" you ask.<p>\"Oh, <i>that</i> jerkoff. Go to the Lounge and see for yourself why I wouldn't give a wet fart.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Attic, and discover an extremely muscular woman lifting weights and glistening with sweat. According to the dossier, this is Elizabeth Massey, the victim's chauffeur.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Mackenzie'd had a proper regimen like I told her.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>Elizabeth shakes her head. \"No idea who it was. If they tried that on me, though, I'd tear them in half. Literally. I've been practicing on sides of beef.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "As you enter the Boiler Room, a wild-eyed man accosts you, pointing with an outstretched and trembling finger. A quick flip through your suspect dossier reveals this to be Edgar Faulkner, the victim's accountant.<p>\"Who are you?!\" he exclaims. \"Don't come any closer or I'll call the cops!\"<p>\"I <i>am</i> the cops,\" you say, showing him your badge.<p>\"Oh thank god! Thank god you're here! I'm going to be next, I just know it, you have to protect me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"I don't know,\" Edgar says suspiciously. \"I still don't entirely trust you.\"<p>\"Look,\" you say, \"if I was working for them, then I'd already know who did it, so it wouldn't matter if you told me.\"<p>\"...I guess you have a point. All right, it was Mackenzie's chauffeur.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"What can you tell me about the deceased's chauffeur?\" you ask.<p>\"I don't even know who that is!\" Edgar says. \"Oh, I know who they <i>claim</i> to be, but that person in the Attic isn't who they say they are, you mark my words!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Foyer, where a bored and angry-looking young woman in motorcycle boots and a leather jacket is stomping around and ashing her cigarette on the expensive-looking Turkish carpet. According to the notes the Officers Chaps gave you, this is Hannah Rhodes, the victim's boss.<p>\"I need to ask you some questions about the murder,\" you say.<p>\"I didn't kill anybody, but if I have to hang around this dump any longer, I might,\" she snarls. \"Hurry up and ask me whatever you're gonna ask, so I can get out of here!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"You want me to tell you who the killer is?\" Hannah asks. \"Okay. It was Ralph's child.\"<p>\"Do you have any evidence for that?\"<p>\"Yeah, sure. Right here in my pocket.\" She reaches into her jacket pocket, and pulls out her middle finger."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=1", "\"The victim had a child, do you know them?\" you ask.<p>\"Oh, <i>that</i> jerkoff. Go to the Laundry Room and see for yourself why I wouldn't give a wet fart.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Game Room, you find a large and powerfully-muscled woman doing arm-curls with a set of huge barbells. According to the notes the Officers Chaps gave you, this is Angelina Carpenter, the victim's gardener.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Angelina grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Oh ho!\" Angelina exclaims. \"If you're asking me, then you must recognize my power!\"<p>\"I... what?\"<p>\"It was Isabella Whitaker. As plain as these sick pecs!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Hannah Rhodes. What can you tell me about her?\" you ask.<p>\"Huh!\" Angelina snorts. \"Yeah, I know her. If you wanna meet the world's biggest wimp, just go to the Living Room.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "The only person in the Boiler Room is an older woman in a tweed suit, slashing at a stack of papers with a red pen. According to the dossier, this is Emma Ruiz, the victim's lawyer.<p>\"Excuse me,\" you say. \"I'm with the police -- need to ask you a few questions. ...What are you doing?\"<p>\"Grading papers. Although Weiss may have escaped his duties for the oblivion of death,\" she says in a clipped Bavarian accent, \"the rest of us still have jobs that require our attention.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"This is not my field of knowledge or experience, Detective,\" Ruiz says. \"Nor of interest. I will leave such matters to you and the other police.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "As you enter the Laundry Room, a wild-eyed man accosts you, pointing with an outstretched and trembling finger. Judging from the dossier the Officers Chaps gave you, this must be Dale Conway, the victim's ex-golf caddy.<p>\"Who are you?!\" he demands. \"Police,\" you reply. \"I need to ask you a few questions about--\"<p>\"And how do I know you're telling the truth? I should just take your word for it? You could be anybody!\"<p>With a sigh, you pull out your badge and show it to him. \"Happy?\"<p>\"And I'm supposed to just trust that that's real? Well... all right. For now. But I've got my eye on you!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Okay, I'll tell you, but I need police protection!\" Dale says. <p>\"You'll be fine,\" you say. \"Who was it?\"<p>Dale looks around, then whispers, \"It was Ralph's neighbor.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"The victim had a boss, do you know them?\" you ask.<p>\"I don't even know who that is!\" Dale says. \"Oh, I know who they <i>claim</i> to be, but that person in the Dining Room isn't who they say they are, you mark my words!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "Inside the Living Room, you find a young woman in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick her foot to wake her up. \"Uh?\" she says. \"Wha? Oh.\" She stands up, knuckling sleepy, bloodshot eyes. \"You must be Isabella Whitaker, the victim's best friend,\" you say, flipping to the relevant page in the dossier.<p>\"Uh, hey,\" she says. \"Hi. Yeah. I'm Isabella. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Basement and find a young man in a beret, pacing around and muttering to himself while scribbling in a leather-bound notebook. \"You must be Fritz Whitaker, the victim's neighbor,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say. \"I'm from the police, and I need to ask you a few questions.\"<p>\"Hmm,\" he says. \"Questions, questions. ...No, no, that won't do at all.\"<p>\"I beg your pardon?\"<p>\"There's no good rhyme for 'questions', it simply won't fit.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Well, in my poem I'm attributing the murder to a black shadow wrought from the ghosts of those murdered by capitalism,\" Fritz says. \"Does that help?\"<p>\"Not... particularly.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "Inside the Bar you find a woman pacing around and smoking a cigarette. As you enter, she turns and shoots you that particular grin that people use when they're extremely nervous, but are trying to play it cool. Judging from the dossier the Officers Chaps gave you, this must be Brooke Sullivan, the victim's sibling.<p>\"Good, good,\" she says. \"I'm glad you're here, Officer.\"<p>\"Detective.\"<p>\"Right! Right, of course, Detective, sorry. What a terrible thing that happened, just awful. But I'm sure you'll get to the bottom of it right away, yeah?\"<p>\"Hopefully, yes,\" you say. \"I'd like to ask you a few questions.\"<p>\"Sure, sure! Ask away, Detective, I've got nothin' to hide!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Well Detective, you know what they always say,\" she says with a twinkle in her eye. \"The boss did it!\"<p>\"...Is that what they always say?\"<p>\"Something like that, yeah. Pretty sure.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=7", "\"The victim's boss -- do you know them?\" you ask.<p>\"Hmm,\" Brooke muses. \"I think I know who you mean, Detective, but I dunno them real well. I think they're in the Foyer, though.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Sunroom, a small nervous-looking woman spins around with a startled look. \"You must be Aubrey Knox, the victim's lawyer,\" you say, flipping to the relevant page in the dossier.<p>\"Who are you?!\" she demands. \"Police,\" you reply. \"I need to ask you a few questions about--\"<p>\"And how do I know you're telling the truth? I should just take your word for it? You could be anybody!\"<p>With a sigh, you pull out your badge and show it to her. \"Happy?\"<p>\"And I'm supposed to just trust that that's real? Well... all right. For now. But I've got my eye on you!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"If I knew that, I wouldn't be out of my mind with fear!\" Aubrey exclaims. \"It could be any of them! <i>Any of them!!</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Boiler Room, where a dark-haired young man in glasses is sitting, deeply focused on a large hardback book; he doesn't look up as you come in. According to the notes the Officers Chaps gave you, this is Alistair Roach, the victim's child.<p>\"I'm from the police, and I'll need to ask you a few questions,\" you say.<p>\"Mm-hmm,\" comes the reply.<p>\"...You're the quiet type, I gather.\"<p>\"Mm-hmm.\"<p>\"Are all your answers going to be like this?\"<p>He turns the page without comment."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"It was the lawyer,\" Alistair mutters from behind his book.<p>\"Do you have some kind of evidence for that?\" you ask.<p>No response."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"Have you met the victim's lawyer?\" you ask.<p>\"Don't really know her. Name's Aubrey Knox.\"<p>\"Can you tell me anything at all about her?\"<p>\"She's awful.\"<p>\"...Anything else?\"<p>\"No.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Attic, you are greeted by an aristocratic-looking man dressed for a white-tie occasion. He looks you up and down, and doesn't appear to think much of what he sees. According to the dossier, this is Tucker Parsons, the victim's housekeeper.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask you a few questions.\" <p>\"I am already late for the French Ambassador's gala,\" he  says coldly. \"I trust this will not take long?\" <p>\"Depends on how quickly you answer.\"<p>He glares at you for a second, then rolls his eyes. \"Oh, very well. Ask.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"You wish to hear my opinion?\" he says. \"Well, that's very astute of you, Detective. In my view, it must have been Del Nichols. I've never encountered a more obvious criminal.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=1", "\"Do you know Del Nichols?\" you ask.<p>\"Del Nichols?\" he muses. \"I don't think I know anyone by that name... oh, are you referring to Gavin's dental hygienist? Ha ha, no, I do not associate with him.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "In the Bar, you find a dark-haired young man sitting quietly, reading a book. He glances briefly at you over the top of his glasses as you enter, but says nothing. Your dossier identifies him as Del Nichols, the victim's neighbor.<p>\"I'm from the police, and I'll need to ask you a few questions,\" you say.<p>\"Mm-hmm,\" comes the reply.<p>\"...You're the quiet type, I gather.\"<p>\"Mm-hmm.\"<p>\"Are all your answers going to be like this?\"<p>He turns the page without comment."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Investigate the physician,\" Del mutters quietly.<p>\"All right,\" you say. \"Can you tell me anything more concrete?\"<p>\"No.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"I understand the victim had a housekeeper,\" you say. \"Can you tell me anything about them?\"<p>\"Only know them a little. They're in the Laundry Room.\"<p>\"What do you think of them?\"<p>\"'S'alright.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Foyer, and find a man dressed in a shapeless gray suit, slouched on a chair and staring at his feet. Judging from the dossier the Officers Chaps gave you, this must be Todd Dyer, the victim's physician.<p>\"Might as well get it over with and put the cuffs on me now,\" he mutters, holding up his wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"I don't know who killed Gavin, but I do know they'd have saved me a lot of trouble if they'd killed me too. Guess they couldn't be bothered to waste the bullet or whatever.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Laundry Room you find a young man deep in thought, staring at the ceiling while tapping his pencil on the page of a leather-bound notebook. According to the dossier, this is Zachary Potter, the victim's golf caddy.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" he says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Unfortunately,\" Zachary grumbles, \"it was Gavin's sibling. I can't think of a single decent rhyme for sibling.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Are you familiar with a man named Tucker Parsons?\" you ask.<p>\"Gavin's housekeeper and I have a very cordial relationship,\" he says. \"He has essentially no understanding of the poetic form, poor soul, but he does the best he can.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Game Room, where a dark-haired young man in glasses is sitting, deeply focused on a large hardback book; he doesn't look up as you come in. Your dossier identifies him as Vincent Reese, the victim's sibling.<p>\"Excuse me,\" you say, \"I'm from the police, and I need to ask you some questions. ...Can you put the book down for a minute?\" He slowly drags his eyes away from the page and regard you impassively. \"Well, it's a start,\" you sigh."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Hmm.\" After a long pause, he mutters, \"Probably Sophie Patton.\"<p>\"Do you have any evidence to back that up?\"<p>He glances up at you, then turns a page and keeps reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=1", "\"Sophie Patton. What can you tell me about her?\" you ask.<p>Vincent frowns. \"Wish I didn't know her. Byron's ex-butler.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "A dark-haired young woman is sitting in the Guest Bedroom, quietly reading a large hardcover book. She doesn't seem to be aware of your presence. \"You must be Lucy Haney, the victim's golf caddy,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say, \"I'm from the police, and I need to ask you some questions. ...Can you put the book down for a minute?\" She slowly drags her eyes away from the page and regard you impassively. \"Well, it's a start,\" you sigh."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"It was the lawyer,\" Lucy mutters from behind her book.<p>\"Do you have some kind of evidence for that?\" you ask.<p>No response."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=7&visit=1", "\"Can you tell me anything about the victim's lawyer? you ask.<p>\"They're in the Bar.\"<p>\"And that's all you're going to say?\"<p>\"Mm-hmm.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Dining Room and encounter a well-to-do-looking young man dressed in crisp tennis whites, lounging casually across an overstuffed chair and flipping playing cards into a straw boater -- or rather, attempting to, and largely missing. According to the notes the Officers Chaps gave you, this is Byron Fox, the victim's sibling.<p>\"Excuse me,\" you say, and he looks up at you, surprised. <p>\"Oh, I say! You must be with the police! Jolly good! Frightful business, just dreadful. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"You want to know... who do I...?\" Byron looks flummoxed. \"Sorry, old bean. I can certainly understand why you'd ascribe me a certain Sherlockian intelligence, but I haven't the first clue of who might have done that deed.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "The only person in the Guest Bedroom is an older woman in a tweed suit, slashing at a stack of papers with a red pen. \"You must be Abigail Gates, the victim's personal assistant,\" you say, flipping to the relevant page in the dossier.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" she says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>\"This is not my field of knowledge or experience, Detective,\" Gates says. \"Nor of interest. I will leave such matters to you and the other police.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Living Room you find a man pacing around and smoking a cigarette. As you enter, he turns and shoots you that particular grin that people use when they're extremely nervous, but are trying to play it cool. A quick flip through your suspect dossier reveals this to be Byron Nichols, the victim's golf caddy.<p>\"Good, good,\" he says. \"I'm glad you're here, Officer.\"<p>\"Detective.\"<p>\"Right! Right, of course, Detective, sorry. What a terrible thing that happened, just awful. But I'm sure you'll get to the bottom of it right away, yeah?\"<p>\"Hopefully, yes,\" you say. \"I'd like to ask you a few questions.\"<p>\"Sure, sure! Ask away, Detective, I've got nothin' to hide!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think the killer is?\" you ask.<p>\"Well gee, Detective,\" Byron says, \"I hate to disappoint ya, but I haven't got a clue who could've done it. Far as I know, everyone in this house loved Bert like a brother. Or a sister, or whatever.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "You walk into the Pantry and meet a man dressed for an extremely expensive white-tie affair. He looks down his nose regally at you. \"You must be Garrett Norris, the victim's boss,\" you say, flipping to the relevant page in the dossier.<p>\"Sorry to disturb you,\" you say, \"but I'm investigating Bert Warren's death, and I need to ask you some questions.\"<p>\"I am an extremely busy man, Detective, and I have places to be this evening,\" he sniffs haughtily. <p>\"That's fine,\" you say. \"The sooner I get these questions answered, the sooner you can go.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Do you have any thoughts on who did it?\" you ask.<p>\"I believe the answer is quite obvious, Detective,\" Norris sneers. \"Who could it possibly have been except Stevie Rosales? A prime specimen of the criminal underclass.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"Do you know Warren's sibling?\" you ask.<p>\"No, I'm not familiar with that person,\" he says. \"I believe I've seen them in the mansion from time to time, however. Go look in the Library.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "A dark-haired young man is sitting in the Servants' Quarters, quietly reading a large hardcover book. He doesn't seem to be aware of your presence. According to the notes the Officers Chaps gave you, this is Stevie Rosales, the victim's college roommate.<p>\"I'm from the police, and I'll need to ask you a few questions,\" you say.<p>\"Mm-hmm,\" comes the reply.<p>\"...You're the quiet type, I gather.\"<p>\"Mm-hmm.\"<p>\"Are all your answers going to be like this?\"<p>He turns the page without comment."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Hmm.\" After a long pause, he mutters, \"Probably Abigail Gates.\"<p>\"Do you have any evidence to back that up?\"<p>He glances up at you, then turns a page and keeps reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=5", "\"Can you tell me anything about the victim's sibling? you ask.<p>Stevie nods. \"Rachel Strong.\"<p>\"Can you tell me anything about her?\"<p>Shrug. \"Seemed reasonable enough.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Library, and discover an extremely muscular woman lifting weights and glistening with sweat. \"You must be Lucy Gillespie, the victim's chauffeur,\" you say, flipping to the relevant page in the dossier.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" she replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Beats me,\" she mutters. \"If they try and pull that murder stuff on me, though, I'll tie 'em in a knot like a fireplace poker!\"<p>\"...You can do that?\" you ask.<p>\"Yeah! Wanna see?\"<p>\"Yeah, kind of. But later.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "You enter the Basement, where a young woman wearing a leather jacket and motorcycle boots is casually whittling her initials into the surface of a mahogany end-table. She glances at you, finishes her task, and puts her penknife away. \"You must be Elizabeth Rutledge, the victim's physician,\" you say, flipping to the relevant page in the dossier.<p>\"I've got some questions for you,\" you say.<p>\"Good! Great! Ask away!\" she mutters. \"Then maybe I can get out of this dive.\"<p>\"You got somewhere better to be?\"<p>\"If that's the kinda questions you're gonna ask, this is gonna be <i>real</i> fun,\" she says, rolling her eyes."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Cuttin' right to the chase, huh?\" Elizabeth says. \"Well, since you ask so friggin' nice and all -- it was Jonas Holt. Whaddya think of that?\" <p>You write the name down without replying."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=7", "\"Do you know Byron Fox?\" you ask.<p>\"I can tell you that piece of crap is stinking up the Dining Room. You want any more than that, go ask him for yourself.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Basement, and find a young man wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. He looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" he says, kneeling down to fish for it. \"I was totes on a roll.\" According to the dossier, this is Ralph Meyers, the victim's bodyguard.<p>\"Uh, hey,\" he says. \"Hi. Yeah. I'm Ralph. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "As you enter the Bathroom, you are greeted by an aristocratic-looking woman dressed for a white-tie occasion. She looks you up and down, and doesn't appear to think much of what she sees. Your dossier identifies her as Jessica Thornton, the victim's business partner.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" she says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Detective,\" Thornton says with a glare, \"if you cannot be bothered to do your own job, I most certainly am not going to do it for you.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Billiard Room and find a young man in a beret, pacing around and muttering to himself while scribbling in a leather-bound notebook. According to the notes the Officers Chaps gave you, this is Barney Gutierrez, the victim's best friend.<p>\"Excuse me,\" you say. \"I'm from the police, and I need to ask you a few questions.\"<p>\"Hmm,\" he says. \"Questions, questions. ...No, no, that won't do at all.\"<p>\"I beg your pardon?\"<p>\"There's no good rhyme for 'questions', it simply won't fit.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Oh, well,\" Barney says, \"I mean, I haven't quite finished my poem yet, and I wouldn't like to spoil the dramatic reveal for you, but I could read you what I have so far and...\"<p>\"Just the name, please.\"<p>\"It was Ralph Meyers,\" he says dourly."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"What do you know about Ralph Meyers?\" you ask.<p>\"Sorry, Detective,\" Barney says, shaking his head. \"I refuse to speak to -- or of -- that savage. You'll find him in the Basement, if you wish to see what the modern educational system does to a person.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Sunroom and find a young woman in a beret, pacing around and muttering to herself while scribbling in a leather-bound notebook. According to the notes the Officers Chaps gave you, this is Alyssa Guerrero, the victim's chauffeur.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Alyssa sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Who killed Conway?\" Alyssa asks. \"Why, I haven't the faintest idea. I was rather hoping you could tell me, or else I won't be able to give my poem a proper ending.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Billiard Room, you find a large and powerfully-muscled man doing arm-curls with a set of huge barbells. According to the dossier, this is Charlie Collier, the victim's housekeeper.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Charlie grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Beats me,\" he mutters. \"If they try and pull that murder stuff on me, though, I'll tie 'em in a knot like a fireplace poker!\"<p>\"...You can do that?\" you ask.<p>\"Yeah! Wanna see?\"<p>\"Yeah, kind of. But later.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Guest Bedroom you find a gray-haired woman reading through a stack of papers, scowling at them with faint disgust. Judging from the dossier the Officers Chaps gave you, this must be Katherine Buckner, the victim's cousin.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" she says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"I respect that the matter is of interest to you, Detective,\" Buckner says, \"because it is only through the interest of people such as yourself that our society can withstand the forces of chaos for the brief time that we inhabit this universe. However, I do not share your interest.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "Inside the Kitchen, you discover a young woman, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. Your dossier identifies her as Rachel Hicks, the victim's golf caddy.<p>\"What are you doing?\" you ask her. <p>\"Looking for clues! I'm pretty sure Conway York was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" she says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Do you have any thoughts on who did it?\" you ask.<p>\"It's just gotta be Simon Poole, Detective,\" Rachel says excitedly. \"Means, motive, and opportunity -- just like the Junior Detective's Handbook says!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=4", "\"Do you know someone named Alyssa Guerrero?\" you ask.<p>\"She's the victim's chauffeur,\" Rachel says. \"She is pretty friendly. I haven't found anything to tie her to the scene of the crime yet.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Game Room, which appears to be empty -- until a nervous face appears from behind the sofa. A quick flip through your suspect dossier reveals this to be Gabrielle Lucas, the victim's ex-sibling.<p>\"Who are you?!\" she exclaims. \"Don't come any closer or I'll call the cops!\"<p>\"I <i>am</i> the cops,\" you say, showing her your badge.<p>\"Oh thank god! Thank god you're here! I'm going to be next, I just know it, you have to protect me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>Gabrielle looks around the room, and picks up a piece of paper and a pen. She writes the name \"Serenity Hardin\", shows it to you, then stuffs it in her mouth and swallows it."));
__core_text_test_data.listAppend(listMake("wham.php?ask=7&visit=1", "\"Serenity Hardin. What can you tell me about her?\" you ask.<p>\"Stephen's accountant?\" Gabrielle says. \"Oh no, no no no. I don't trust that woman one tiny bit. For all I know, that's a lizard underneath that human skin.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "When you enter the Study, you encounter a young woman wearing a beret and black turtleneck, chewing on the end of her pencil. Judging from the dossier the Officers Chaps gave you, this must be Lucy Miller, the victim's chauffeur.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" she says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Who killed Stephen?\" Lucy asks. \"Why, I haven't the faintest idea. I was rather hoping you could tell me, or else I won't be able to give my poem a proper ending.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You knock on the Game Room door and open it slowly so as to not startle the victim's ex-sibling, Gabrielle Lucas. She's hiding underneath a table. \"Good grief,\" you mutter. \"Come out of there, it's just me.\"<p>\"What do you want?\" comes the frantic reply.<p>\"I just need to ask you some more questions.\"<p>\"Well, I don't see why I would have to come out there for that to happen.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=2&visit=1", "\"Do you know Cochran's chauffeur?\" you ask.<p>\"No! No, never!\" Gabrielle says, alarmed. \"He's one of them! His name's Joe Colon, he's always watching me! Watching and waiting!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Servants' Quarters, where a dark-haired young man in glasses is sitting, deeply focused on a large hardback book; he doesn't look up as you come in. \"You must be Dan Olson, the victim's golf caddy,\" you say, flipping to the relevant page in the dossier.<p>\"What are you reading?\" you ask, to break the silence. He silently gestures at the cover, which is jacketless and doesn't have the title printed on it. \"So... a book.\"<p>\"Mm-hmm,\" he replies."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"No idea,\" he says, turning a page in his book."));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "Inside the Basement, you discover a young woman, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. \"You must be Maya Cox, the victim's neighbor,\" you say, flipping to the relevant page in the dossier.<p>\"What are you doing?\" you ask her. <p>\"Looking for clues! I'm pretty sure Stephen Cochran was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" she says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Jeez, Detective!\" Maya pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Dining Room, and discover an extremely muscular woman lifting weights and glistening with sweat. According to the dossier, this is Caroline Noel, the victim's lover.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Stephen'd had a proper regimen like I told him.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think the killer is?\" you ask.<p>\"Oh ho!\" Caroline exclaims. \"If you're asking me, then you must recognize my power!\"<p>\"I... what?\"<p>\"It was Rachel Snider. As plain as these sick pecs!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=5", "\"Are you familiar with a woman named Gabrielle Lucas?\" you ask.<p>\"Huh!\" Caroline grunts. \"That's Stephen's gardener -- a skinny little sneak. I trust her about as far as I can throw her... er... I guess that's pretty far actually.\" Her forehead creases as she considers this. \"As far as I could <i>not</i> throw her?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Bar and encounter a woman dressed in very expensive-looking formal attire. She regards you with a look of distaste and disdain. A quick flip through your suspect dossier reveals this to be Rachel Snider, the victim's physician.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" she says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"You're asking <i>me</i>, Detective?\" she exclaims. \"If I knew that, this ridiculous little mishap would have been handled already!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "When you enter the Lounge, you find a young woman dressed in crisp tennis whites, idly bouncing a tennis ball on a racket and whistling a jaunty little tune. According to the notes the Officers Chaps gave you, this is Serenity Hardin, the victim's college roommate.<p>She looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking her proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"You want to know who I think did it?\" Serenity says, looking surprised. \"Well, that's a rum go. I hadn't even considered the question. I suppose it must've been Caroline Noel, though, mustn't it? Stands to reason.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=7", "\"Can you tell me anything about Stephen Cochran's ex-sibling?\" you ask.<p>\"Oh yes! Yes, quite well,\" Serenity says. \"What was the name... hmm... Began with an S, I believe. Or an R? ...No, it's no good, I'm afraid, old chap. You'll have to go to the Game Room and ask for yourself.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Bar, you find a young man in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick his foot to wake him up. \"Uh?\" he says. \"Wha? Oh.\" He stands up, knuckling sleepy, bloodshot eyes. According to the notes the Officers Chaps gave you, this is Leo Franklin, the victim's college roommate.<p>\"So uh, what's up man?\" he asks. \"I mean, Officer.\"<p>\"Detective,\" you say, flashing your badge.<p>\"Right on, right on. So what's the skinny?\"<p>\"I need to ask you a few questions.\"<p>\"Okay, sure, yeah. Shoot.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Aw jeez, man. I can't be havin' people think I'm the sorta dude who talks to cops, you know? But, okay, it was Douglas Holder. Just, like, keep it on the down-low, right?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=3&visit=1", "\"Do you know someone named Douglas Holder?\" you ask.<p>\"Oh yeah, man!\" Leo says. \"He's cool, he's a real bro. He's, like, Bert's housekeeper and stuff. We don't get to hang out much, but he's fun.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Game Room and find a young man in a beret, pacing around and muttering to himself while scribbling in a leather-bound notebook. A quick flip through your suspect dossier reveals this to be Douglas Holder, the victim's child.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" he says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Oh, well,\" Douglas says, \"I mean, I haven't quite finished my poem yet, and I wouldn't like to spoil the dramatic reveal for you, but I could read you what I have so far and...\"<p>\"Just the name, please.\"<p>\"It was Buck Farrell,\" he says dourly."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"What can you tell me about Leo Franklin?\" you ask.<p>\"We get along famously!\" Douglas says. \"In fact, he once told me his favorite poem was one of mine.\"<p>\"Is it your shortest one?\"<p>\"Why yes, how did you know? It's called--\"<p>\"I'll have him tell me about it himself.\"<p>\"Very well! He's in the Bar.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Attic and find an annoyed-looking young man slouched on a leather sofa with his motorcycle boots propped up on the expensive ebony coffee-table. He gives you a withering look and lights a cigarette. Judging from the dossier the Officers Chaps gave you, this must be Elmer Colon, the victim's golf caddy.<p>\"God, finally,\" he growls. \"Hurry up and ask me some effin' questions so I can get out of this place!\"<p>\"You in a hurry or something?\" you ask, tapping your pencil on your notepad.<p>\"Look, cop, I got a life. I got stuff to be doing other than standing around this craphole.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Study you meet a young man dressed in crisp tennis whites, relaxing and leafing idly through a fashion magazine, apparently without a care in the world. According to the dossier, this is James Stanley, the victim's lawyer.<p>\"Excuse me,\" you say, and he looks up at you, surprised. <p>\"Oh, I say! You must be with the police! Jolly good! Frightful business, just dreadful. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Well now, I'm not sure it would be right to be a squealer, Detective,\" James says. \"Not quite cricket, you know. ...Then again, neither is murder, what? Very well, you've forced my hand. It was Emily Salas.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"Have you met the victim's golf caddy?\" you ask.<p>\"Oh yes! Yes, quite well,\" James says. \"What was the name... hmm... Began with an S, I believe. Or an R? ...No, it's no good, I'm afraid, old chap. You'll have to go to the Dining Room and ask for yourself.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Ballroom, you discover a young man, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. Judging from the dossier the Officers Chaps gave you, this must be Byron Walters, the victim's accountant.<p>He looks up at you, and his eyes widen with surprise. \"Ooh! You must be the police detective assigned to the case!\"<p>\"That's me,\" you say, showing your badge.<p>\"Great! I'm gonna be a real big help, you'll see!\"<p>\"As long as you stay in here while doing it,\" you say. \"Sorry, but I can't have you running around during the investigation.\"<p>\"Aw, that's okay,\" he says. \"I'll just sneak out while you aren't watching, dodge the guards, and come back before you've realized I'm gone!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think the killer is?\" you ask.<p>\"Golly! You really want to know what I think, Detective?\" Byron says, excitedly, and pulls out a notebook. \"Okay, so, first I measured some footprints out in the driveway, and...\" <p>\"Kid, we're short on time. Cut to the chase and tell me the details later, okay?\"<p>\"Oh, okay! It was Willie Mathis!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know someone by the name of Elmer Colon?\" you ask.<p>\"I sure do!\" Byron says. \"He's in the Attic. I don't think he did it, but it's dangerous to make assumptions before you have all the facts. That's like the first rule of detectiveing!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "When you enter the Sunroom, you find a young man dressed in crisp tennis whites, idly bouncing a tennis ball on a racket and whistling a jaunty little tune. A quick flip through your suspect dossier reveals this to be Alistair Marquez, the victim's neighbor.<p>He looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking his proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"It was Sophie's ex-ex-lawyer, Detective,\" Alistair says. \"And that's the honest truth, not a fib to get out of an unpleasant betrothal arrangement, I assure you.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=1", "\"Can you tell me anything about Sophie Hamilton's ex-ex-lawyer?\" you ask.<p>\"That's Lily Hurley, isn't it?\" Alistair asks. \"Don't know her well, Detective, but she seems quite respectable. Stable sort, plenty of atoms up in the old thinkpiece.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=8", "As you enter the Bathroom, a distinctive smell assaults your sinuses. A young man wearing a tye-dyed t-shirt and a knitted beanie coughs in surprise, hurriedly stubs out his \"cigarette\" in a potted plant, and moves to open a window. \"You must be Leroy Turner, the victim's ex-ex-lawyer,\" you say, flipping to the relevant page in the dossier.<p>\"Uh, hey,\" he says. \"Hi. Yeah. I'm Leroy. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=8", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Dang, dude, like, you're the detective, right? I dunno from this whole murder thing, I'm just mindin' my own.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "As you enter the Breakfast Nook, a woman in a drab gray suit looks up at you from the chair she's slouched in, and sighs. According to the notes the Officers Chaps gave you, this is Hannah Osborn, the victim's child.<p>\"Great, here we go,\" she says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"You want to know who I think killed Sophie?\" Hannah asks. \"Yeah, sure. Why not? I might as well tell you, what do I care anyway? It was Alistair Marquez. Take 'em away, it's one less person I'll have to clean up after in this place.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Alistair Marquez. What can you tell me about him?\" you ask.<p>\"I don't know much,\" she replies. \"He avoids me like the plague. Like the world's most boring plague. 'World's Most Boring Plague,' I wouldn't be surprised if that was his nickname for me. He's probably in the Sunroom. That's where I'd be, if I was here and I wanted to avoid me.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Family Room, a distinctive smell assaults your sinuses. A young man wearing a tye-dyed t-shirt and a knitted beanie coughs in surprise, hurriedly stubs out his \"cigarette\" in a potted plant, and moves to open a window. Your dossier identifies him as Emil Snider, the victim's best friend.<p>You show him your badge. \"I'm investigating the murder of Avery Perez, and I need to ask you some questions.<p>\"Sure, right on,\" he says. \"Ask away, man. Rock it.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Library you find a gray-haired woman reading through a stack of papers, scowling at them with faint disgust. \"You must be Amelia Richards, the victim's boss,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" she says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"I respect that the matter is of interest to you, Detective,\" Richards says, \"because it is only through the interest of people such as yourself that our society can withstand the forces of chaos for the brief time that we inhabit this universe. However, I do not share your interest.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Bathroom, where a young woman wearing a leather jacket and motorcycle boots is casually whittling her initials into the surface of a mahogany end-table. She glances at you, finishes her task, and puts her penknife away. A quick flip through your suspect dossier reveals this to be Andrea Burris, the victim's cousin.<p>\"I need to ask you some questions about the murder,\" you say.<p>\"I didn't kill anybody, but if I have to hang around this dump any longer, I might,\" she snarls. \"Hurry up and ask me whatever you're gonna ask, so I can get out of here!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think the killer is?\" you ask.<p>\"Well, I'll tell you this,\" Andrea says, \"if I was you -- and I'm friggin' glad I'm not, hah -- but if I was you I'd look into Avery's gardener.\"<p>\"How about a name?\" you ask.<p>\"How about up yours, cop?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"What can you tell me about the deceased's best friend?\" you ask.<p>\"Yeah, I know her, that's Gianna Ochoa. She's pretty cool.\"<p>\"...And?\" you ask.<p>\"And that's all I'm gonna say to a cop, cop!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "You enter the Basement and find a young woman in a beret, pacing around and muttering to herself while scribbling in a leather-bound notebook. Judging from the dossier the Officers Chaps gave you, this must be Stella Morgan, the victim's gardener.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Stella sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Well, in my poem I'm attributing the murder to a black shadow wrought from the ghosts of those murdered by capitalism,\" Stella says. \"Does that help?\"<p>\"Not... particularly.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "The only person in the Ballroom is a hugely-muscled man, currently working out with a set of oversized freeweights. A quick flip through your suspect dossier reveals this to be Earl Vaughan, the victim's chauffeur.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Avery'd had a proper regimen like I told her.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Nah, sorry,\" he says. \"No idea. I was blastin' my delts at the time, so I didn't notice anything unusual.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Dining Room and meet a man dressed in cheap knockoff versions of the latest rich peoples' fashions. Your dossier identifies him as Gavin Smith, the victim's personal assistant.<p>\"Boy, am I glad to see you!\" he says. \"I just can't believe someone would do this to dear old Avery. Listen, if there's anything I can do to help, anything at all, you just let me know.\"<p>\"Well,\" you say, \"I would like to ask you some questions.\"<p>\"Questions? Oh, er, right! Yeah, sure, ask away! Always happy to cooperate with the police, that's me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Ahh, well now, I'm afraid I can't help ya there, Detective,\" Gavin says. \"I was all the way on the other side of the house when it happened, and I didn't hear a thing. Sorry.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "In the Guest Bedroom, you find a dark-haired young man sitting quietly, reading a book. He glances briefly at you over the top of his glasses as you enter, but says nothing. A quick flip through your suspect dossier reveals this to be Perry Stephens, the victim's accountant.<p>\"I'm from the police, and I'll need to ask you a few questions,\" you say.<p>\"Mm-hmm,\" comes the reply.<p>\"...You're the quiet type, I gather.\"<p>\"Mm-hmm.\"<p>\"Are all your answers going to be like this?\"<p>He turns the page without comment."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>Perry tilts his head to the side in thought for a moment. \"...Earl Vaughan.\"<p>\"Okay,\" you say. \"And why do you say that?\"<p>Perry turns a page and goes back to his reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=7", "\"Do you know someone by the name of Emil Snider?\" you ask.<p>Perry shakes his head. \"Don't know him well. He's in the Family Room, I think.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Library you find a young man deep in thought, staring at the ceiling while tapping his pencil on the page of a leather-bound notebook. Judging from the dossier the Officers Chaps gave you, this must be Chuck Wilcox, the victim's business partner.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Chuck sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Unfortunately,\" Chuck grumbles, \"it was Stan's housekeeper. I can't think of a single decent rhyme for housekeeper.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=5&visit=1", "\"The victim had a housekeeper, do you know them?\" you ask.<p>\"I see so little of them,\" he says, \"that I would almost suspect they were avoiding me deliberately! But I believe you'll find them in the Master Bedroom at the moment.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Study, and encounter a young man -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. According to the dossier, this is Steve Hayden, the victim's chauffeur.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" he says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and his eyes widen when you show him your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" he pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Jeez, Detective!\" Steve pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You walk into the Family Room and meet a man dressed for an extremely expensive white-tie affair. He looks down his nose regally at you. \"You must be Gunther Jackson, the victim's boss,\" you say, flipping to the relevant page in the dossier.<p>\"Sorry to disturb you,\" you say, \"but I'm investigating Stan Barnett's death, and I need to ask you some questions.\"<p>\"I am an extremely busy man, Detective, and I have places to be this evening,\" he sniffs haughtily. <p>\"That's fine,\" you say. \"The sooner I get these questions answered, the sooner you can go.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "In the Dining Room, you find a dark-haired young woman sitting quietly, reading a book. She glances briefly at you over the top of her glasses as you enter, but says nothing. According to the notes the Officers Chaps gave you, this is Leah Frazier, the victim's lover.<p>\"What are you reading?\" you ask, to break the silence. She silently gestures at the cover, which is jacketless and doesn't have the title printed on it. \"So... a book.\"<p>\"Mm-hmm,\" she replies."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>She looks up at you, and thinks for a second. \"Hmm...\"<p>\"Yes?\"<p>\"...probably Roy Pena.\"<p>\"And why do you say that?\"<p>Shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"I understand the victim had a business partner,\" you say. \"Can you tell me anything about them?\"<p>\"They're in the Billiard Room.\"<p>\"And that's all you're going to say?\"<p>\"Mm-hmm.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Basement, and find a woman dressed in a shapeless gray suit, slouched on a chair and staring at her feet. According to the notes the Officers Chaps gave you, this is Allison Sampson, the victim's housekeeper.<p>\"It's just one more thing after another, isn't it?\" she mutters bitterly. \"It always rains, and it always pours.\"<p>\"Well, I can see <i>you're</i> going to be a real barrel of laughs,\" you say."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Oh, is that all you want to know?\" Allison asks. \"All right. It was Leah Frazier. Go ahead and make a big show about how you solved the case all by yourself with your big detective skills, I don't expect to receive any credit for the information.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=5", "\"What do you know about Chuck Wilcox?\" you ask.<p>\"Yeah, I know Chuck Wilcox,\" she replies. \"I bet he'll tell you he doesn't know me, though. Probably considers me beneath his notice. Go on and ask him, you'll see. He's in the Library.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Attic, and find a young man wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. He looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" he says, kneeling down to fish for it. \"I was totes on a roll.\" According to the notes the Officers Chaps gave you, this is Nick Koch, the victim's lover.<p>\"Uh, hey,\" he says. \"Hi. Yeah. I'm Nick. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Servants' Quarters and encounter a well-to-do-looking young man dressed in crisp tennis whites, lounging casually across an overstuffed chair and flipping playing cards into a straw boater -- or rather, attempting to, and largely missing. \"You must be Shane Dyer, the victim's best friend,\" you say, flipping to the relevant page in the dossier.<p>\"I'd love a spot of tea, if you've got one handy,\" he says, then looks up at you and practically jumps to his feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Terry West,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Haven't the foggiest, Detective,\" Shane says. \"Not the slightest idea. Not a tiddle, nor a jot. I could no more tell you the name of Terry's murderer than I could tell you the--\" <p>\"I get it,\" you grumble."));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Dining Room, and find a woman dressed in a shapeless gray suit, slouched on a chair and staring at her feet. Judging from the dossier the Officers Chaps gave you, this must be Maria McBride, the victim's child.<p>\"Might as well get it over with and put the cuffs on me now,\" she mutters, holding up her wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Well,\" Maria says, \"if I tell you, what's in it for me?\"<p>\"Nothing.\"<p>\"Oh good, my standard compensation. Okay, it was Terry's chauffeur.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Have you met the victim's lover?\" you ask.<p>\"That's Shane Dyer,\" she replies. \"I had an entire conversation with him once. Not a long one. And I was doing most of the talking. But still, I guess that counts for a little something.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "Inside the Family Room you find a man pacing around and smoking a cigarette. As you enter, he turns and shoots you that particular grin that people use when they're extremely nervous, but are trying to play it cool. According to the dossier, this is Dave Cantrell, the victim's chauffeur.<p>\"Boy, am I glad to see you!\" he says. \"I just can't believe someone would do this to dear old Terry. Listen, if there's anything I can do to help, anything at all, you just let me know.\"<p>\"Well,\" you say, \"I would like to ask you some questions.\"<p>\"Questions? Oh, er, right! Yeah, sure, ask away! Always happy to cooperate with the police, that's me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Well gee, Detective,\" Dave says, \"I hate to disappoint ya, but I haven't got a clue who could've done it. Far as I know, everyone in this house loved Terry like a brother. Or a sister, or whatever.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Sunroom, and encounter a young woman -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. \"You must be Jasmine Guerrero, the victim's neighbor,\" you say, flipping to the relevant page in the dossier.<p>She looks up at you, and her eyes widen with surprise. \"Ooh! You must be the police detective assigned to the case!\"<p>\"That's me,\" you say, showing your badge.<p>\"Great! I'm gonna be a real big help, you'll see!\"<p>\"As long as you stay in here while doing it,\" you say. \"Sorry, but I can't have you running around during the investigation.\"<p>\"Aw, that's okay,\" she says. \"I'll just sneak out while you aren't watching, dodge the guards, and come back before you've realized I'm gone!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Oh, it's definitely the lover, Detective!\" Jasmine says. \"I can't prove it, but if you send these hair and fingerprint samples to the police lab...\"<p>\"I'll just take your word for it, kid.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=5", "\"Nick Koch. What can you tell me about him?\" you ask.<p>\"Oh sure, Detective! Nick Koch's great fun!\" Jasmine says. \"He's in the Attic right now. He'll probably share his chewing gum with you, if you ask!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Lounge and find an older woman in a tweed suit, muttering to herself over a stack of papers. According to the notes the Officers Chaps gave you, this is Naomi Howard, the victim's physician.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" she says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"It was Johnny Alston, Detective,\" Howard says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=1", "\"Are you familiar with a man named Johnny Alston?\" you ask.<p>\"He is in the Wine Cellar,\" Howard says. \"We are cordial with one another, but speak little. It is refreshing to know someone who does not insist on small talk at every encounter.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Bathroom, where a young woman wearing a leather jacket and motorcycle boots is casually whittling her initials into the surface of a mahogany end-table. She glances at you, finishes her task, and puts her penknife away. \"You must be Riley Garner, the victim's butler,\" you say, flipping to the relevant page in the dossier.<p>\"I've got some questions for you,\" you say.<p>\"Good! Great! Ask away!\" she mutters. \"Then maybe I can get out of this dive.\"<p>\"You got somewhere better to be?\"<p>\"If that's the kinda questions you're gonna ask, this is gonna be <i>real</i> fun,\" she says, rolling her eyes."));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Boiler Room you find a man pacing around and smoking a cigarette. As you enter, he turns and shoots you that particular grin that people use when they're extremely nervous, but are trying to play it cool. According to the notes the Officers Chaps gave you, this is Gustav Glenn, the victim's golf caddy.<p>\"Good, good,\" he says. \"I'm glad you're here, Officer.\"<p>\"Detective.\"<p>\"Right! Right, of course, Detective, sorry. What a terrible thing that happened, just awful. But I'm sure you'll get to the bottom of it right away, yeah?\"<p>\"Hopefully, yes,\" you say. \"I'd like to ask you a few questions.\"<p>\"Sure, sure! Ask away, Detective, I've got nothin' to hide!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Nah, 'fraid I can't help ya there, Detective,\" Gustav says. \"I mean, I <i>know</i>, and I'll absolutely tell ya anything <i>else</i> ya wanna know, but my rep'll take a real dive if people think I'm a rat, you know what I'm sayin'?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "In the Living Room you find a pale, drably-dressed woman slouched on a small chair. She looks up at you as you enter, and sighs pathetically. According to the notes the Officers Chaps gave you, this is Kimberly Ball, the victim's lover.<p>\"Might as well get it over with and put the cuffs on me now,\" she mutters, holding up her wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think the killer is?\" you ask.<p>\"You want to know who I think killed Niles?\" Kimberly asks. \"Yeah, sure. Why not? I might as well tell you, what do I care anyway? It was Johnny Alston. Take 'em away, it's one less person I'll have to clean up after in this place.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"Do you know Hopper's physician?\" you ask.<p>\"Physician...\" Kimberly mutters. \"...Oh, you mean Riley Garner. Sure, I know her. I mean, as well as I know anybody, which isn't very well, but she says hello to me sometimes, and that's more than I get from most people.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You walk into the Servants' Quarters, and find a young man wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. He looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" he says, kneeling down to fish for it. \"I was totes on a roll.\" According to the notes the Officers Chaps gave you, this is Jonas Fulton, the victim's dental hygienist.<p>\"Uh, hey,\" he says. \"Hi. Yeah. I'm Jonas. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Jeez, man, you got me. ...Ha ha, no wait, that sounded bad. I mean, like, you got me, not you got me, right? Like, I dunno who did it.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Wine Cellar, where a dark-haired young man in glasses is sitting, deeply focused on a large hardback book; he doesn't look up as you come in. Your dossier identifies him as Marlon Bass, the victim's sibling.<p>\"What are you reading?\" you ask, to break the silence. He silently gestures at the cover, which is jacketless and doesn't have the title printed on it. \"So... a book.\"<p>\"Mm-hmm,\" he replies."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Who do you think the killer is?\" you ask.<p>Marlon tilts his head to the side in thought for a moment. \"...Jacky Turner.\"<p>\"Okay,\" you say. \"And why do you say that?\"<p>Marlon turns a page and goes back to his reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=6", "\"Can you tell me anything about the victim's physician? you ask.<p><p>\"Naomi Howard. We don't talk.\"<p>\"Do you actually talk to anyone?\"<p>He turns a page and doesn't reply."));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Basement, and find a man dressed in a shapeless gray suit, slouched on a chair and staring at his feet. A quick flip through your suspect dossier reveals this to be Noah Luna, the victim's golf caddy.<p>\"Might as well get it over with and put the cuffs on me now,\" he mutters, holding up his wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"You want to know who I think killed Cletus?\" Noah asks. \"Yeah, sure. Why not? I might as well tell you, what do I care anyway? It was Savannah Holman. Take 'em away, it's one less person I'll have to clean up after in this place.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=6&visit=1", "\"Are you familiar with a woman named Savannah Holman?\" you ask.<p>\"She's in the Servants' Quarters,\" Noah says. \"I like her -- she doesn't immediately blame me when things go wrong around here. As they inevitably do. And as everyone else inevitably does.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Bathroom, and discover an extremely muscular man lifting weights and glistening with sweat. According to the dossier, this is Dan Spears, the victim's housekeeper.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Cletus'd had a proper regimen like I told him.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Nah, sorry,\" he says. \"No idea. I was blastin' my delts at the time, so I didn't notice anything unusual.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Living Room and find an annoyed-looking young woman slouched on a leather sofa with her motorcycle boots propped up on the expensive ebony coffee-table. She gives you a withering look and lights a cigarette. Your dossier identifies her as Alexandra Dennis, the victim's boss.<p>\"God, finally,\" she growls. \"Hurry up and ask me some effin' questions so I can get out of this place!\"<p>\"You in a hurry or something?\" you ask, tapping your pencil on your notepad.<p>\"Look, cop, I got a life. I got stuff to be doing other than standing around this craphole.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "Inside the Servants' Quarters you find a gray-haired woman reading through a stack of papers, scowling at them with faint disgust. Judging from the dossier the Officers Chaps gave you, this must be Mariah Decker, the victim's ex-chauffeur.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" she says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think the killer is?\" you ask.<p>\"It was Johnny Rosales, Detective,\" Decker says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=4", "\"Do you know someone named Noah Luna?\" you ask.<p>\"Ah yes,\" Decker says. \"You will find him in the Basement, Detective. We have participated in friendly debate on occasion. His views regarding the human condition are unorthodox, but intriguing.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Boiler Room you find a gray-haired woman reading through a stack of papers, scowling at them with faint disgust. Your dossier identifies her as Zoey McLaughlin, the victim's lawyer.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" she says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"This is not my field of knowledge or experience, Detective,\" McLaughlin says. \"Nor of interest. I will leave such matters to you and the other police.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Pantry, you find a young man in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick his foot to wake him up. \"Uh?\" he says. \"Wha? Oh.\" He stands up, knuckling sleepy, bloodshot eyes. \"You must be Lonnie Grimes, the victim's butler,\" you say, flipping to the relevant page in the dossier.<p>You show him your badge. \"I'm investigating the murder of Rachel Nichols, and I need to ask you some questions.<p>\"Sure, right on,\" he says. \"Ask away, man. Rock it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Dang, dude!\" Lonnie says, \"I wondered when you were finally gonna get around to asking that! Like, jeez, right? Listen, it was totes Rachel's gardener. Like, for real.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"Have you met the victim's lawyer?\" you ask.<p>\"Oh, her, yeah. I know her, kinda,\" Lonnie says. \"Her name's Addison Sutton. I'm not real into her. She's a real buzzkill, you know?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Sunroom, and find a woman dressed in a shapeless gray suit, slouched on a chair and staring at her feet. Your dossier identifies her as Addison Sutton, the victim's golf caddy.<p>\"Might as well get it over with and put the cuffs on me now,\" she mutters, holding up her wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Well gosh,\" Addison says, her eyes widening. \"Do you actually expect me to rat out one of my precious friends and/or colleagues?\"<p>\"...Are you joking?\"<p>\"Yes. Rachel's best friend killed her.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know someone by the name of Zoey McLaughlin?\" you ask.<p>\"Yeah, that's Rachel's lawyer,\" Addison replies. \"Not that you'd know it. I'm the one who does all the work around here. But do I get any thanks? No, of course not. Just the blame.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Hall Closet, and find a young man wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. He looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" he says, kneeling down to fish for it. \"I was totes on a roll.\" According to the notes the Officers Chaps gave you, this is Perry Weber, the victim's butler.<p>\"Uh, hey,\" he says. \"Hi. Yeah. I'm Perry. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Dang, dude!\" Perry says, \"I wondered when you were finally gonna get around to asking that! Like, jeez, right? Listen, it was totes Faith's lover. Like, for real.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=2&visit=1", "\"The victim's lover -- do you know them?\" you ask.<p>\"Lover...\" Perry muses, then his eyes light up. \"Oh, yeah, dude! I know who you mean. They're cool. Go check out the Breakfast Nook, you'll find 'em there.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You walk into the Guest Bedroom and meet a man dressed for an extremely expensive white-tie affair. He looks down his nose regally at you. According to the dossier, this is Alistair Hunt, the victim's ex-physician.<p>\"Sorry to disturb you,\" you say, \"but I'm investigating Stephen West's death, and I need to ask you some questions.\"<p>\"I am an extremely busy man, Detective, and I have places to be this evening,\" he sniffs haughtily. <p>\"That's fine,\" you say. \"The sooner I get these questions answered, the sooner you can go.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"You're asking <i>me</i>, Detective?\" he exclaims. \"If I knew that, this ridiculous little mishap would have been handled already!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "The only person in the Dining Room is a hugely-muscled man, currently working out with a set of oversized freeweights. A quick flip through your suspect dossier reveals this to be Dennis Willis, the victim's best friend.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" he replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Nah, sorry,\" he says. \"No idea. I was blastin' my delts at the time, so I didn't notice anything unusual.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Foyer and find an annoyed-looking young woman slouched on a leather sofa with her motorcycle boots propped up on the expensive ebony coffee-table. She gives you a withering look and lights a cigarette. According to the notes the Officers Chaps gave you, this is Sofia Hudson, the victim's physician.<p>\"I've got some questions for you,\" you say.<p>\"Good! Great! Ask away!\" she mutters. \"Then maybe I can get out of this dive.\"<p>\"You got somewhere better to be?\"<p>\"If that's the kinda questions you're gonna ask, this is gonna be <i>real</i> fun,\" she says, rolling her eyes."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Cuttin' right to the chase, huh?\" Sofia says. \"Well, since you ask so friggin' nice and all -- it was Olivia Travis. Whaddya think of that?\" <p>You write the name down without replying."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know someone named Alistair Hunt?\" you ask.<p>\"You mean Stephen's business partner? He's a scumbag, that's all I know. I wouldn't trust that sack of crap with my life.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "In the Ballroom, you find a dark-haired young woman sitting quietly, reading a book. She glances briefly at you over the top of her glasses as you enter, but says nothing. According to the dossier, this is Payton Burris, the victim's cousin.<p>\"Excuse me,\" you say, \"I'm from the police, and I need to ask you some questions. ...Can you put the book down for a minute?\" She slowly drags her eyes away from the page and regard you impassively. \"Well, it's a start,\" you sigh."));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "When you enter the Basement, you encounter a young woman wearing a beret and black turtleneck, chewing on the end of her pencil. \"You must be Leah Beach, the victim's boss,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" she says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Well, in my poem I'm attributing the murder to a black shadow wrought from the ghosts of those murdered by capitalism,\" Leah says. \"Does that help?\"<p>\"Not... particularly.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "The only person in the Bar is an older man in a tweed suit, slashing at a stack of papers with a red pen. According to the dossier, this is Jedediah Kelly, the victim's lover.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" he says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"We are all murderers, Detective,\" Kelly says. \"Every decision we make, every event we experience, kills our past self and creates a new man to take his place.\"<p>\"...Okay, but I'm talking about Stephen West's murder specifically.\"<p>\"Ah. In that case, it was his accountant.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=6", "\"Alistair Hunt. What can you tell me about him?\" you ask.<p>\"He is in the Guest Bedroom,\" Kelly says. \"We are cordial with one another, but speak little. It is refreshing to know someone who does not insist on small talk at every encounter.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Boiler Room, you are greeted by an aristocratic-looking woman dressed for a white-tie occasion. She looks you up and down, and doesn't appear to think much of what she sees. A quick flip through your suspect dossier reveals this to be Allison Warren, the victim's business partner.<p>\"Sorry to disturb you,\" you say, \"but I'm investigating Eva Miranda's death, and I need to ask you some questions.\"<p>\"I am an extremely busy woman, Detective, and I have places to be this evening,\" she sniffs haughtily. <p>\"That's fine,\" you say. \"The sooner I get these questions answered, the sooner you can go.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Well, since you asked me, Detective,\" Warren sniffs, \"I would say it was undoubtedly that snivelling little upstart of a gardener.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=5&visit=1", "\"Can you tell me anything about Eva Miranda's gardener?\" you ask.<p>\"I presume you are asking about Jack Villarreal,\" Warren says. \"That loathsome little insect of a man. I have nothing to do with him, and nothing more to say.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "When you enter the Ballroom, you encounter a young woman wearing a beret and black turtleneck, chewing on the end of her pencil. Judging from the dossier the Officers Chaps gave you, this must be Angelina Goodwin, the victim's gardener.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Angelina sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Well, in my poem I'm attributing the murder to a black shadow wrought from the ghosts of those murdered by capitalism,\" Angelina says. \"Does that help?\"<p>\"Not... particularly.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "The only person in the Guest Bedroom is a hugely-muscled man, currently working out with a set of oversized freeweights. A quick flip through your suspect dossier reveals this to be Max Chandler, the victim's ex-child.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" he replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>Max shakes his head. \"No idea who it was. If they tried that on me, though, I'd tear them in half. Literally. I've been practicing on sides of beef.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Lounge, where a young man wearing a leather jacket and motorcycle boots is casually whittling his initials into the surface of a mahogany end-table. He glances at you, finishes his task, and puts his penknife away. According to the dossier, this is Stanley Slater, the victim's neighbor.<p>\"God, finally,\" he growls. \"Hurry up and ask me some effin' questions so I can get out of this place!\"<p>\"You in a hurry or something?\" you ask, tapping your pencil on your notepad.<p>\"Look, cop, I got a life. I got stuff to be doing other than standing around this craphole.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"What, now you want me to do your damn job for you?\" he sneers. \"You're the big-time detective, you figure it out!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "As you enter the Master Bedroom, a small nervous-looking man spins around with a startled look. Judging from the dossier the Officers Chaps gave you, this must be Moe Cobb, the victim's best friend.<p>\"Who are you?!\" he demands. \"Police,\" you reply. \"I need to ask you a few questions about--\"<p>\"And how do I know you're telling the truth? I should just take your word for it? You could be anybody!\"<p>With a sigh, you pull out your badge and show it to him. \"Happy?\"<p>\"And I'm supposed to just trust that that's real? Well... all right. For now. But I've got my eye on you!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"I don't know who did it!\" Moe says, really loudly. \"I don't know a thing! Why are you even asking me? Even if I did know, I certainly wouldn't tell you!\" And then he looks around and whispers, \"It was Max Chandler!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"The victim had a business partner, do you know them?\" you ask.<p>\"No! Keep well away from that one!\" Moe exclaims. \"They'rein the Master Bedroom, so stay out of there! Don't risk being subverted by that hypnotic gaze!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=2&visit=4", "\"Do you know Miranda's ex-child?\" you ask.<p>\"No! Keep well away from that one!\" Moe exclaims. \"They'rein the Master Bedroom, so stay out of there! Don't risk being subverted by that hypnotic gaze!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=3&visit=4", "\"Have you met the victim's neighbor?\" you ask.<p>\"Oh, you mean Stanley Slater?\" Moe says. \"I'm not one hundred percent on him, but I think he might be okay. I'm keeping my eyes on him.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Billiard Room you find a young man deep in thought, staring at the ceiling while tapping his pencil on the page of a leather-bound notebook. \"You must be Harry Caldwell, the victim's housekeeper,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Harry sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Unfortunately,\" Harry grumbles, \"it was Mia's child. I can't think of a single decent rhyme for child.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=1", "\"Can you tell me anything about the victim's child? you ask.<p>\"Are you referring to Paul Daniels?\" Harry asks. \"Yes, I'd say we get along quite well. He doesn't know very much about poetry, I'm afraid, but I'm doing my best to educate him whenever he's not late for one of his many dentist appointments.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=8", "You walk into the Boiler Room and meet a man dressed for an extremely expensive white-tie affair. He looks down his nose regally at you. Judging from the dossier the Officers Chaps gave you, this must be Clancy Hoover, the victim's child.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask you a few questions.\" <p>\"I am already late for the French Ambassador's gala,\" he  says coldly. \"I trust this will not take long?\" <p>\"Depends on how quickly you answer.\"<p>He glares at you for a second, then rolls his eyes. \"Oh, very well. Ask.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=8", "\"Who do you think the killer is?\" you ask.<p>\"I'm sure I have no idea,\" he says coldly. \"Perhaps you should figure it out, Detective, so that I needn't stand around this place answering your questions any longer!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Family Room, you find a young woman in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick her foot to wake her up. \"Uh?\" she says. \"Wha? Oh.\" She stands up, knuckling sleepy, bloodshot eyes. Judging from the dossier the Officers Chaps gave you, this must be Rachel Stone, the victim's sibling.<p>\"So uh, what's up man?\" she asks. \"I mean, Officer.\"<p>\"Detective,\" you say, flashing your badge.<p>\"Right on, right on. So what's the skinny?\"<p>\"I need to ask you a few questions.\"<p>\"Okay, sure, yeah. Shoot.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Okay, well, uhh...\" Rachel hesitates. \"...Like I don't wanna be a narc or whatever, so I don't wanna name names, you know dude? But okay, I will say you should check out Mia's lawyer. Like for real, you know?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Are you familiar with someone named Harry Caldwell?\" you ask.<p>\"Oh, he's cool,\" she replies. \"Like, maybe you wouldn't think it to meet him, but like deep down, you know? He's good people.\"<p>\"Can you tell me anything <i>useful</i> about Harry Caldwell?\"<p>\"Oh, uhh... Well, he's Mia's lawyer, does that help?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "The only person in the Foyer is an older man in a tweed suit, slashing at a stack of papers with a red pen. \"You must be Ed Jacobs, the victim's business partner,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say. \"I'm with the police -- need to ask you a few questions. ...What are you doing?\"<p>\"Grading papers. Although Alvarez may have escaped her duties for the oblivion of death,\" he says in a clipped Bavarian accent, \"the rest of us still have jobs that require our attention.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"This is not my field of knowledge or experience, Detective,\" Jacobs says. \"Nor of interest. I will leave such matters to you and the other police.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "The only person in the Game Room is a hugely-muscled woman, currently working out with a set of oversized freeweights. Judging from the dossier the Officers Chaps gave you, this must be Emma Henry, the victim's neighbor.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" she replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Sure, I know who it was,\" Emma says. \"Nothing gets past <i>these</i> muscles!\"<p>\"I... don't know what that means, but who?\" you ask. <p>\"Ed Jacobs. Can you believe it? A skinny twig like that?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=4", "\"What can you tell me about Harry Caldwell?\" you ask.<p>\"Yeah, I know that wimp. That's Mia's housekeeper,\" Emma says. \"Pathetic. All talk and no fight.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Game Room you find a gray-haired woman reading through a stack of papers, scowling at them with faint disgust. Judging from the dossier the Officers Chaps gave you, this must be Caroline Duran, the victim's housekeeper.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" she says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"I respect that the matter is of interest to you, Detective,\" Duran says, \"because it is only through the interest of people such as yourself that our society can withstand the forces of chaos for the brief time that we inhabit this universe. However, I do not share your interest.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Hall Closet, you find a large and powerfully-muscled woman doing arm-curls with a set of huge barbells. Your dossier identifies her as Gabrielle Yates, the victim's chauffeur.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" she replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Oh, that's as easy as tearing a telephone in half,\" Gabrielle says. \"It was Natalia's dental hygienist.\"<p>'You don't mean 'telephone book', do you?\"<p>\"Nope.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"What can you tell me about Caroline Duran?\" you ask.<p>\"She's Natalia's sibling,\" Gabrielle says. \"We don't have much in common, but we get along pretty well. She's got a real good sense of humor, you know? Funny.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Bathroom and find an annoyed-looking young woman slouched on a leather sofa with her motorcycle boots propped up on the expensive ebony coffee-table. She gives you a withering look and lights a cigarette. \"You must be Destiny Fleming, the victim's neighbor,\" you say, flipping to the relevant page in the dossier.<p>\"I've got some questions for you,\" you say.<p>\"Good! Great! Ask away!\" she mutters. \"Then maybe I can get out of this dive.\"<p>\"You got somewhere better to be?\"<p>\"If that's the kinda questions you're gonna ask, this is gonna be <i>real</i> fun,\" she says, rolling her eyes."));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "You enter the Lounge and encounter a woman dressed in very expensive-looking formal attire. She regards you with a look of distaste and disdain. According to the dossier, this is Savannah Hampton, the victim's dental hygienist.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask you a few questions.\" <p>\"I am already late for the French Ambassador's gala,\" she  says coldly. \"I trust this will not take long?\" <p>\"Depends on how quickly you answer.\"<p>She glares at you for a second, then rolls her eyes. \"Oh, very well. Ask.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"I believe the answer is quite obvious, Detective,\" Hampton sneers. \"Who could it possibly have been except Naomi Glover? A prime specimen of the criminal underclass.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"Do you know Pitts's housekeeper?\" you ask.<p>\"I will not lower myself to that person's level by deigning to speak to them,\" Hampton sniffs. \"If you wish to know about them, try the Game Room.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "In the Billiard Room, you find a dark-haired young woman sitting quietly, reading a book. She glances briefly at you over the top of her glasses as you enter, but says nothing. Judging from the dossier the Officers Chaps gave you, this must be Chloe Fields, the victim's business partner.<p>\"What are you reading?\" you ask, to break the silence. She silently gestures at the cover, which is jacketless and doesn't have the title printed on it. \"So... a book.\"<p>\"Mm-hmm,\" she replies."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"No idea,\" she says, turning a page in her book."));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Basement, you find a large and powerfully-muscled man doing arm-curls with a set of huge barbells. According to the dossier, this is Earl Vazquez, the victim's housekeeper.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Trinity'd had a proper regimen like I told her.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Yeah, easy,\" Earl says. \"It was Trinity's accountant.\"<p>\"Are you sure?\" you ask.<p>\"Hey buddy, these muscles don't lie.\" He flexes at you to demonstrate... something."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Are you familiar with a woman named Chloe Fields?\" you ask.<p>\"'Course I know Chloe Fields!\" Earl says. \"That's Trinity's business partner. I challenged her to arm-wrestle once, and nearly threw her across the room, heh heh. Oh, don't give me that look, she was fine.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Dining Room, where a young man wearing a leather jacket and motorcycle boots is casually whittling his initials into the surface of a mahogany end-table. He glances at you, finishes his task, and puts his penknife away. Judging from the dossier the Officers Chaps gave you, this must be Morris Brooks, the victim's neighbor.<p>\"God, finally,\" he growls. \"Hurry up and ask me some effin' questions so I can get out of this place!\"<p>\"You in a hurry or something?\" you ask, tapping your pencil on your notepad.<p>\"Look, cop, I got a life. I got stuff to be doing other than standing around this craphole.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Attic, and encounter a young woman -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. \"You must be Layla Pope, the victim's dental hygienist,\" you say, flipping to the relevant page in the dossier.<p>\"What are you doing?\" you ask her. <p>\"Looking for clues! I'm pretty sure Merle Bryan was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" she says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Jeez, Detective!\" Layla pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "Inside the Servants' Quarters you find a woman pacing around and smoking a cigarette. As you enter, she turns and shoots you that particular grin that people use when they're extremely nervous, but are trying to play it cool. According to the dossier, this is Morgan Orr, the victim's best friend.<p>\"Good, good,\" she says. \"I'm glad you're here, Officer.\"<p>\"Detective.\"<p>\"Right! Right, of course, Detective, sorry. What a terrible thing that happened, just awful. But I'm sure you'll get to the bottom of it right away, yeah?\"<p>\"Hopefully, yes,\" you say. \"I'd like to ask you a few questions.\"<p>\"Sure, sure! Ask away, Detective, I've got nothin' to hide!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Well now!\" Morgan says, glancing around the room and over her shoulder. \"Ain't every day a police detective asks my opinion on a thing like that! Sorry though, I just don't know what to tell ya. <i>*cough*Alan Page*cough*</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Can you tell me anything about Merle Bryan's neighbor?\" you ask.<p>\"Merle's neighbor... Oh. You mean Morgan Campbell,\" Morgan says, shaking her head. \"Yeah, no. I don't need the stress, know what I mean?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "You enter the Family Room and find an older man in a tweed suit, muttering to himself over a stack of papers. A quick flip through your suspect dossier reveals this to be Morgan Campbell, the victim's golf caddy.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" he says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think the killer is?\" you ask.<p>\"I respect that the matter is of interest to you, Detective,\" Campbell says, \"because it is only through the interest of people such as yourself that our society can withstand the forces of chaos for the brief time that we inhabit this universe. However, I do not share your interest.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You walk into the Smoking Lounge, and find a young woman wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. She looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" she says, kneeling down to fish for it. \"I was totes on a roll.\" \"You must be Ariana Johnston, the victim's gardener,\" you say, flipping to the relevant page in the dossier.<p>\"So uh, what's up man?\" she asks. \"I mean, Officer.\"<p>\"Detective,\" you say, flashing your badge.<p>\"Right on, right on. So what's the skinny?\"<p>\"I need to ask you a few questions.\"<p>\"Okay, sure, yeah. Shoot.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Dang, dude, like, you're the detective, right? I dunno from this whole murder thing, I'm just mindin' my own.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Game Room, and discover an extremely muscular woman lifting weights and glistening with sweat. A quick flip through your suspect dossier reveals this to be Ashley George, the victim's accountant.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Merle'd had a proper regimen like I told him.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Yeah, easy,\" Ashley says. \"It was Merle's gardener.\"<p>\"Are you sure?\" you ask.<p>\"Hey buddy, these muscles don't lie.\" She flexes at you to demonstrate... something."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=6", "\"Are you familiar with someone named Morris Brooks?\" you ask.<p>\"Yeah, I know that wimp. That's Merle's neighbor,\" Ashley says. \"Pathetic. All talk and no fight.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Living Room and find a young woman in a beret, pacing around and muttering to herself while scribbling in a leather-bound notebook. A quick flip through your suspect dossier reveals this to be Kimberly Sutton, the victim's ex-child.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" she says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Who killed Kaylee?\" Kimberly asks. \"Why, I haven't the faintest idea. I was rather hoping you could tell me, or else I won't be able to give my poem a proper ending.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Attic you find a gray-haired woman reading through a stack of papers, scowling at them with faint disgust. A quick flip through your suspect dossier reveals this to be Ava Stark, the victim's best friend.<p>\"Excuse me,\" you say. \"I'm with the police -- need to ask you a few questions. ...What are you doing?\"<p>\"Grading papers. Although Martin may have escaped her duties for the oblivion of death,\" she says in a clipped Bavarian accent, \"the rest of us still have jobs that require our attention.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"The business partner.\"<p>\"What?\"<p>\"The killer was Kaylee Martin's business partner, Detective,\" Stark says. <p>\"Oh! I was expecting a wordier response.\"<p>\"I hope you will relish that feeling of surprise, for it is one of the few ways in which a person can prove she is alive.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"Can you tell me anything about the victim's ex-child? you ask.<p>\"This man you are speaking of, his name is Jim Joseph,\" Stark says. \"My interactions with him have been unpleasant, without exception.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "In the Pantry, you find a dark-haired young woman sitting quietly, reading a book. She glances briefly at you over the top of her glasses as you enter, but says nothing. A quick flip through your suspect dossier reveals this to be Emma Woods, the victim's physician.<p>\"What are you reading?\" you ask, to break the silence. She silently gestures at the cover, which is jacketless and doesn't have the title printed on it. \"So... a book.\"<p>\"Mm-hmm,\" she replies."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think is the most likely to be the killer?\" you ask.<p>She ignores you and keeps reading."));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "You enter the Lounge, and encounter a young man -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. According to the notes the Officers Chaps gave you, this is Clancy Murphy, the victim's personal assistant.<p>\"What are you doing?\" you ask him. <p>\"Looking for clues! I'm pretty sure Kaylee Martin was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" he says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Jeez, Detective!\" Clancy pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "Inside the Family Room, you find a young woman in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick her foot to wake her up. \"Uh?\" she says. \"Wha? Oh.\" She stands up, knuckling sleepy, bloodshot eyes. \"You must be Makayla Suarez, the victim's bodyguard,\" you say, flipping to the relevant page in the dossier.<p>\"So uh, what's up man?\" she asks. \"I mean, Officer.\"<p>\"Detective,\" you say, flashing your badge.<p>\"Right on, right on. So what's the skinny?\"<p>\"I need to ask you a few questions.\"<p>\"Okay, sure, yeah. Shoot.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "When you enter the Servants' Quarters, you find a young woman dressed in crisp tennis whites, idly bouncing a tennis ball on a racket and whistling a jaunty little tune. Your dossier identifies her as Genesis Scott, the victim's business partner.<p>She looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking her proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"It was Kaylee's physician, Detective,\" Genesis says. \"And that's the honest truth, not a fib to get out of an unpleasant betrothal arrangement, I assure you.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=6", "\"What can you tell me about the deceased's ex-child?\" you ask.<p>\"Oh certainly, certainly,\" Genesis says. \"Indubitably, even, if I'm correct in assuming that to be a word. Spends a lot of time in the Family Room, don't you know. Yes yes, we're quite close.\"<p>\"Do you know their name?\" you ask.<p>\"Haven't the foggiest.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "You enter the Boiler Room, and discover an extremely muscular man lifting weights and glistening with sweat. A quick flip through your suspect dossier reveals this to be Ed Duffy, the victim's butler.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Kaylee'd had a proper regimen like I told her.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Oh, that's as easy as tearing a telephone in half,\" Ed says. \"It was Kaylee's personal assistant.\"<p>'You don't mean 'telephone book', do you?\"<p>\"Nope.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=7", "\"Do you know someone by the name of Kimberly Sutton?\" you ask.<p>\"Pfft, yeah, I know Kimberly Sutton,\" Ed says. \"You'll find her in the Living Room, if a stiff breeze hasn't carried her away, hah!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Game Room and meet a man dressed in cheap knockoff versions of the latest rich peoples' fashions. According to the dossier, this is Merle Vang, the victim's housekeeper.<p>\"Hey, what took ya so long?\" he asks. \"Hah, nah, just kiddin' with ya. I know you boys have got a tough job, always had a deep respect for the boys in blue. Anything you wanna know, just ask me -- Merle Vang. Nobody knows what's going down around this place like I do.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Nah, 'fraid I can't help ya there, Detective,\" Merle says. \"I mean, I <i>know</i>, and I'll absolutely tell ya anything <i>else</i> ya wanna know, but my rep'll take a real dive if people think I'm a rat, you know what I'm sayin'?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Living Room, where a young woman wearing a leather jacket and motorcycle boots is casually whittling her initials into the surface of a mahogany end-table. She glances at you, finishes her task, and puts her penknife away. \"You must be Jasmine Quinn, the victim's business partner,\" you say, flipping to the relevant page in the dossier.<p>\"I've got some questions for you,\" you say.<p>\"Good! Great! Ask away!\" she mutters. \"Then maybe I can get out of this dive.\"<p>\"You got somewhere better to be?\"<p>\"If that's the kinda questions you're gonna ask, this is gonna be <i>real</i> fun,\" she says, rolling her eyes."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Oh, well, it was probably the butler. That's what I figure.\"<p>\"Why do you say that?\" you ask.<p>\"Because I'm a friggin' psychic. Get bent!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Are you familiar with someone named Merle Vang?\" you ask.<p>\"Merle Vang, that's Angelina's housekeeper. I ain't got a single good word to say about that sleazy friggin' weasel.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Billiard Room, and discover an extremely muscular woman lifting weights and glistening with sweat. According to the dossier, this is Gabrielle Reeves, the victim's child.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Gabrielle grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>Gabrielle shakes her head. \"No idea who it was. If they tried that on me, though, I'd tear them in half. Literally. I've been practicing on sides of beef.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "As you enter the Study, you are greeted by an aristocratic-looking man dressed for a white-tie occasion. He looks you up and down, and doesn't appear to think much of what he sees. Judging from the dossier the Officers Chaps gave you, this must be Dave Calhoun, the victim's neighbor.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask you a few questions.\" <p>\"I am already late for the French Ambassador's gala,\" he  says coldly. \"I trust this will not take long?\" <p>\"Depends on how quickly you answer.\"<p>He glares at you for a second, then rolls his eyes. \"Oh, very well. Ask.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"I believe the answer is quite obvious, Detective,\" Calhoun sneers. \"Who could it possibly have been except Cal Chang? A prime specimen of the criminal underclass.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"The victim's child -- do you know them?\" you ask.<p>\"I presume you are asking about Cal Chang,\" Calhoun says. \"That loathsome little insect of a man. I have nothing to do with him, and nothing more to say.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "In the Laundry Room, you find a dark-haired young woman sitting quietly, reading a book. She glances briefly at you over the top of her glasses as you enter, but says nothing. According to the dossier, this is Layla Brown, the victim's gardener.<p>\"I'm from the police, and I'll need to ask you a few questions,\" you say.<p>\"Mm-hmm,\" comes the reply.<p>\"...You're the quiet type, I gather.\"<p>\"Mm-hmm.\"<p>\"Are all your answers going to be like this?\"<p>She turns the page without comment."));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "In the Master Bedroom you find a pale, drably-dressed woman slouched on a small chair. She looks up at you as you enter, and sighs pathetically. According to the notes the Officers Chaps gave you, this is Ava Andrews, the victim's lawyer.<p>\"Great, here we go,\" she says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Who killed Lillian Roach? You're asking me? Why not ask me something I know the answer to, like who's supposed to clean the toilets around here. The answer to that is not, in fact, me, but guess what? I end up having to do it anyway.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You walk into the Bar, and find a young man wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. He looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" he says, kneeling down to fish for it. \"I was totes on a roll.\" \"You must be Steven Savage, the victim's butler,\" you say, flipping to the relevant page in the dossier.<p>\"Uh, hey,\" he says. \"Hi. Yeah. I'm Steven. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Jeez, man, you got me. ...Ha ha, no wait, that sounded bad. I mean, like, you got me, not you got me, right? Like, I dunno who did it.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "Inside the Servants' Quarters, you discover a young woman, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. \"You must be Victoria Finch, the victim's cousin,\" you say, flipping to the relevant page in the dossier.<p>\"What are you doing?\" you ask her. <p>\"Looking for clues! I'm pretty sure Lillian Roach was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" she says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Golly! You really want to know what I think, Detective?\" Victoria says, excitedly, and pulls out a notebook. \"Okay, so, first I measured some footprints out in the driveway, and...\" <p>\"Kid, we're short on time. Cut to the chase and tell me the details later, okay?\"<p>\"Oh, okay! It was Steven Savage!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=6", "\"Gabrielle Reeves. What can you tell me about her?\" you ask.<p>\"She's the victim's chauffeur,\" Victoria says. \"She is pretty friendly. I haven't found anything to tie her to the scene of the crime yet.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "You enter the Foyer and encounter a well-to-do-looking young man dressed in crisp tennis whites, lounging casually across an overstuffed chair and flipping playing cards into a straw boater -- or rather, attempting to, and largely missing. A quick flip through your suspect dossier reveals this to be Arthur Vincent, the victim's housekeeper.<p>\"I'd love a spot of tea, if you've got one handy,\" he says, then looks up at you and practically jumps to his feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Lillian Roach,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"You want to know who I think did it?\" Arthur says, looking surprised. \"Well, that's a rum go. I hadn't even considered the question. I suppose it must've been Cal Chang, though, mustn't it? Stands to reason.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=7", "\"Have you met the victim's child?\" you ask.<p>\"Child, child. Hmm,\" Arthur ponders. \"No, sorry Detective, I don't know who that is, dash it all. ...Oh! Unless you mean Victoria Finch? Now that you mention it, I do seem to remember something about her being Lillian's child. Well there you go! That must be it.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=8", "You enter the Pantry and meet a man dressed in cheap knockoff versions of the latest rich peoples' fashions. According to the notes the Officers Chaps gave you, this is Alvin Spears, the victim's chauffeur.<p>\"Good, good,\" he says. \"I'm glad you're here, Officer.\"<p>\"Detective.\"<p>\"Right! Right, of course, Detective, sorry. What a terrible thing that happened, just awful. But I'm sure you'll get to the bottom of it right away, yeah?\"<p>\"Hopefully, yes,\" you say. \"I'd like to ask you a few questions.\"<p>\"Sure, sure! Ask away, Detective, I've got nothin' to hide!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=8", "\"Who do you think the killer is?\" you ask.<p>\"Well gee, Detective,\" Alvin says, \"I hate to disappoint ya, but I haven't got a clue who could've done it. Far as I know, everyone in this house loved Lillian like a brother. Or a sister, or whatever.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=9", "You enter the Breakfast Nook, where a bored and angry-looking young man in motorcycle boots and a leather jacket is stomping around and ashing his cigarette on the expensive-looking Turkish carpet. According to the dossier, this is Cal Chang, the victim's best friend.<p>\"God, finally,\" he growls. \"Hurry up and ask me some effin' questions so I can get out of this place!\"<p>\"You in a hurry or something?\" you ask, tapping your pencil on your notepad.<p>\"Look, cop, I got a life. I got stuff to be doing other than standing around this craphole.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Oh, well, it was probably the gardener. That's what I figure.\"<p>\"Why do you say that?\" you ask.<p>\"Because I'm a friggin' psychic. Get bent!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Sunroom, and find a man dressed in a shapeless gray suit, slouched on a chair and staring at his feet. A quick flip through your suspect dossier reveals this to be Ralph Collins, the victim's gardener.<p>\"Might as well get it over with and put the cuffs on me now,\" he mutters, holding up his wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"I don't know who killed Emily, but I do know they'd have saved me a lot of trouble if they'd killed me too. Guess they couldn't be bothered to waste the bullet or whatever.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Boiler Room and meet a man dressed in cheap knockoff versions of the latest rich peoples' fashions. Judging from the dossier the Officers Chaps gave you, this must be Byron Moon, the victim's physician.<p>\"Hey, what took ya so long?\" he asks. \"Hah, nah, just kiddin' with ya. I know you boys have got a tough job, always had a deep respect for the boys in blue. Anything you wanna know, just ask me -- Byron Moon. Nobody knows what's going down around this place like I do.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"All right, well, I'm trusting you to keep my name out of this, Detective,\" Byron says. \"My life wouldn't be worth a plugged nickel if the wrong people found out I told you this. But it was Serenity O'Connor. I can't risk tellin' ya any more than that.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"What can you tell me about the deceased's gardener?\" you ask.<p>\"Gardener... Gardener...\" Byron mutters. \"...Oh! You mean Ralph Collins! Heck, we're such good pals I practically forgot he's Emily's gardener!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Library you find a gray-haired man reading through a stack of papers, scowling at them with faint disgust. \"You must be Doc Parrish, the victim's butler,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" he says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"We are all murderers, Detective,\" Parrish says. \"Every decision we make, every event we experience, kills our past self and creates a new man to take his place.\"<p>\"...Okay, but I'm talking about Zoe Marks's murder specifically.\"<p>\"Ah. In that case, it was her sibling.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=5&visit=1", "\"Have you met the victim's sibling?\" you ask.<p>\"I believe you are speaking of Terry Wynn, Detective,\" Parrish says. \"I have nothing to recommend of such a cowardly, beady-eyed vole of a human being.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Bathroom, and discover an extremely muscular man lifting weights and glistening with sweat. Your dossier identifies him as Travis Gilbert, the victim's sibling.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" he replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Nah, sorry,\" he says. \"No idea. I was blastin' my delts at the time, so I didn't notice anything unusual.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Bar, where a bored and angry-looking young woman in motorcycle boots and a leather jacket is stomping around and ashing her cigarette on the expensive-looking Turkish carpet. A quick flip through your suspect dossier reveals this to be Lauren Wiley, the victim's gardener.<p>\"I need to ask you some questions about the murder,\" you say.<p>\"I didn't kill anybody, but if I have to hang around this dump any longer, I might,\" she snarls. \"Hurry up and ask me whatever you're gonna ask, so I can get out of here!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Get the hell outta here! Even if I <i>did</i> know, I still wouldn't tell a cop!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You walk into the Breakfast Nook, which appears to be empty -- until a nervous face appears from behind the sofa. A quick flip through your suspect dossier reveals this to be Steven Huff, the victim's chauffeur.<p>\"Who are you?!\" he exclaims. \"Don't come any closer or I'll call the cops!\"<p>\"I <i>am</i> the cops,\" you say, showing him your badge.<p>\"Oh thank god! Thank god you're here! I'm going to be next, I just know it, you have to protect me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"If I knew that, I wouldn't be out of my mind with fear!\" Steven exclaims. \"It could be any of them! <i>Any of them!!</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "In the Ballroom you meet a young woman dressed in crisp tennis whites, relaxing and leafing idly through a fashion magazine, apparently without a care in the world. A quick flip through your suspect dossier reveals this to be Mackenzie Mejia, the victim's business partner.<p>\"I'd love a spot of tea, if you've got one handy,\" she says, then looks up at you and practically jumps to her feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Zoe Marks,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Who put paid to old Zoe? Well, that's quite a question, isn't it Detective?\" Mackenzie says. \"I mean, it could be bally anyone, and there's quite a quantity of people on this old ball of rock we call Earth.\"<p>\"...We're pretty sure it was someone in this house,\" you say.<p>\"Oh! Well, it was Jake Barr, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"Can you tell me anything about the victim's butler? you ask.<p>\"Oh, him,\" Mackenzie says with a slight grimace. \"That little blighter goes by the name Jake Barr, Detective. Nasty piece of work. Face like a horse. And I shall leave the question of which bit of the horse to your own deductive prowess.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "As you enter the Smoking Lounge, a man in a drab gray suit looks up at you from the chair he's slouched in, and sighs. \"You must be Frederick Bradshaw, the victim's lawyer,\" you say, flipping to the relevant page in the dossier.<p>\"Great, here we go,\" he says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Oh, is that all you want to know?\" Frederick asks. \"All right. It was Travis Gilbert. Go ahead and make a big show about how you solved the case all by yourself with your big detective skills, I don't expect to receive any credit for the information.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=6", "\"Are you familiar with someone named Doc Parrish?\" you ask.<p>\"Yeah, that's Zoe's gardener,\" Frederick replies. \"Not that you'd know it. I'm the one who does all the work around here. But do I get any thanks? No, of course not. Just the blame.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "You enter the Game Room and meet a man dressed in cheap knockoff versions of the latest rich peoples' fashions. Judging from the dossier the Officers Chaps gave you, this must be Terry Wynn, the victim's best friend.<p>\"Boy, am I glad to see you!\" he says. \"I just can't believe someone would do this to dear old Zoe. Listen, if there's anything I can do to help, anything at all, you just let me know.\"<p>\"Well,\" you say, \"I would like to ask you some questions.\"<p>\"Questions? Oh, er, right! Yeah, sure, ask away! Always happy to cooperate with the police, that's me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Ahh, well now, I'm afraid I can't help ya there, Detective,\" Terry says. \"I was all the way on the other side of the house when it happened, and I didn't hear a thing. Sorry.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=8", "You enter the Study and encounter a man dressed in very expensive-looking formal attire. He regards you with a look of distaste and disdain. A quick flip through your suspect dossier reveals this to be Jake Barr, the victim's physician.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask you a few questions.\" <p>\"I am already late for the French Ambassador's gala,\" he  says coldly. \"I trust this will not take long?\" <p>\"Depends on how quickly you answer.\"<p>He glares at you for a second, then rolls his eyes. \"Oh, very well. Ask.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=8", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Well, since you asked me, Detective,\" Barr sniffs, \"I would say it was undoubtedly that snivelling little upstart of a gardener.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=8", "\"Doc Parrish. What can you tell me about him?\" you ask.<p>\"Ah, you're referring to that creature that Zoe refers to as her butler,\" Barr says. \"I make it a policy never to interact with people of such low caliber.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "In the Family Room, you find a large and powerfully-muscled woman doing arm-curls with a set of huge barbells. \"You must be Jasmine Gill, the victim's business partner,\" you say, flipping to the relevant page in the dossier.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" she replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Yeah, easy,\" Jasmine says. \"It was Faith's child.\"<p>\"Are you sure?\" you ask.<p>\"Hey buddy, these muscles don't lie.\" She flexes at you to demonstrate... something."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=1", "\"Have you met the victim's child?\" you ask.<p>\"Sure, that's Emma Jefferson,\" Jasmine says. \"She's all right, for a woman with the muscles of a... I dunno, one of those bugs that look like sticks, or something.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=9", "Inside the Living Room, you find a young man in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick his foot to wake him up. \"Uh?\" he says. \"Wha? Oh.\" He stands up, knuckling sleepy, bloodshot eyes. According to the notes the Officers Chaps gave you, this is Ricky Campbell, the victim's child.<p>You show him your badge. \"I'm investigating the murder of Faith Duncan, and I need to ask you some questions.<p>\"Sure, right on,\" he says. \"Ask away, man. Rock it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Dang, dude!\" Ricky says, \"I wondered when you were finally gonna get around to asking that! Like, jeez, right? Listen, it was totes Faith's dental hygienist. Like, for real.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=9", "\"Do you know Duncan's business partner?\" you ask.<p>\"Umm... oh, you mean Destiny MacDonald? I dunno, like, we don't hang out a lot, right, but she's pretty cool. Real casual.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Billiard Room and find an annoyed-looking young woman slouched on a leather sofa with her motorcycle boots propped up on the expensive ebony coffee-table. She gives you a withering look and lights a cigarette. Your dossier identifies her as Brianna Kinney, the victim's sibling.<p>\"I need to ask you some questions about the murder,\" you say.<p>\"I didn't kill anybody, but if I have to hang around this dump any longer, I might,\" she snarls. \"Hurry up and ask me whatever you're gonna ask, so I can get out of here!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Well, I'll tell you this,\" Brianna says, \"if I was you -- and I'm friggin' glad I'm not, hah -- but if I was you I'd look into Faith's best friend.\"<p>\"How about a name?\" you ask.<p>\"How about up yours, cop?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"What can you tell me about Jasmine Gill?\" you ask.<p>\"I can tell you that piece of crap is stinking up the Family Room. You want any more than that, go ask her for yourself.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Dining Room you find a young man deep in thought, staring at the ceiling while tapping his pencil on the page of a leather-bound notebook. Judging from the dossier the Officers Chaps gave you, this must be Kenny Buckner, the victim's lover.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" he says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Well, in my poem I'm attributing the murder to a black shadow wrought from the ghosts of those murdered by capitalism,\" Kenny says. \"Does that help?\"<p>\"Not... particularly.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Kitchen you meet a young man dressed in crisp tennis whites, relaxing and leafing idly through a fashion magazine, apparently without a care in the world. Your dossier identifies him as Saul Payne, the victim's gardener.<p>\"I'd love a spot of tea, if you've got one handy,\" he says, then looks up at you and practically jumps to his feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Abe Shields,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>\"Haven't the foggiest, Detective,\" Saul says. \"Not the slightest idea. Not a tiddle, nor a jot. I could no more tell you the name of Abe's murderer than I could tell you the--\" <p>\"I get it,\" you grumble."));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Servants' Quarters and find an older man in a tweed suit, muttering to himself over a stack of papers. Your dossier identifies him as Jonas Carson, the victim's bodyguard.<p>\"Excuse me,\" you say. \"I'm with the police -- need to ask you a few questions. ...What are you doing?\"<p>\"Grading papers. Although Shields may have escaped his duties for the oblivion of death,\" he says in a clipped Bavarian accent, \"the rest of us still have jobs that require our attention.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"I do not feel that the question of who murdered Abe Shields has true relevance, Detective,\" Carson says. \"All people die. It is only a matter of when.\"<p>\"And how,\" you mutter."));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "In the Wine Cellar, you find a dark-haired young woman sitting quietly, reading a book. She glances briefly at you over the top of her glasses as you enter, but says nothing. \"You must be Angelina Irwin, the victim's neighbor,\" you say, flipping to the relevant page in the dossier.<p>\"I'm from the police, and I'll need to ask you a few questions,\" you say.<p>\"Mm-hmm,\" comes the reply.<p>\"...You're the quiet type, I gather.\"<p>\"Mm-hmm.\"<p>\"Are all your answers going to be like this?\"<p>She turns the page without comment."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>Angelina tilts her head to the side in thought for a moment. \"...Kenny Buckner.\"<p>\"Okay,\" you say. \"And why do you say that?\"<p>Angelina turns a page and goes back to her reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=4", "\"Do you know someone named Kenny Buckner?\" you ask.<p>Angelina shrugs.<p>\"Nothing at all?\"<p>\"He's in the Attic.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Family Room and find an annoyed-looking young man slouched on a leather sofa with his motorcycle boots propped up on the expensive ebony coffee-table. He gives you a withering look and lights a cigarette. \"You must be Lou Cohen, the victim's cousin,\" you say, flipping to the relevant page in the dossier.<p>\"I need to ask you some questions about the murder,\" you say.<p>\"I didn't kill anybody, but if I have to hang around this dump any longer, I might,\" he snarls. \"Hurry up and ask me whatever you're gonna ask, so I can get out of here!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Look, cop -- I don't know who did it, and if I did, I still wouldn't tell you! Get out of my face, already!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Boiler Room, and encounter a young woman -- very young, barely a teenager -- who is creeping around in a half-crouch, inspecting the furniture with a large magnifying glass. Your dossier identifies her as Destiny Curtis, the victim's business partner.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" she says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and her eyes widen when you show her your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" she pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Who do you think the killer is?\" you ask.<p>\"Gosh, Detective!\" Destiny exclaims. \"I sure wish I knew! I've been looking all over for clues, but the bad guy really covered their tracks on this one!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "You walk into the Living Room and meet a woman dressed for an extremely expensive white-tie affair. She looks down her nose regally at you. Judging from the dossier the Officers Chaps gave you, this must be Jessica Gilliam, the victim's chauffeur.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" she says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Naturally I know who it was,\" Gilliam smirks. \"Who in this house is hungrier for elevation from their miserable station than Destiny Curtis?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=7", "\"Are you familiar with someone named Kenny Buckner?\" you ask.<p>\"I do not associate with people of such low breeding and reprehensible moral character, Detective,\" Gilliam says haughtily. \"You may speak to him yourself, if you wish -- he's in the Dining Room.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "When you enter the Pantry, you find a young woman dressed in crisp tennis whites, idly bouncing a tennis ball on a racket and whistling a jaunty little tune. \"You must be Makayla Barron, the victim's chauffeur,\" you say, flipping to the relevant page in the dossier.<p>\"I'd love a spot of tea, if you've got one handy,\" she says, then looks up at you and practically jumps to her feet in surprise. \"Oh, I say! I do beg your pardon, that was dreadfully silly of me -- I thought you were the butler at first.\"<p>\"I'm a detective, investigating the murder of Aubrey White,\" you say. <p>\"Jolly good show! What a dreadful mess this has all been, what?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"You want to know... who do I...?\" Makayla looks flummoxed. \"Sorry, old bean. I can certainly understand why you'd ascribe me a certain Sherlockian intelligence, but I haven't the first clue of who might have done that deed.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Foyer. The woman inside stands to greet you, but her gaze doesn't seem to want to meet your own, flickering around you like a rat sizing up a trap. According to the notes the Officers Chaps gave you, this is Caroline Wiggins, the victim's accountant.<p>\"Good, good,\" she says. \"I'm glad you're here, Officer.\"<p>\"Detective.\"<p>\"Right! Right, of course, Detective, sorry. What a terrible thing that happened, just awful. But I'm sure you'll get to the bottom of it right away, yeah?\"<p>\"Hopefully, yes,\" you say. \"I'd like to ask you a few questions.\"<p>\"Sure, sure! Ask away, Detective, I've got nothin' to hide!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Well I gotta say, Detective, I wasn't expecting such a direct line of questioning,\" Caroline says. \"Tell ya what, I'll give ya a hint: check out Aubrey's gardener.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"The victim's chauffeur -- do you know them?\" you ask.<p>\"Oh sure, that's Makayla Barron,\" she says. \"Me and her, we go way back. Waaay back. Can't say enough good things about her.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Servants' Quarters, you find a young woman in a tie-dye shirt and beanie, lying on the floor snoozing on some scavenged cushions. You kick her foot to wake her up. \"Uh?\" she says. \"Wha? Oh.\" She stands up, knuckling sleepy, bloodshot eyes. According to the dossier, this is Angelina Bates, the victim's housekeeper.<p>\"So uh, what's up man?\" she asks. \"I mean, Officer.\"<p>\"Detective,\" you say, flashing your badge.<p>\"Right on, right on. So what's the skinny?\"<p>\"I need to ask you a few questions.\"<p>\"Okay, sure, yeah. Shoot.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"You wanna know who did it?\" Angelina asks. \"Okay well like, hold onto your hat dude -- it was Todd's gardener! Like crazy, right? Like who would've guessed that? But it so totally was!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=1", "\"The victim's gardener -- do you know them?\" you ask.<p>\"Gardener...\" Angelina muses, then her eyes light up. \"Oh, yeah, dude! I know who you mean. They're cool. Go check out the Basement, you'll find 'em there.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Boiler Room you find a pale, drably-dressed woman slouched on a small chair. She looks up at you as you enter, and sighs pathetically. A quick flip through your suspect dossier reveals this to be Alexandra Golden, the victim's ex-golf caddy.<p>\"Might as well get it over with and put the cuffs on me now,\" she mutters, holding up her wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"I don't have any idea,\" she says, \"but I guarantee if you ask anyone else, they'll all say it was me. That's how it goes around here. I do all the work, and do I get any of the credit? No, don't bother answering, it's a rhetorical question and the answer is perfectly obvious anyway.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Attic, where a bored and angry-looking young man in motorcycle boots and a leather jacket is stomping around and ashing his cigarette on the expensive-looking Turkish carpet. Your dossier identifies him as Vincent Beach, the victim's bodyguard.<p>\"I've got some questions for you,\" you say.<p>\"Good! Great! Ask away!\" he mutters. \"Then maybe I can get out of this dive.\"<p>\"You got somewhere better to be?\"<p>\"If that's the kinda questions you're gonna ask, this is gonna be <i>real</i> fun,\" he says, rolling his eyes."));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "Inside the Basement you find a young woman deep in thought, staring at the ceiling while tapping her pencil on the page of a leather-bound notebook. According to the dossier, this is Emma Burt, the victim's best friend.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Emma sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"It was the grim spectre of guilt, which gripped Todd Ware's heart in the icy talons of--\"<p>\"No metaphors, please.\"<p>\"It was his ex-golf caddy,\" she grumbles."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"What can you tell me about the deceased's housekeeper?\" you ask.<p>\"That barbarian is currently occupying the Living Room,\" Emma says, \"which is why I'm not there myself. One might as well read one's poetry to a pickled eel.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "Inside the Living Room, you discover a young woman, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. \"You must be Ella Dorsey, the victim's boss,\" you say, flipping to the relevant page in the dossier.<p>\"What are you doing?\" you ask her. <p>\"Looking for clues! I'm pretty sure Todd Ware was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" she says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Jeez, Detective!\" Ella pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "In the Ballroom, you find a large and powerfully-muscled man doing arm-curls with a set of huge barbells. \"You must be Jim Maldonado, the victim's dental hygienist,\" you say, flipping to the relevant page in the dossier.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Todd'd had a proper regimen like I told him.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Beats me,\" he mutters. \"If they try and pull that murder stuff on me, though, I'll tie 'em in a knot like a fireplace poker!\"<p>\"...You can do that?\" you ask.<p>\"Yeah! Wanna see?\"<p>\"Yeah, kind of. But later.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "You enter the Pantry. The man inside stands to greet you, but his gaze doesn't seem to want to meet your own, flickering around you like a rat sizing up a trap. According to the notes the Officers Chaps gave you, this is Wade Schultz, the victim's accountant.<p>\"Good, good,\" he says. \"I'm glad you're here, Officer.\"<p>\"Detective.\"<p>\"Right! Right, of course, Detective, sorry. What a terrible thing that happened, just awful. But I'm sure you'll get to the bottom of it right away, yeah?\"<p>\"Hopefully, yes,\" you say. \"I'd like to ask you a few questions.\"<p>\"Sure, sure! Ask away, Detective, I've got nothin' to hide!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Ahh, well now, I'm afraid I can't help ya there, Detective,\" Wade says. \"I was all the way on the other side of the house when it happened, and I didn't hear a thing. Sorry.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=8", "As you enter the Wine Cellar, a wild-eyed woman accosts you, pointing with an outstretched and trembling finger. According to the notes the Officers Chaps gave you, this is Sydney Barton, the victim's neighbor.<p>\"Who are you?!\" she demands. \"Police,\" you reply. \"I need to ask you a few questions about--\"<p>\"And how do I know you're telling the truth? I should just take your word for it? You could be anybody!\"<p>With a sigh, you pull out your badge and show it to her. \"Happy?\"<p>\"And I'm supposed to just trust that that's real? Well... all right. For now. But I've got my eye on you!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=8", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Who did it?\" Sydney asks incredulously. \"Don't you get it? Don't you <i>see?</i> They <i>all</i> did it! They're all in on it together!\"<p>\"In my experience, that's pretty unlikely,\" you say."));
__core_text_test_data.listAppend(listMake("wham.php?visit=9", "You enter the Hall Closet, where a dark-haired young woman in glasses is sitting, deeply focused on a large hardback book; she doesn't look up as you come in. According to the notes the Officers Chaps gave you, this is Lily Butler, the victim's gardener.<p>\"Excuse me,\" you say, \"I'm from the police, and I need to ask you some questions. ...Can you put the book down for a minute?\" She slowly drags her eyes away from the page and regard you impassively. \"Well, it's a start,\" you sigh."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>Lily tilts her head to the side in thought for a moment. \"...Wade Schultz.\"<p>\"Okay,\" you say. \"And why do you say that?\"<p>Lily turns a page and goes back to her reading."));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Boiler Room. The woman inside stands to greet you, but her gaze doesn't seem to want to meet your own, flickering around you like a rat sizing up a trap. Judging from the dossier the Officers Chaps gave you, this must be Addison Lee, the victim's gardener.<p>\"Boy, am I glad to see you!\" she says. \"I just can't believe someone would do this to dear old Savannah. Listen, if there's anything I can do to help, anything at all, you just let me know.\"<p>\"Well,\" you say, \"I would like to ask you some questions.\"<p>\"Questions? Oh, er, right! Yeah, sure, ask away! Always happy to cooperate with the police, that's me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Ahh, well now, I'm afraid I can't help ya there, Detective,\" Addison says. \"I was all the way on the other side of the house when it happened, and I didn't hear a thing. Sorry.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Bar and find an older woman in a tweed suit, muttering to herself over a stack of papers. \"You must be Sydney Kirby, the victim's child,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say, showing your badge. \"Sorry to interrupt your work, but I need to ask you a few questions.<p>\"Good. I am weary of the answers my students have given me,\" she says in a clipped Bavarian accent, \"and so now it will be my turn to give the answers. I shall recognize this as a rare moment of justice in the universe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"I do not feel that the question of who murdered Savannah Hubbard has true relevance, Detective,\" Kirby says. \"All people die. It is only a matter of when.\"<p>\"And how,\" you mutter."));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "The only person in the Laundry Room is a hugely-muscled woman, currently working out with a set of oversized freeweights. According to the notes the Officers Chaps gave you, this is Destiny Bradley, the victim's personal assistant.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" she replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think the killer is?\" you ask.<p>\"Oh yeah,\" Destiny says. I know who it was. It was Simon Jefferson. And if I wasn't so busy with Arm Day, I'd wring that scrawny neck myself.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"What can you tell me about Addison Lee?\" you ask.<p>\"Huh!\" Destiny snorts. \"Yeah, I know her. If you wanna meet the world's biggest wimp, just go to the Boiler Room.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Library, you are greeted by an aristocratic-looking woman dressed for a white-tie occasion. She looks you up and down, and doesn't appear to think much of what she sees. According to the dossier, this is Bella Black, the victim's physician.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask you a few questions.\" <p>\"I am already late for the French Ambassador's gala,\" she  says coldly. \"I trust this will not take long?\" <p>\"Depends on how quickly you answer.\"<p>She glares at you for a second, then rolls her eyes. \"Oh, very well. Ask.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Master Bedroom, you discover a young man, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. Judging from the dossier the Officers Chaps gave you, this must be Giles Gould, the victim's best friend.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" he says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and his eyes widen when you show him your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" he pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Golly!\" Giles exclaims, \"A real-life detective wants to know what I think?\" <p>\"Sure, kid,\" you say. \"What've you got?\"<p>He flips open his notebook and quickly scans the pages. \"I think it's the victim's physician, Detective! It's gotta be!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Bella Black. What can you tell me about her?\" you ask.<p>\"Oh, she's in the Library -- you should check her out <i>very</i> carefully, Detective!\" Giles says. \"I bet the FBI has a rap sheet on her a mile long! Maybe Interpol too!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Bathroom, you discover a young woman, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. Your dossier identifies her as Jasmine Donaldson, the victim's ex-chauffeur.<p>\"What are you doing?\" you ask her. <p>\"Looking for clues! I'm pretty sure Louis Robles was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" she says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"It's just gotta be Randy William, Detective,\" Jasmine says excitedly. \"Means, motive, and opportunity -- just like the Junior Detective's Handbook says!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=2&visit=1", "\"Are you familiar with a man named Randy William?\" you ask.<p>\"Oh sure, Detective! Randy William's great fun!\" Jasmine says. \"He's in the Dining Room right now. He'll probably share his chewing gum with you, if you ask!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Guest Bedroom, you meet a young man, maybe 13 or 14 years old, who is methodically tilting every book in a bookcase, as though trying to find the trigger for a secret door. According to the notes the Officers Chaps gave you, this is Stephen Kirkland, the victim's best friend.<p>\"Looking for clues?\" you ask. <p>\"Yep!\" he says. \"I'm gonna bring that ol' murderer to justice! Say -- are you a real-life police detective?\"<p>\"That's me,\" you say, and his eyes widen when you show him your badge. \"Sorry to spoil your fun, but I need you to stay in here while I investigate.\"<p>\"Aw, gee willikers! Do I have to?\" he pouts."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Jeez, Detective!\" Stephen pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Foyer and encounter a well-to-do-looking young man dressed in crisp tennis whites, lounging casually across an overstuffed chair and flipping playing cards into a straw boater -- or rather, attempting to, and largely missing. Your dossier identifies him as Cal Decker, the victim's housekeeper.<p>\"Excuse me,\" you say, and he looks up at you, surprised. <p>\"Oh, I say! You must be with the police! Jolly good! Frightful business, just dreadful. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"It was Billy Bob's bodyguard, Detective,\" Cal says. \"And that's the honest truth, not a fib to get out of an unpleasant betrothal arrangement, I assure you.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"What can you tell me about the deceased's best friend?\" you ask.<p>\"Oh, that's a rotten one there, Detective,\" Cal says. \"Calls himself 'Kelly Avery', but is that even his legitimate moniker? ... ...Well, yes, probably. Can't quite imagine someone calling themselves 'Kelly Avery' by choice, can you?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "In the Breakfast Nook, you find a large and powerfully-muscled man doing arm-curls with a set of huge barbells. Judging from the dossier the Officers Chaps gave you, this must be Noam Peck, the victim's golf caddy.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Noam grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think the killer is?\" you ask.<p>Noam shakes his head. \"No idea who it was. If they tried that on me, though, I'd tear them in half. Literally. I've been practicing on sides of beef.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "The only person in the Study is an older woman in a tweed suit, slashing at a stack of papers with a red pen. According to the dossier, this is Trinity Gutierrez, the victim's personal assistant.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" she says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"It was Kelly Avery, Detective,\" Gutierrez says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=4", "\"What can you tell me about the deceased's best friend?\" you ask.<p>\"I believe you are speaking of Joey Perkins, Detective,\" Gutierrez says. \"I have nothing to recommend of such a cowardly, beady-eyed vole of a human being.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You walk into the Pantry, which appears to be empty -- until a nervous face appears from behind the sofa. \"You must be Kelly Avery, the victim's chauffeur,\" you say, flipping to the relevant page in the dossier.<p>\"Who are you?!\" he demands. \"Police,\" you reply. \"I need to ask you a few questions about--\"<p>\"And how do I know you're telling the truth? I should just take your word for it? You could be anybody!\"<p>With a sigh, you pull out your badge and show it to him. \"Happy?\"<p>\"And I'm supposed to just trust that that's real? Well... all right. For now. But I've got my eye on you!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"It could be any of them!\" Kelly shouts. \"Any of them, or none of them! It could be outside forces! Or maybe Billy Bob committed suicide, don't you see! To put everyone off the scent!\"<p>\"Well, I've seen the pictures,\" you say, \"and I can pretty much confirm it wasn't a suicide.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You walk into the Family Room, and find a young man wearing a tye-die shirt and a knitted beanie, lazily kicking a hackey-sack around. He looks over at you, surprised, and accidentally kicks the beanbag under an overstuffed chair. \"Aw dangit,\" he says, kneeling down to fish for it. \"I was totes on a roll.\" \"You must be Buck Patterson, the victim's butler,\" you say, flipping to the relevant page in the dossier.<p>\"Uh, hey,\" he says. \"Hi. Yeah. I'm Buck. What's up, man? You solve this thing yet, or what?\"<p>\"I need to ask you a few questions,\" you say, flashing your badge.<p>\"Wow, okay. Heavy. But yeah, sure. Hit me.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Dang, dude!\" Buck says, \"I wondered when you were finally gonna get around to asking that! Like, jeez, right? Listen, it was totes Billy Bob's business partner. Like, for real.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=6", "\"What do you know about Stephen Kirkland?\" you ask.<p>\"Oh jeez, Stephen Kirkland is a total downer,\" he replies. \"Like a primo buzzkill.\"<p>\"I need something more concrete than that.\"<p>\"Right, right. Umm... I think he's Billy Bob's best friend? Can't tell ya much more than that, man.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "When you enter the Guest Bedroom, you find a young woman dressed in crisp tennis whites, idly bouncing a tennis ball on a racket and whistling a jaunty little tune. According to the notes the Officers Chaps gave you, this is Mia Hodge, the victim's gardener.<p>She looks up, and seems rather surprised. \"Hullo! Are you with the police?\" <p>\"That's right,\" you say, shaking her proffered hand. \"I'm the detective in charge of the case. I'll need to ask you a few questions.\" <p>\"Well! By all means, ask away, old chap!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"Who put paid to old Rachel? Well, that's quite a question, isn't it Detective?\" Mia says. \"I mean, it could be bally anyone, and there's quite a quantity of people on this old ball of rock we call Earth.\"<p>\"...We're pretty sure it was someone in this house,\" you say.<p>\"Oh! Well, it was Willard Sosa, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=2&visit=1", "\"Do you know someone named Willard Sosa?\" you ask.<p>\"Oh, that scallywag,\" Mia says. \"He's Rachel's golf caddy, you know -- and a boor, and a bore, and a bounder to boot!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "When you enter the Sunroom, you encounter a young woman wearing a beret and black turtleneck, chewing on the end of her pencil. A quick flip through your suspect dossier reveals this to be Melanie Hill, the victim's housekeeper.<p>\"Excuse me,\" you say. \"I'm from the police, and I need to ask you a few questions.\"<p>\"Hmm,\" she says. \"Questions, questions. ...No, no, that won't do at all.\"<p>\"I beg your pardon?\"<p>\"There's no good rhyme for 'questions', it simply won't fit.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Well, I hate to give away the ending,\" Melanie says, \"but I'm having trouble with that part anyway. What's a good rhyme for 'Isaiah Wong'?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=5&visit=1", "\"What do you know about Isaiah Wong?\" you ask.<p>\"Ah, yes,\" Melanie says, rolling her eyes dramatically. \"The chauffeur. No, that feeble-minded blowhard and I have little in common, Detective. Well, he walks upright, I suppose. Barely.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Master Bedroom and meet a man dressed in cheap knockoff versions of the latest rich peoples' fashions. Judging from the dossier the Officers Chaps gave you, this must be Isaiah Wong, the victim's gardener.<p>\"Hey, what took ya so long?\" he asks. \"Hah, nah, just kiddin' with ya. I know you boys have got a tough job, always had a deep respect for the boys in blue. Anything you wanna know, just ask me -- Isaiah Wong. Nobody knows what's going down around this place like I do.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think the killer is?\" you ask.<p>\"Ahh, well now, I'm afraid I can't help ya there, Detective,\" Isaiah says. \"I was all the way on the other side of the house when it happened, and I didn't hear a thing. Sorry.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "Inside the Bar you find a gray-haired woman reading through a stack of papers, scowling at them with faint disgust. According to the notes the Officers Chaps gave you, this is Aaliyah Diaz, the victim's golf caddy.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" she says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"I do not feel that the question of who murdered Saul Merritt has true relevance, Detective,\" Diaz says. \"All people die. It is only a matter of when.\"<p>\"And how,\" you mutter."));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "As you enter the Pantry, a distinctive smell assaults your sinuses. A young woman wearing a tye-dyed t-shirt and a knitted beanie coughs in surprise, hurriedly stubs out her \"cigarette\" in a potted plant, and moves to open a window. Judging from the dossier the Officers Chaps gave you, this must be Jessica Hudson, the victim's butler.<p>You show her your badge. \"I'm investigating the murder of Saul Merritt, and I need to ask you some questions.<p>\"Sure, right on,\" she says. \"Ask away, man. Rock it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Jeez, man, you got me. ...Ha ha, no wait, that sounded bad. I mean, like, you got me, not you got me, right? Like, I dunno who did it.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "A dark-haired young woman is sitting in the Library, quietly reading a large hardcover book. She doesn't seem to be aware of your presence. \"You must be Aubrey Levy, the victim's physician,\" you say, flipping to the relevant page in the dossier.<p>\"I'm from the police, and I'll need to ask you a few questions,\" you say.<p>\"Mm-hmm,\" comes the reply.<p>\"...You're the quiet type, I gather.\"<p>\"Mm-hmm.\"<p>\"Are all your answers going to be like this?\"<p>She turns the page without comment."));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "When you enter the Dining Room, you find a young woman dressed in crisp tennis whites, idly bouncing a tennis ball on a racket and whistling a jaunty little tune. According to the dossier, this is Brooke Garrett, the victim's accountant.<p>\"Excuse me,\" you say, and she looks up at you, surprised. <p>\"Oh, I say! You must be with the police! Jolly good! Frightful business, just dreadful. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Who put paid to old Saul? Well, that's quite a question, isn't it Detective?\" Brooke says. \"I mean, it could be bally anyone, and there's quite a quantity of people on this old ball of rock we call Earth.\"<p>\"...We're pretty sure it was someone in this house,\" you say.<p>\"Oh! Well, it was Aubrey Levy, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=6", "\"Do you know Merritt's housekeeper?\" you ask.<p>\"Why yes, we get along splendidly,\" Brooke says. \"If we're thinking of the same person, that is. With the um? In the Sunroom? Is that the one?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Library, you discover a young man, about 14 years old, give or take, who appears to be dusting a glass-topped coffee table for prints with a homemade fingerprinting kit. Judging from the dossier the Officers Chaps gave you, this must be Isaiah Holt, the victim's lawyer.<p>\"What are you doing?\" you ask him. <p>\"Looking for clues! I'm pretty sure Douglas Santiago was murdered, and I'm going to track down who did it!\" <p>\"Well, you're right, it was a murder. I'm the detective in charge of the case.\" <p>\"Gosh!\"<p>\"Yeah,\" you say. \"Sorry, but I'm going to have to ask you to stay in this room while I'm investigating.\" <p>\"Aww, gee,\" he says, disappointed. \"Well, that's okay. I bet I can figure it out from here, if I put my mind to it!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Oh, it's definitely the college roommate, Detective!\" Isaiah says. \"I can't prove it, but if you send these hair and fingerprint samples to the police lab...\"<p>\"I'll just take your word for it, kid.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=1", "\"Can you tell me anything about the victim's college roommate? you ask.<p>\"That's Clive Gillespie, Detective,\" Isaiah says, nodding. \"I'm pretty sure he's hiding something, but I guess that doesn't necessarily make him the killer. Lots of people around here have stuff they wanna keep secret.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=5&visit=1", "\"Are you familiar with a man named Clive Gillespie?\" you ask.<p>\"That's Douglas Santiago's college roommate!\" Isaiah says. \"He's really very nice, once you get to know him! Or once you follow him around for a while, peeking out from behind lampposts and stuff.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "Inside the Bathroom you find a young man deep in thought, staring at the ceiling while tapping his pencil on the page of a leather-bound notebook. Judging from the dossier the Officers Chaps gave you, this must be Clive Gillespie, the victim's golf caddy.<p>\"Excuse me,\" you say. \"I'm with the police, and I need to ask--\"<p>\"Ah! Good! A detective!\" he says. \"Please, I require your aid. I simply cannot, for the life of me, think of a decent rhyme for 'murder'.\" <p>\"'Heard her,'\" you reply. \"or 'hurt her'.\"<p>\"Ah! That'll do nicely. And now, <i>quid pro quo</i>: what can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Who killed Douglas?\" Clive asks. \"Why, I haven't the faintest idea. I was rather hoping you could tell me, or else I won't be able to give my poem a proper ending.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Wine Cellar, you find a large and powerfully-muscled man doing arm-curls with a set of huge barbells. \"You must be Vincent Turner, the victim's dental hygienist,\" you say, flipping to the relevant page in the dossier.<p>\"I'm going to need to ask you a few questions,\" you say. <p>\"Yeah, okay,\" he replies. \"S'alright if I keep lifting? It's arm day. Can't slack on arm day.\"<p>\"Err, no, go right ahead.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Oh ho!\" Vincent exclaims. \"If you're asking me, then you must recognize my power!\"<p>\"I... what?\"<p>\"It was Franklin Jacobs. As plain as these sick pecs!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Do you know someone by the name of Isaiah Holt?\" you ask.<p>\"Sure! Isaiah Holt's a good friend. We play games all the time,\" he replies. <p>\"Games?\"<p>\"Yeah, he beats me at chess, and then I beat him at leg-wrestling. He's in the Library if you want to meet him.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Living Room, a wild-eyed woman accosts you, pointing with an outstretched and trembling finger. According to the notes the Officers Chaps gave you, this is Audrey Valencia, the victim's butler.<p>\"Who are you?!\" she demands. \"Police,\" you reply. \"I need to ask you a few questions about--\"<p>\"And how do I know you're telling the truth? I should just take your word for it? You could be anybody!\"<p>With a sigh, you pull out your badge and show it to her. \"Happy?\"<p>\"And I'm supposed to just trust that that's real? Well... all right. For now. But I've got my eye on you!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Tell you who did it?\" she says. \"I don't trust you as far as I could throw a space-communications relay tower disguised as the Washington Monument! Why would I tell you?\"<p>\"Well, if you don't know, just say so,\" you shrug. <p>\"Of course I know! They don't get anything past me! It was Ricky Valencia!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=2&visit=1", "\"What do you know about Ricky Valencia?\" you ask.<p>\"What, are you kidding me?\" Audrey exclaims. \"Giles's physician? He's one of the most suspicious of the bunch! I've seen the way he watches me!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Living Room and meet a man dressed in cheap knockoff versions of the latest rich peoples' fashions. A quick flip through your suspect dossier reveals this to be Travis Brennan, the victim's child.<p>\"Boy, am I glad to see you!\" he says. \"I just can't believe someone would do this to dear old Avery. Listen, if there's anything I can do to help, anything at all, you just let me know.\"<p>\"Well,\" you say, \"I would like to ask you some questions.\"<p>\"Questions? Oh, er, right! Yeah, sure, ask away! Always happy to cooperate with the police, that's me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Nah, 'fraid I can't help ya there, Detective,\" Travis says. \"I mean, I <i>know</i>, and I'll absolutely tell ya anything <i>else</i> ya wanna know, but my rep'll take a real dive if people think I'm a rat, you know what I'm sayin'?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "The only person in the Basement is a hugely-muscled woman, currently working out with a set of oversized freeweights. Your dossier identifies her as Addison Weeks, the victim's gardener.<p>\"Is this your usual spot for training?\" you ask, looking around. \"Kind of an unusual choice.\"<p>\"Yeah, well,\" Addison grunts, \"With all this stuff going on, I couldn't leave to go to my usual gym, right? Good thing I carry a set of weights around for emergencies.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Nah, sorry,\" she says. \"No idea. I was blastin' my delts at the time, so I didn't notice anything unusual.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "A dark-haired young man is sitting in the Ballroom, quietly reading a large hardcover book. He doesn't seem to be aware of your presence. According to the dossier, this is James Burnett, the victim's sibling.<p>\"Excuse me,\" you say, \"I'm from the police, and I need to ask you some questions. ...Can you put the book down for a minute?\" He slowly drags his eyes away from the page and regard you impassively. \"Well, it's a start,\" you sigh."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"It was the lawyer,\" James mutters from behind his book.<p>\"Do you have some kind of evidence for that?\" you ask.<p>No response."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"The victim had a child, do you know them?\" you ask.<p>James grimaces and turns a page. \"Ugh.\"<p>\"Can you tell me anything about them at all?\"<p>\"Name's Travis Brennan.\"<p>\"...That's it, huh?\"<p>\"Mm-hmm.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "Inside the Sunroom you find a young woman deep in thought, staring at the ceiling while tapping her pencil on the page of a leather-bound notebook. According to the notes the Officers Chaps gave you, this is Kimberly Sampson, the victim's cousin.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Kimberly sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"I think it was probably either a raven, or a metaphor for the tyranny of social expectations,\" Kimberly says. <p>\"Well thanks,\" you say dryly. \"I'll be sure to put an APB out on both of those things.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "In the Laundry Room you find a pale, drably-dressed man slouched on a small chair. He looks up at you as you enter, and sighs pathetically. According to the dossier, this is Bert Irwin, the victim's lawyer.<p>\"It's just one more thing after another, isn't it?\" he mutters bitterly. \"It always rains, and it always pours.\"<p>\"Well, I can see <i>you're</i> going to be a real barrel of laughs,\" you say."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Who killed Conway Warner? You're asking me? Why not ask me something I know the answer to, like who's supposed to clean the toilets around here. The answer to that is not, in fact, me, but guess what? I end up having to do it anyway.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Ballroom and meet a woman dressed in cheap knockoff versions of the latest rich peoples' fashions. A quick flip through your suspect dossier reveals this to be Amelia McBride, the victim's golf caddy.<p>\"Hey, what took ya so long?\" she asks. \"Hah, nah, just kiddin' with ya. I know you boys have got a tough job, always had a deep respect for the boys in blue. Anything you wanna know, just ask me -- Amelia McBride. Nobody knows what's going down around this place like I do.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think the killer is?\" you ask.<p>\"Ahh, well now, I'm afraid I can't help ya there, Detective,\" Amelia says. \"I was all the way on the other side of the house when it happened, and I didn't hear a thing. Sorry.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "In the Bathroom, you find a large and powerfully-muscled man doing arm-curls with a set of huge barbells. \"You must be Todd House, the victim's neighbor,\" you say, flipping to the relevant page in the dossier.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Conway'd had a proper regimen like I told him.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Sure, I know who it was,\" Todd says. \"Nothing gets past <i>these</i> muscles!\"<p>\"I... don't know what that means, but who?\" you ask. <p>\"Morgan Charles. Can you believe it? A skinny twig like that?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=4", "\"Do you know Kimberly Sampson?\" you ask.<p>\"Pfft, yeah, I know Kimberly Sampson,\" Todd says. \"You'll find her in the Sunroom, if a stiff breeze hasn't carried her away, hah!\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Breakfast Nook and meet a woman dressed in cheap knockoff versions of the latest rich peoples' fashions. Judging from the dossier the Officers Chaps gave you, this must be Brooklyn Leach, the victim's boss.<p>\"Boy, am I glad to see you!\" she says. \"I just can't believe someone would do this to dear old Savannah. Listen, if there's anything I can do to help, anything at all, you just let me know.\"<p>\"Well,\" you say, \"I would like to ask you some questions.\"<p>\"Questions? Oh, er, right! Yeah, sure, ask away! Always happy to cooperate with the police, that's me!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Ahh, well now, I'm afraid I can't help ya there, Detective,\" Brooklyn says. \"I was all the way on the other side of the house when it happened, and I didn't hear a thing. Sorry.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Ballroom and find an older man in a tweed suit, muttering to himself over a stack of papers. Judging from the dossier the Officers Chaps gave you, this must be Pete Lopez, the victim's butler.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" he says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"It is not difficult to see who in this house has the soul of a killer, Detective,\" Lopez says. \"The desperate eyes, the hunger, the growl of an animal. No human who would take a life can truly hide these things.\" <p>\"Great. Okay. So...?\"<p>\"Leah Mercado.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Do you know someone named Brooklyn Leach?\" you ask.<p>\"Mmm. You will find her in the Master Bedroom,\" Lopez says. \"I must warn you, Detective, that she has little regard for the truth.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "In the Lounge you find a pale, drably-dressed woman slouched on a small chair. She looks up at you as you enter, and sighs pathetically. A quick flip through your suspect dossier reveals this to be Leah Mercado, the victim's best friend.<p>\"Great, here we go,\" she says morosely. \"You'll probably put the blame for this on me, same as everyone always does when anything goes wrong around here.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"It was Savannah's butler,\" Leah says. \"Does it make you happy to know that? If it does, please let me know, because having never experienced that emotion myself, it's difficult for me to detect it in others.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know someone named Brooklyn Leach?\" you ask.<p>\"I know she's in the Breakfast Nook. And that she hates me. Fair's fair, I don't like her much either. Or myself, come to think of it. So we've got that much in common, at least.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "As you enter the Guest Bedroom, you are greeted by an aristocratic-looking man dressed for a white-tie occasion. He looks you up and down, and doesn't appear to think much of what he sees. According to the dossier, this is Dale Puckett, the victim's cousin.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" he says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Naturally I know who it was,\" Puckett smirks. \"Who in this house is hungrier for elevation from their miserable station than James Tillman?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=1", "\"Do you know someone by the name of James Tillman?\" you ask.<p>\"Hmph!\" he snorts. \"I don't know why you would take an interest in that rude little nobody, Detective. If you wish to lower yourself even further by actually speaking with him, he is in the Family Room.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=1", "You enter the Hall Closet, and find a man dressed in a shapeless gray suit, slouched on a chair and staring at his feet. A quick flip through your suspect dossier reveals this to be Bert Calderon, the victim's bodyguard.<p>\"Might as well get it over with and put the cuffs on me now,\" he mutters, holding up his wrists.<p>\"Is this a confession?\" you frown.<p>\"No. I didn't do anything. But I never do anything, and I get blamed for it anyway. It's just how it goes. I'm used to it.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Yeah, it's not enough that I have to do everything else around here, I might as well solve the murder for the detective too,\" Bert grumbles. \"It was Mia Shaffer. There. Happy?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=1", "\"Are you familiar with someone named Mia Shaffer?\" you ask.<p>\"I know she's in the Servants' Quarters. And that she hates me. Fair's fair, I don't like her much either. Or myself, come to think of it. So we've got that much in common, at least.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=2", "You enter the Servants' Quarters, and discover an extremely muscular woman lifting weights and glistening with sweat. According to the notes the Officers Chaps gave you, this is Gabriella Whitfield, the victim's child.<p>\"I need to ask you a few questions about the murder,\" you say. <p>\"Real shame. Wouldn'ta happened if Jack'd had a proper regimen like I told him.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>Gabriella shakes her head. \"No idea who it was. If they tried that on me, though, I'd tear them in half. Literally. I've been practicing on sides of beef.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=3", "You enter the Wine Cellar and encounter a well-to-do-looking young woman dressed in crisp tennis whites, lounging casually across an overstuffed chair and flipping playing cards into a straw boater -- or rather, attempting to, and largely missing. Your dossier identifies her as Sarah Bryan, the victim's dental hygienist.<p>\"Excuse me,\" you say, and she looks up at you, surprised. <p>\"Oh, I say! You must be with the police! Jolly good! Frightful business, just dreadful. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think the killer is?\" you ask.<p>\"You want to know... who do I...?\" Sarah looks flummoxed. \"Sorry, old bean. I can certainly understand why you'd ascribe me a certain Sherlockian intelligence, but I haven't the first clue of who might have done that deed.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=4", "As you enter the Game Room, a small nervous-looking woman spins around with a startled look. According to the notes the Officers Chaps gave you, this is Trinity Price, the victim's ex-cousin.<p>\"Who are you?!\" she demands. \"Police,\" you reply. \"I need to ask you a few questions about--\"<p>\"And how do I know you're telling the truth? I should just take your word for it? You could be anybody!\"<p>With a sigh, you pull out your badge and show it to her. \"Happy?\"<p>\"And I'm supposed to just trust that that's real? Well... all right. For now. But I've got my eye on you!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"If I knew that, I wouldn't be out of my mind with fear!\" Trinity exclaims. \"It could be any of them! <i>Any of them!!</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=5", "You enter the Guest Bedroom and find an older man in a tweed suit, muttering to himself over a stack of papers. A quick flip through your suspect dossier reveals this to be Kelly Park, the victim's lover.<p>\"I'm a police detective,\" you say, showing your badge, \"and I'll need to ask you some questions.\" <p>\"Very well. The foolishness of my students is threatening to overwhelm me,\" he says in a clipped Bavarian accent, \"and so perhaps it would be advantageous to take a break. What can I do for you?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"I do not feel that the question of who murdered Jack Little has true relevance, Detective,\" Park says. \"All people die. It is only a matter of when.\"<p>\"And how,\" you mutter."));
__core_text_test_data.listAppend(listMake("wham.php?visit=6", "You enter the Pantry. The woman inside stands to greet you, but her gaze doesn't seem to want to meet your own, flickering around you like a rat sizing up a trap. Your dossier identifies her as Arianna Rodriquez, the victim's golf caddy.<p>\"Hey, what took ya so long?\" she asks. \"Hah, nah, just kiddin' with ya. I know you boys have got a tough job, always had a deep respect for the boys in blue. Anything you wanna know, just ask me -- Arianna Rodriquez. Nobody knows what's going down around this place like I do.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=6", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Nah, 'fraid I can't help ya there, Detective,\" Arianna says. \"I mean, I <i>know</i>, and I'll absolutely tell ya anything <i>else</i> ya wanna know, but my rep'll take a real dive if people think I'm a rat, you know what I'm sayin'?\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=7", "You enter the Basement and encounter a woman dressed in very expensive-looking formal attire. She regards you with a look of distaste and disdain. \"You must be Addison Alvarez, the victim's accountant,\" you say, flipping to the relevant page in the dossier.<p>\"Sorry to keep you waiting,\" you say, \"but I need to ask you a few questions.\"<p>\"Do you know who I am, Detective?\" she says with an icy stare. <p>\"Yes, and I'm sure you have more important things to do. As soon as you answer my questions, you can get on with whatever they are.\"<p>\"...Very well.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Well, since you asked me, Detective,\" Alvarez sniffs, \"I would say it was undoubtedly that snivelling little upstart of an ex-cousin.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=8", "Inside the Ballroom you find a young woman deep in thought, staring at the ceiling while tapping her pencil on the page of a leather-bound notebook. \"You must be Mia Shaffer, the victim's physician,\" you say, flipping to the relevant page in the dossier.<p>\"Excuse me,\" you say. \"I need to ask you a few--\" <p>\"One moment, please. I am in the middle of my magnum opus! I just require a suitable rhyme for 'lethal'.\"<p>\"This can't wait, I'm afraid,\" you growl, showing your badge. <p>Mia sighs theatrically. \"Very well. Ask away, then.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=8", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"It was the grim spectre of guilt, which gripped Jack Little's heart in the icy talons of--\"<p>\"No metaphors, please.\"<p>\"It was his accountant,\" she grumbles."));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=8", "\"Have you met the victim's bodyguard?\" you ask.<p>\"I'll have nothing to do with that savage in the Game Room,\" Mia says. \"Not until they apologize for comparing my 'Opus XXVII' to Smash Mouth lyrics.\""));
__core_text_test_data.listAppend(listMake("wham.php?visit=9", "A dark-haired young man is sitting in the Breakfast Nook, quietly reading a large hardcover book. He doesn't seem to be aware of your presence. Judging from the dossier the Officers Chaps gave you, this must be Patrick Hodges, the victim's sibling.<p>\"Excuse me,\" you say, \"I'm from the police, and I need to ask you some questions. ...Can you put the book down for a minute?\" He slowly drags his eyes away from the page and regard you impassively. \"Well, it's a start,\" you sigh."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=9", "\"Who do you think the killer is?\" you ask.<p>\"Hmm.\" After a long pause, he mutters, \"Probably Trinity Price.\"<p>\"Do you have any evidence to back that up?\"<p>He glances up at you, then turns a page and keeps reading."));

}

addTestStrings();