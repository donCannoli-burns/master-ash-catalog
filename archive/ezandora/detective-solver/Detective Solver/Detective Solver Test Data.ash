__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Yeah, well... normally I wouldn't talk to a cop,\" he says, \"but I am sick to death of sitting around here. So I'll tell you: it was Addison Chapman. Can I friggin' go now?\"<p>\"I'll let you know,\" you say.<p><i>\"Frig!\"</i> Toby says, throwing his hands in the air exasperatedly. \"I'm gonna be stuck here all frickin' <i>night!</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Cuttin' right to the chase, huh?\" Toby says. \"Well, since you ask so friggin' nice and all -- it was Addison Chapman. Whaddya think of that?\" <p>You write the name down without replying."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think the killer is?\" you ask.<p>\"Yeah, well... normally I wouldn't talk to a cop,\" he says, \"but I am sick to death of sitting around here. So I'll tell you: it was Addison Chapman. Can I friggin' go now?\"<p>\"I'll let you know,\" you say.<p><i>\"Frig!\"</i> Toby says, throwing his hands in the air exasperatedly. \"I'm gonna be stuck here all frickin' <i>night!</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Yeah, well... normally I wouldn't talk to a cop,\" he says, \"but I am sick to death of sitting around here. So I'll tell you: it was Addison Chapman. Can I friggin' go now?\"<p>\"I'll let you know,\" you say.<p><i>\"Frig!\"</i> Toby says, throwing his hands in the air exasperatedly. \"I'm gonna be stuck here all frickin' <i>night!</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Cuttin' right to the chase, huh?\" Toby says. \"Well, since you ask so friggin' nice and all -- it was Addison Chapman. Whaddya think of that?\" <p>You write the name down without replying."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=3", "\"Who do you think the killer is?\" you ask.<p>\"Yeah, fine, okay. You wanna know who did it? It was Addison Chapman. You happy now?\"<p>\"We'll see,\" you say, writing it down in your notebook."));
