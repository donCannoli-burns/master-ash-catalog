__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Investigate the bodyguard,\" Maria mutters quietly.<p>\"All right,\" you say. \"Can you tell me anything more concrete?\"<p>\"No.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Do you have any thoughts on who did it?\" you ask.<p>Maria turns a page in her book. \"I think it was the bodyguard.\"<p>\"Okay,\" you say, writing it down. \"Why do you say that? ...Hello?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>Maria turns a page in her book. \"I think it was the bodyguard.\"<p>\"Okay,\" you say, writing it down. \"Why do you say that? ...Hello?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"It was the bodyguard,\" Maria mutters from behind her book.<p>\"Do you have some kind of evidence for that?\" you ask.<p>No response."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Investigate the bodyguard,\" Maria mutters quietly.<p>\"All right,\" you say. \"Can you tell me anything more concrete?\"<p>\"No.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=7", "\"Who do you think the killer is?\" you ask.<p>\"It was the bodyguard,\" Maria mutters from behind her book.<p>\"Do you have some kind of evidence for that?\" you ask.<p>No response."));
