__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=4", "\"Can you tell me anything about the victim's college roommate? you ask.<p>\"Oh, you mean Serenity Hanson. she's all right. Can't tell you much about her, though.\"<p>\"Do you mean can't, or won't?\" you ask.<p>\"What I mean is: get bent, cop!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=4", "\"Are you familiar with someone named Doc McPherson?\" you ask.<p>\"Yeah, I know Doc McPherson. He's Morgan's physician. Or was, I guess. He's okay. I never had any trouble with him.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=4", "\"Have you met the victim's college roommate?\" you ask.<p>\"Oh, you mean Serenity Hanson. she's all right. Can't tell you much about her, though.\"<p>\"Do you mean can't, or won't?\" you ask.<p>\"What I mean is: get bent, cop!\""));
