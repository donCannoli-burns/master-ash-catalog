__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"It was Sophia Hopkins, Detective,\" Day says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"It was Sophia Hopkins, Detective,\" Day says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"It is not difficult to see who in this house has the soul of a killer, Detective,\" Day says. \"The desperate eyes, the hunger, the growl of an animal. No human who would take a life can truly hide these things.\" <p>\"Great. Okay. So...?\"<p>\"Sophia Hopkins.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Do you not already know, Detective?\" Day asks. \"You need only ask yourself, who among these people is so ruled by fear that they would take the life of another in order to prolong their own existence, miserable though it may be?\" <p>\"...Just answer the question, please?\"<p>\"Sophia Hopkins.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>\"Do you not already know, Detective?\" Day asks. \"You need only ask yourself, who among these people is so ruled by fear that they would take the life of another in order to prolong their own existence, miserable though it may be?\" <p>\"...Just answer the question, please?\"<p>\"Sophia Hopkins.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"It is not difficult to see who in this house has the soul of a killer, Detective,\" Day says. \"The desperate eyes, the hunger, the growl of an animal. No human who would take a life can truly hide these things.\" <p>\"Great. Okay. So...?\"<p>\"Sophia Hopkins.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"It is not difficult to see who in this house has the soul of a killer, Detective,\" Day says. \"The desperate eyes, the hunger, the growl of an animal. No human who would take a life can truly hide these things.\" <p>\"Great. Okay. So...?\"<p>\"Sophia Hopkins.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>\"It was Sophia Hopkins, Detective,\" Day says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Do you not already know, Detective?\" Day asks. \"You need only ask yourself, who among these people is so ruled by fear that they would take the life of another in order to prolong their own existence, miserable though it may be?\" <p>\"...Just answer the question, please?\"<p>\"Sophia Hopkins.\""));
