__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Yeah, well... normally I wouldn't talk to a cop,\" she says, \"but I am sick to death of sitting around here. So I'll tell you: it was Serenity Rowe. Can I friggin' go now?\"<p>\"I'll let you know,\" you say.<p><i>\"Frig!\"</i> Claire says, throwing her hands in the air exasperatedly. \"I'm gonna be stuck here all frickin' <i>night!</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Yeah, well... normally I wouldn't talk to a cop,\" she says, \"but I am sick to death of sitting around here. So I'll tell you: it was Serenity Rowe. Can I friggin' go now?\"<p>\"I'll let you know,\" you say.<p><i>\"Frig!\"</i> Claire says, throwing her hands in the air exasperatedly. \"I'm gonna be stuck here all frickin' <i>night!</i>\""));
