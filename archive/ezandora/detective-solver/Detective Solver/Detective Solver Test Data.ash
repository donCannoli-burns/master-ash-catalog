__core_text_test_data.listAppend(listMake("wham.php?ask=2&visit=9", "\"Do you know someone named Grace Heath?\" you ask.<p>\"That's Edgar's college roommate,\" Ariana says. \"She's all right. Never inflicted actual physical harm on me.\"<p>\"Err... do the others?\" you ask.<p>\"Well, no. But they'd like to. I can tell.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=2&visit=9", "\"Can you tell me anything about the victim's college roommate? you ask.<p>\"Oh, she's great. Just great,\" Ariana says. \"Everyone loves Grace Heath.\"<p>\"...I can't tell if you're being sarcastic.\"<p>\"Yeah, me neither,\" she sighs."));
__core_text_test_data.listAppend(listMake("wham.php?ask=2&visit=9", "\"What can you tell me about Grace Heath?\" you ask.<p>\"I know Grace Heath, yeah,\" she says. \"She's Edgar's college roommate. I get less verbal abuse from her than from the others. Which is nice of her.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=2&visit=9", "\"Have you met the victim's college roommate?\" you ask.<p>\"Oh, she's great. Just great,\" Ariana says. \"Everyone loves Grace Heath.\"<p>\"...I can't tell if you're being sarcastic.\"<p>\"Yeah, me neither,\" she sighs."));
