__core_text_test_data.listAppend(listMake("wham.php?ask=5&visit=8", "\"Are you familiar with a woman named Natalie Mercado?\" you ask.<p>\"Ah yes,\" Barnett says. \"You will find her in the Dining Room, Detective. We have participated in friendly debate on occasion. Her views regarding the human condition are unorthodox, but intriguing.\""));
