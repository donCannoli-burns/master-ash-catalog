__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=4", "\"Do you know Addison Franks?\" you ask.<p>\"You are referring to Victor Sellers's business partner, I believe,\" Zamora says. \"A woman of small mind, with no dreams or imagination. She might as well be an iguana.\""));
