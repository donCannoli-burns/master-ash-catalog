__core_text_test_data.listAppend(listMake("wham.php?ask=3&visit=1", "\"What do you know about Toby Pena?\" you ask.<p>He scowls. \"The sibling.\"<p>\"Anything else you can tell me?\"<p>\"Hmph.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=3&visit=1", "\"I understand the victim had a sibling,\" you say. \"Can you tell me anything about them?\"<p><p>\"Toby Pena. We don't talk.\"<p>\"Do you actually talk to anyone?\"<p>He turns a page and doesn't reply."));
__core_text_test_data.listAppend(listMake("wham.php?ask=3&visit=1", "\"What do you know about Toby Pena?\" you ask.<p>Oliver frowns. \"Wish I didn't know him. Marlon's sibling.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=3&visit=1", "\"What can you tell me about the deceased's sibling?\" you ask.<p>\"Don't really know him. Name's Toby Pena.\"<p>\"Can you tell me anything at all about him?\"<p>\"He's awful.\"<p>\"...Anything else?\"<p>\"No.\""));
