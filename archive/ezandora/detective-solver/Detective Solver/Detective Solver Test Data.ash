__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=1", "\"Do you know someone named Harold Phillips?\" you ask.<p>\"Well, there's nothing like a good friend, Detective,\" Frederick says, \"and that creature currently residing within the Smoking Lounge is nothing like a good friend!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=1", "\"The victim had a child, do you know them?\" you ask.<p>\"As concerns the individual currently occupying the Boiler Room, Detective,\" Frederick says, \"allow me to say one word: <i>balderdash.</i>\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=1", "\"Are you familiar with a man named Harold Phillips?\" you ask.<p>\"I stay bloody well away from that character, Detective,\" Frederick says, \"if you'll excuse the 'bloody'. Could set your hat alight with a glare, he could. He's in the Smoking Lounge, go see for yourself!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=1", "\"The victim had a child, do you know them?\" you ask.<p>\"I'm afraid I could no more stand to be in the Boiler Room with that person than a snowman could stand to vacation within a fizzing volcano, Detective,\" Frederick declares."));
__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=1", "\"Do you know someone by the name of Harold Phillips?\" you ask.<p>\"Well, there's nothing like a good friend, Detective,\" Frederick says, \"and that creature currently residing within the Smoking Lounge is nothing like a good friend!\""));
