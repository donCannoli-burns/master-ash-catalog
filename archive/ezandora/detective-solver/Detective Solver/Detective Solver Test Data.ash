__core_text_test_data.listAppend(listMake("wham.php?ask=2&visit=5", "\"Are you familiar with someone named Grace Heath?\" you ask.<p>\"Ah yes,\" Grimes says. \"You will find her in the Basement, Detective. We have participated in friendly debate on occasion. Her views regarding the human condition are unorthodox, but intriguing.\""));
