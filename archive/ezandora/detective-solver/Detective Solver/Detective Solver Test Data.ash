__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=8&visit=5", "\"Have you met the victim's child?\" you ask.<p>\"They're in the Wine Cellar.\"<p>\"Any opinion on them?\"<p>Shrug. \"Seems okay.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=5", "\"Are you familiar with someone named John Bell?\" you ask.<p>Gabrielle sniffs disdainfully. \"Foyer.\"<p>\"...Anything else?\"<p>\"He's a jerk.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=5", "\"Do you know Salinas's ex-butler?\" you ask.<p>\"No.\"<p>\"Nothing at all?\"<p>\"Try the Servants' Quarters.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=5", "\"Are you familiar with someone named John Bell?\" you ask.<p>\"I have nothing good to say about him.\"<p>\"At this point,\" you growl, \"I would be delighted to get any kind of information at all out of you.\"<p>\"He's in the Foyer.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=5", "\"Can you tell me anything about Clyde Salinas's ex-butler?\" you ask.<p>\"They're in the Servants' Quarters.\"<p>\"And that's all you're going to say?\"<p>\"Mm-hmm.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=5", "\"Do you know John Bell?\" you ask.<p>\"He's a jackass,\" Gabrielle replies, \"and he's in the Foyer.\"<p>\"Good lord. Don't wear yourself out, saying that many words all at once.\"<p>\"Mm-hmm.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=5", "\"What can you tell me about the deceased's ex-butler?\" you ask.<p>\"Met them once.\"<p>\"And?\"<p>\"And they're in the Servants' Quarters if you want to try it yourself.\""));
