__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Oh, well,\" Zachary says, \"I mean, I haven't quite finished my poem yet, and I wouldn't like to spoil the dramatic reveal for you, but I could read you what I have so far and...\"<p>\"Just the name, please.\"<p>\"It was Madeline Guzman,\" he says dourly."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Hmm, well,\" Zachary muses, \"I suppose it does make for a more satisfying conclusion to my poem if you actually apprehend the criminal. Very well, it was Madeline Guzman.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Hmm, well,\" Zachary muses, \"I suppose it does make for a more satisfying conclusion to my poem if you actually apprehend the criminal. Very well, it was Madeline Guzman.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Who do you think the killer is?\" you ask.<p>\"Well, I hate to give away the ending,\" Zachary says, \"but I'm having trouble with that part anyway. What's a good rhyme for 'Madeline Guzman'?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=4", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Oh, well,\" Zachary says, \"I mean, I haven't quite finished my poem yet, and I wouldn't like to spoil the dramatic reveal for you, but I could read you what I have so far and...\"<p>\"Just the name, please.\"<p>\"It was Madeline Guzman,\" he says dourly."));
