__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=7", "\"What do you know about Gavin Norton?\" you ask.<p>\"Gavin Norton?\" he muses. \"I don't think I know anyone by that name... oh, are you referring to Grant's personal assistant? Ha ha, no, I do not associate with him.\""));
