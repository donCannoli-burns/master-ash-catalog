__core_text_test_data.listAppend(listMake("wham.php?ask=2&visit=3", "\"Do you know someone named Riff Byers?\" you ask.<p>\"I have nothing good to say about him.\"<p>\"At this point,\" you growl, \"I would be delighted to get any kind of information at all out of you.\"<p>\"He's in the Servants' Quarters.\""));
