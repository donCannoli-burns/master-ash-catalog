__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=1", "\"Who do you think the killer is?\" you ask.<p>\"Jeez, Detective!\" Chuck pouts. \"If you hadn't ordered me to stay in here, maybe I'd be able to tell you! How about I just follow you around, I promise I won't get in the way!\" <p>\"No,\" you say. \"Stay here.\"<p>\"Well, phooey! You're no fun at all!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Do you know someone named Chuck Todd?\" you ask.<p>\"You are referring to Douglas Buckner's chauffeur, I believe,\" Byers says. \"A man of small mind, with no dreams or imagination. He might as well be an iguana.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"What can you tell me about the deceased's housekeeper?\" you ask.<p>\"You are referring to Buck Wallace, I presume,\" Byers says. \"He is a petulant child, demanding candy from a universe that does not listen.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Chuck Todd. What can you tell me about him?\" you ask.<p>\"You are referring to Douglas Buckner's chauffeur, I believe,\" Byers says. \"A man of small mind, with no dreams or imagination. He might as well be an iguana.\""));
