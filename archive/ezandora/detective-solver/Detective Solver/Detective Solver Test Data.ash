__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=2", "\"Do you know someone named Perry Roman?\" you ask.<p>\"He's Sophie's lover, and an absolute philistine,\" Merle scowls. <p>\"Doesn't like your poetry, eh?\"<p>\"He tore up my favorite sonnet about mushrooms!\"<p>\"Well, everybody's a critic.\""));
