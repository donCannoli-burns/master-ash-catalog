__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=9", "\"What can you tell me about Makayla Hubbard?\" you ask.<p>\"Grant's golf caddy and I have a very cordial relationship,\" he says. \"She has essentially no understanding of the poetic form, poor soul, but she does the best she can.\""));
