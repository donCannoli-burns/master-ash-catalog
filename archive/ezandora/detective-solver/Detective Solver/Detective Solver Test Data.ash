__core_text_test_data.listAppend(listMake("wham.php?ask=7&visit=6", "\"Do you know someone by the name of Anna Byrd?\" you ask.<p>\"Hmph!\" he snorts. \"I don't know why you would take an interest in that rude little nobody, Detective. If you wish to lower yourself even further by actually speaking with her, she is in the Bathroom.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=7&visit=6", "\"Do you know Gross's business partner?\" you ask.<p>\"I know of that person, but have never found it necessary to interact with them,\" he sniffs. \"I believe they're in the Lounge at the moment.\""));
