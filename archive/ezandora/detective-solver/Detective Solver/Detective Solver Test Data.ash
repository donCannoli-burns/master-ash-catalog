__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=2", "\"Have you met the victim's cousin?\" you ask.<p><p>\"Todd Nelson. We don't talk.\"<p>\"Do you actually talk to anyone?\"<p>He turns a page and doesn't reply."));
__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=2", "\"Do you know Todd Nelson?\" you ask.<p>Jake sniffs disdainfully. \"Study.\"<p>\"...Anything else?\"<p>\"He's a jerk.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=2", "\"What can you tell me about the deceased's cousin?\" you ask.<p>\"Don't really know him. Name's Todd Nelson.\"<p>\"Can you tell me anything at all about him?\"<p>\"He's awful.\"<p>\"...Anything else?\"<p>\"No.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=2", "\"Do you know someone by the name of Todd Nelson?\" you ask.<p>\"I have nothing good to say about him.\"<p>\"At this point,\" you growl, \"I would be delighted to get any kind of information at all out of you.\"<p>\"He's in the Study.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=2", "\"The victim had a cousin, do you know them?\" you ask.<p>\"Don't really know him. Name's Todd Nelson.\"<p>\"Can you tell me anything at all about him?\"<p>\"He's awful.\"<p>\"...Anything else?\"<p>\"No.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"It was the cousin,\" Jake mutters from behind his book.<p>\"Do you have some kind of evidence for that?\" you ask.<p>No response."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>Jake turns a page in his book. \"I think it was the cousin.\"<p>\"Okay,\" you say, writing it down. \"Why do you say that? ...Hello?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Investigate the cousin,\" Jake mutters quietly.<p>\"All right,\" you say. \"Can you tell me anything more concrete?\"<p>\"No.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>Jake turns a page in his book. \"I think it was the cousin.\"<p>\"Okay,\" you say, writing it down. \"Why do you say that? ...Hello?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>Jake turns a page in his book. \"I think it was the cousin.\"<p>\"Okay,\" you say, writing it down. \"Why do you say that? ...Hello?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"It was the cousin,\" Jake mutters from behind his book.<p>\"Do you have some kind of evidence for that?\" you ask.<p>No response."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>Jake turns a page in his book. \"I think it was the cousin.\"<p>\"Okay,\" you say, writing it down. \"Why do you say that? ...Hello?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know someone named Audrey Hunt?\" you ask.<p>\"No way, I keep as far away from her as I possibly can,\" he says. \"I don't even go near the Sunroom, because she has it all wired up with recording devices. She's in there now, probably copying the tapes! Go and see!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Can you tell me anything about Lily Barrett's child?\" you ask.<p>\"No! No, never!\" Mickey says, alarmed. \"She's one of them! Her name's Audrey Hunt, she's always watching me! Watching and waiting!\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Are you familiar with someone named Audrey Hunt?\" you ask.<p>\"I don't want anything to do with that tool of the Illuminati,\" Mickey declares. \"You can go talk to her in the Laundry Room if you want, but you better wear something metallic on your head.\""));
