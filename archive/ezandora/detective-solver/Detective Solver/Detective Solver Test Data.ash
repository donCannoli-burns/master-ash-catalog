__core_text_test_data.listAppend(listMake("wham.php?ask=7&visit=9", "\"Evelyn Quinn. What can you tell me about her?\" you ask.<p>\"I can tell you that piece of crap is stinking up the Sunroom. You want any more than that, go ask her for yourself.\""));
