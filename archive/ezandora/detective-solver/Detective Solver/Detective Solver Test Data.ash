__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>She ignores you and keeps reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>She shakes her head slightly, but doesn't say anything."));
