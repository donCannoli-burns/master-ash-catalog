__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=2", "\"Can you tell me anything about the victim's ex-butler? you ask.<p>\"A well-mannered individual,\" Byers says. \"Regrettably, I can tell you no more, as we have had no opportunity for conversation. They are in the Billiard Room, I believe.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Do you not already know, Detective?\" Byers asks. \"You need only ask yourself, who among these people is so ruled by fear that they would take the life of another in order to prolong their own existence, miserable though it may be?\" <p>\"...Just answer the question, please?\"<p>\"Chuck Todd.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"It is not difficult to see who in this house has the soul of a killer, Detective,\" Byers says. \"The desperate eyes, the hunger, the growl of an animal. No human who would take a life can truly hide these things.\" <p>\"Great. Okay. So...?\"<p>\"Chuck Todd.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>\"It is not difficult to see who in this house has the soul of a killer, Detective,\" Byers says. \"The desperate eyes, the hunger, the growl of an animal. No human who would take a life can truly hide these things.\" <p>\"Great. Okay. So...?\"<p>\"Chuck Todd.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"It is not difficult to see who in this house has the soul of a killer, Detective,\" Byers says. \"The desperate eyes, the hunger, the growl of an animal. No human who would take a life can truly hide these things.\" <p>\"Great. Okay. So...?\"<p>\"Chuck Todd.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>\"It was Chuck Todd, Detective,\" Byers says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"It was Chuck Todd, Detective,\" Byers says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"It was Chuck Todd, Detective,\" Byers says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Do you not already know, Detective?\" Byers asks. \"You need only ask yourself, who among these people is so ruled by fear that they would take the life of another in order to prolong their own existence, miserable though it may be?\" <p>\"...Just answer the question, please?\"<p>\"Chuck Todd.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"It was Chuck Todd, Detective,\" Byers says. \"Have you not witnessed for yourself the madness that gnaws at the core of their being, brought on by irrational fear of the unknown?\"<p>\"I guess not,\" you shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know Chuck Todd?\" you ask.<p>Ed snorts quietly. \"An ass.\"<p>\"Okay. Can you tell me anything more... concrete?\"<p>\"Douglas's cousin. Garbage.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Can you tell me anything about the victim's housekeeper? you ask.<p>\"Don't really know him. Name's Buck Wallace.\"<p>\"Can you tell me anything at all about him?\"<p>\"He's awful.\"<p>\"...Anything else?\"<p>\"No.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Chuck Todd. What can you tell me about him?\" you ask.<p>He scowls. \"The cousin.\"<p>\"Anything else you can tell me?\"<p>\"Hmph.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Have you met the victim's housekeeper?\" you ask.<p>Ed grimaces and turns a page. \"Ugh.\"<p>\"Can you tell me anything about them at all?\"<p>\"Name's Buck Wallace.\"<p>\"...That's it, huh?\"<p>\"Mm-hmm.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Do you know someone named Chuck Todd?\" you ask.<p>Ed frowns. \"Wish I didn't know him. Douglas's cousin.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Can you tell me anything about Douglas Buckner's housekeeper?\" you ask.<p><p>\"Buck Wallace. We don't talk.\"<p>\"Do you actually talk to anyone?\"<p>He turns a page and doesn't reply."));
