__core_text_test_data.listAppend(listMake("wham.php?ask=3&visit=6", "\"Do you know someone named Peyton Rush?\" you ask.<p>\"She's Emil's accountant, and an absolute philistine,\" Samantha scowls. <p>\"Doesn't like your poetry, eh?\"<p>\"She tore up my favorite sonnet about mushrooms!\"<p>\"Well, everybody's a critic.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=3&visit=6", "\"The victim's personal assistant -- do you know them?\" you ask.<p>\"I have nothing good to say about that... person,\" Samantha snorts. \"Their presence in the Bar is lowering the average intelligence of the household by at least thirty points.\""));
