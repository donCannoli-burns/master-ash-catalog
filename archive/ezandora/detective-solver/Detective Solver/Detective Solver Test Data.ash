__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>She ignores you and keeps reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>She ignores you and keeps reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Do you have any thoughts on who did it?\" you ask.<p>\"No idea,\" she says, turning a page in her book."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Who do you think is the most likely to be the killer?\" you ask.<p>She ignores you and keeps reading."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=5", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>She ignores you and keeps reading."));
