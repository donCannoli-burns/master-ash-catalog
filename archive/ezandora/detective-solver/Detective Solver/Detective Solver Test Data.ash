__core_text_test_data.listAppend(listMake("wham.php?ask=3&visit=8", "\"Are you familiar with a man named Mickey Rollins?\" you ask.<p>\"Oh yeah, me and Mickey Rollins, we get along great!\" Leonard says. \"Two peas in a pod, that's us. He'll be in the Sunroom, tell him I sent ya.\""));
