__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=9", "\"Are you familiar with a woman named Lily Levine?\" you ask.<p>\"She's Isabella's cousin, and an absolute philistine,\" Faith scowls. <p>\"Doesn't like your poetry, eh?\"<p>\"She tore up my favorite sonnet about mushrooms!\"<p>\"Well, everybody's a critic.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=4&visit=9", "\"Can you tell me anything about the victim's cousin? you ask.<p>\"Hmpf,\" Faith snorts. \"You're referring to Lily Levine. I'm afraid I don't associate with people whose idea of a dictionary has little pictures of superheroes providing examples for each definition.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=9", "\"Are you familiar with a woman named Lily Levine?\" you ask.<p>\"Ah, yes,\" Faith says, rolling her eyes dramatically. \"The cousin. No, that feeble-minded blowhard and I have little in common, Detective. Well, she walks upright, I suppose. Barely.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=4&visit=9", "\"Do you know Crawford's cousin?\" you ask.<p>\"Hmpf,\" Faith snorts. \"You're referring to Lily Levine. I'm afraid I don't associate with people whose idea of a dictionary has little pictures of superheroes providing examples for each definition.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=9", "\"Do you know someone by the name of Lily Levine?\" you ask.<p>\"She's Isabella's cousin, and an absolute philistine,\" Faith scowls. <p>\"Doesn't like your poetry, eh?\"<p>\"She tore up my favorite sonnet about mushrooms!\"<p>\"Well, everybody's a critic.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=4&visit=9", "\"Can you tell me anything about the victim's cousin? you ask.<p>\"I know of the person you describe,\" Faith sniffs. \"Her name is Lily Levine, and she is a boorish lout with the literary education of a ham sandwich.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=9", "\"Are you familiar with someone named Lily Levine?\" you ask.<p>\"She's Isabella's cousin, and an absolute philistine,\" Faith scowls. <p>\"Doesn't like your poetry, eh?\"<p>\"She tore up my favorite sonnet about mushrooms!\"<p>\"Well, everybody's a critic.\""));
