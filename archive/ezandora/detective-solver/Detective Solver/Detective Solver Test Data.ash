__core_text_test_data.listAppend(listMake("wham.php?ask=8&visit=7", "\"What do you know about Louis Gates?\" you ask.<p>\"You are speaking of Elizabeth Wilkerson's college roommate,\" Jenkins says, \"and I wish that you would not.\""));
