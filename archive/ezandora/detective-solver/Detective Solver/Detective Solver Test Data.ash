__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=5&visit=9", "\"Can you tell me anything about Gabrielle Glover's boss?\" you ask.<p>\"I don't know them real well,\" Davey says, \"but we run into each other from time to time, sure. They're alright. Check in the Bathroom.\""));
