__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=2", "\"Do you know Sullivan's sibling?\" you ask.<p>\"Know her a little. Her name's Peyton Rush. She doesn't get on my nerves like some people.\"<p>\"Like who?\"<p>He looks up at you, then looks back at his book."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=2", "\"Do you know Natalie Lewis?\" you ask.<p>\"Emil's golf caddy,\" comes the murmured reply.<p>\"Okay. Anything else?\"<p>\"She doesn't disturb me while I'm reading.\""));
