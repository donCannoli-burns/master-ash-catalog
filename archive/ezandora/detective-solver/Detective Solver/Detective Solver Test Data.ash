__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=7&visit=5", "\"I understand the victim had a personal assistant,\" you say. \"Can you tell me anything about them?\"<p>\"I don't have a single unkind word to say about that person,\" Victoria says.<p>\"Do you have anything at all to say about them?\"<p>\"No. Well, they're probably in the Servants' Quarters. Does that count?\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=7&visit=5", "\"The victim had a personal assistant, do you know them?\" you ask.<p>\"I don't have a single unkind word to say about that person,\" Victoria says.<p>\"Do you have anything at all to say about them?\"<p>\"No. Well, they're probably in the Servants' Quarters. Does that count?\""));
