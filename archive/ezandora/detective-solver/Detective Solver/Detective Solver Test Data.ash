__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=2", "\"Do you know Zachary Rodriquez?\" you ask.<p>\"He's Victoria's chauffeur, and an absolute philistine,\" Chloe scowls. <p>\"Doesn't like your poetry, eh?\"<p>\"He tore up my favorite sonnet about mushrooms!\"<p>\"Well, everybody's a critic.\""));
