__core_text_test_data.listAppend(listMake("wham.php?ask=5&visit=1", "\"What can you tell me about Hilary Wallace?\" you ask.<p>Oliver sniffs disdainfully. \"Smoking Lounge.\"<p>\"...Anything else?\"<p>\"He's a jerk.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=5&visit=1", "\"Can you tell me anything about Marlon Cantu's lover?\" you ask.<p>\"No.\"<p>\"Nothing at all?\"<p>\"Try the Smoking Lounge.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=5&visit=1", "\"Are you familiar with someone named Hilary Wallace?\" you ask.<p>\"He's a jackass,\" Oliver replies, \"and he's in the Smoking Lounge.\"<p>\"Good lord. Don't wear yourself out, saying that many words all at once.\"<p>\"Mm-hmm.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=5&visit=1", "\"The victim's lover -- do you know them?\" you ask.<p>\"Met them once.\"<p>\"And?\"<p>\"And they're in the Smoking Lounge if you want to try it yourself.\""));
