__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=2", "\"Isaiah Mejia. What can you tell me about him?\" you ask.<p>\"Yeah, I know Isaiah Mejia. He's Oliver's cousin. Or was, I guess. He's okay. I never had any trouble with him.\""));
