__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=9", "\"Do you know someone named Emma Slater?\" you ask.<p>\"You will find this woman in the Attic,\" Christian says. \"Refusing to accept responsibility for her own actions, I do not doubt.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=4&visit=9", "\"Do you know Wilson's accountant?\" you ask.<p>\"Each of us has a limited amount of time on this Earth, Detective,\" Christian says, \"and I have resolved not to spend mine upon such a person. But, you must judge for yourself. You will find them in the Attic.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=4&visit=9", "\"Do you know someone by the name of Emma Slater?\" you ask.<p>\"She is in the Attic at the moment,\" Christian says. \"Perhaps you will discover a use for her where I have not.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=4&visit=9", "\"The victim's accountant -- do you know them?\" you ask.<p>\"Each of us has a limited amount of time on this Earth, Detective,\" Christian says, \"and I have resolved not to spend mine upon such a person. But, you must judge for yourself. You will find them in the Attic.\""));
