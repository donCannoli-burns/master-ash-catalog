__core_text_test_data.listAppend(listMake("wham.php?ask=5&visit=6", "\"Gabrielle Bryant. What can you tell me about her?\" you ask.<p>\"She's Clyde's boss, and an absolute philistine,\" Perry scowls. <p>\"Doesn't like your poetry, eh?\"<p>\"She tore up my favorite sonnet about mushrooms!\"<p>\"Well, everybody's a critic.\""));
