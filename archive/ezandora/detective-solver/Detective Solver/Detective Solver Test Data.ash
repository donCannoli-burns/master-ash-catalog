__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=4", "\"What can you tell me about Barney Bryan?\" you ask.<p>\"I know of whom you speak,\" Zamora says. \"Presently, he is in the Family Room. His outlook on life is, in many ways, quite refreshing.\""));
