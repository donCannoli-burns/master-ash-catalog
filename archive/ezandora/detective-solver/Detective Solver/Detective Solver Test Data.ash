__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=2", "\"Davey Suarez. What can you tell me about him?\" you ask.<p>\"Who?\" Chloe asks. \"Oh -- you mean Victoria's butler. No, I have no time for a person with such reprehensible ignorance of the fine arts. He thinks Baudelaire is a type of French wine.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Help me out here,\" you say. \"You know all the people in this house. Who's the most likely killer?\"<p>\"Hmm, well,\" Chloe muses, \"I suppose it does make for a more satisfying conclusion to my poem if you actually apprehend the criminal. Very well, it was Serenity Maynard.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"If you had to guess,\" you ask, \"who would you say did it?\"<p>\"Hmm, well,\" Chloe muses, \"I suppose it does make for a more satisfying conclusion to my poem if you actually apprehend the criminal. Very well, it was Serenity Maynard.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Does anyone else here seem particularly suspicious to you?\" you ask.<p>\"Hmm, well,\" Chloe muses, \"I suppose it does make for a more satisfying conclusion to my poem if you actually apprehend the criminal. Very well, it was Serenity Maynard.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>\"Oh, well,\" Chloe says, \"I mean, I haven't quite finished my poem yet, and I wouldn't like to spoil the dramatic reveal for you, but I could read you what I have so far and...\"<p>\"Just the name, please.\"<p>\"It was Serenity Maynard,\" she says dourly."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Do you have any thoughts on who did it?\" you ask.<p>\"Oh, well,\" Chloe says, \"I mean, I haven't quite finished my poem yet, and I wouldn't like to spoil the dramatic reveal for you, but I could read you what I have so far and...\"<p>\"Just the name, please.\"<p>\"It was Serenity Maynard,\" she says dourly."));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think the killer is?\" you ask.<p>\"Hmm, well,\" Chloe muses, \"I suppose it does make for a more satisfying conclusion to my poem if you actually apprehend the criminal. Very well, it was Serenity Maynard.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=killer&visit=2", "\"Who do you think is the most likely to be the killer?\" you ask.<p>\"Oh, well,\" Chloe says, \"I mean, I haven't quite finished my poem yet, and I wouldn't like to spoil the dramatic reveal for you, but I could read you what I have so far and...\"<p>\"Just the name, please.\"<p>\"It was Serenity Maynard,\" she says dourly."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Willard Garza. What can you tell me about him?\" you ask.<p>\"Seen him around. That's all.\"<p>\"Where?\"<p>\"In the Family Room.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"The victim had a gardener, do you know them?\" you ask.<p>Serenity nods. \"Ted Haynes.\"<p>\"Can you tell me anything about him?\"<p>Shrug. \"Seemed reasonable enough.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Are you familiar with a man named Willard Garza?\" you ask.<p>Serenity shakes her head. \"Don't know him well. He's in the Family Room, I think.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Can you tell me anything about the victim's gardener? you ask.<p>\"Know him a little. His name's Ted Haynes. He doesn't get on my nerves like some people.\"<p>\"Like who?\"<p>She looks up at you, then looks back at her book."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"Are you familiar with someone named Willard Garza?\" you ask.<p>Serenity shakes her head. \"Don't know him well. He's in the Family Room, I think.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"Do you know Morrison's gardener?\" you ask.<p>Serenity nods. \"Ted Haynes.\"<p>\"Can you tell me anything about him?\"<p>Shrug. \"Seemed reasonable enough.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"What can you tell me about Willard Garza?\" you ask.<p>\"Seen him around. That's all.\"<p>\"Where?\"<p>\"In the Family Room.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=1&visit=3", "\"What can you tell me about the deceased's gardener?\" you ask.<p>\"His name's Ted Haynes.\"<p>\"...Anything else? Anything at all?\"<p>Shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=1&visit=3", "\"What can you tell me about Willard Garza?\" you ask.<p>Serenity shakes her head. \"Don't know him well. He's in the Family Room, I think.\""));
