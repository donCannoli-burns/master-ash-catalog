__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=8", "\"What can you tell me about Jake Cash?\" you ask.<p>\"Seen him around. That's all.\"<p>\"Where?\"<p>\"In the Basement.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=8", "\"Can you tell me anything about the victim's lawyer? you ask.<p>\"His name's Moe Bender.\"<p>\"...Anything else? Anything at all?\"<p>Shrug."));
__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=8", "\"Do you know someone named Jake Cash?\" you ask.<p>Louis shakes his head. \"Don't know him well. He's in the Basement, I think.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=9&visit=8", "\"Do you know Wilkerson's lawyer?\" you ask.<p>\"Know him a little. His name's Moe Bender. He doesn't get on my nerves like some people.\"<p>\"Like who?\"<p>He looks up at you, then looks back at his book."));
__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=8", "\"Jake Cash. What can you tell me about him?\" you ask.<p>Louis shakes his head. \"Don't know him well. He's in the Basement, I think.\""));
