__core_text_test_data.listAppend(listMake("wham.php?ask=2&visit=8", "\"What do you know about Clarence Parker?\" you ask.<p>\"That... <i>guttersnipe</i> can be found in the Breakfast Nook,\" Bishop sniffs. \"Other than that, I have absolutely nothing to say about him.\""));
