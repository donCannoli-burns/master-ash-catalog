__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=6&visit=9", "\"Do you know Sullivan's neighbor?\" you ask.<p>\"Sheesh,\" Martin grumbles. \"Yeah, I know Peyton Rush. Know her like a kick in the teeth. Got about as much need for her, too.\""));
