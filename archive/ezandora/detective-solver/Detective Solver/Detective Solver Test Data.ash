__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=6&visit=9", "\"The victim's personal assistant -- do you know them?\" you ask.<p>\"Hmpf,\" Gavin snorts. \"You're referring to Addison O'Neal. I'm afraid I don't associate with people whose idea of a dictionary has little pictures of superheroes providing examples for each definition.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=6&visit=9", "\"Do you know Addison O'Neal?\" you ask.<p>\"She's Grant's personal assistant, and an absolute philistine,\" Gavin scowls. <p>\"Doesn't like your poetry, eh?\"<p>\"She tore up my favorite sonnet about mushrooms!\"<p>\"Well, everybody's a critic.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=rel&w=6&visit=9", "\"Can you tell me anything about the victim's personal assistant? you ask.<p>\"I know of the person you describe,\" Gavin sniffs. \"Her name is Addison O'Neal, and she is a boorish lout with the literary education of a ham sandwich.\""));
__core_text_test_data.listAppend(listMake("wham.php?ask=6&visit=9", "\"Do you know someone by the name of Addison O'Neal?\" you ask.<p>\"She's Grant's personal assistant, and an absolute philistine,\" Gavin scowls. <p>\"Doesn't like your poetry, eh?\"<p>\"She tore up my favorite sonnet about mushrooms!\"<p>\"Well, everybody's a critic.\""));
