__core_text_test_data.listAppend(listMake("wham.php?ask=7&visit=9", "\"What can you tell me about Chuck Wilson?\" you ask.<p>\"Chuck Wilson? Victor's accountant? He's cool, he's a good person. Don't you be hasslin' him!\" he snarls, jabbing a forefinger at you."));
