__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=5", "\"Do you know someone named Avery Rowe?\" you ask.<p>\"I know of whom you speak,\" Vang says. \"Presently, she is in the Library. Her outlook on life is, in many ways, quite refreshing.\""));
