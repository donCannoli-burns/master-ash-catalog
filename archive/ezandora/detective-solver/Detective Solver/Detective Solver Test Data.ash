__core_text_test_data.listAppend(listMake("wham.php?ask=3&visit=5", "\"Do you know someone by the name of Clarence Mayer?\" you ask.<p>\"Clarence Mayer? He's alright, he's cool. I think he's over in the Basement? But that's all I'm gonna say to a cop.\""));
