//Detective Solver Test Data.ash
//Collected data from trial runs.
//This script is in the public domain.

string [int][int] __core_text_test_data;

//Utility functions:
string [int] listMake(string e1, string e2)
{
	string [int] result;
	result[0] = e1;
	result[1] = e2;
	return result;
}
void listAppend(string [int][int] list, string [int] entry)
{
	int position = list.count();
	while (list contains position)
		position += 1;
	list[position] = entry;
}


