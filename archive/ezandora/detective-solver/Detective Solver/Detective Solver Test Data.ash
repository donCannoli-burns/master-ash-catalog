__core_text_test_data.listAppend(listMake("wham.php?ask=9&visit=4", "\"Are you familiar with a man named Joey Sanford?\" you ask.<p>\"Joey Sanford? That jerk? All I know is he's Leah's dental hygienist, and that's all I wanna know about that jerk.\""));
